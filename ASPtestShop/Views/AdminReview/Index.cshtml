@{
    ViewData["Title"] = "Kiểm duyệt đánh giá";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Kiểm duyệt đánh giá & bình luận</h3>
            <p class="text-muted small mb-0">Xem xét ý kiến phản hồi của khách hàng trước khi hiển thị công khai trên website</p>
        </div>
    </div>

    <div id="alertBox"></div>

    <div class="card border-0 shadow-sm" style="border-radius: 12px; background: #fff;">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
            <!-- TABS LỌC -->
            <ul class="nav nav-pills gap-2" id="filterTabs">
                <li class="nav-item">
                    <button class="nav-link active rounded-pill px-4 py-2" onclick="setFilter('pending', this)">
                        Chờ duyệt <span class="badge bg-warning text-dark ms-1" id="badgePendingCount">0</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link rounded-pill px-4 py-2" onclick="setFilter('approved', this)">
                        Đã duyệt <span class="badge bg-success ms-1" id="badgeApprovedCount">0</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link rounded-pill px-4 py-2" onclick="setFilter('all', this)">
                        Tất cả <span class="badge bg-secondary ms-1" id="badgeAllCount">0</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body p-4">
            <!-- THANH TÁC VỤ HÀNG LOẠT -->
            <div id="batchActionBar" class="d-none fuu-batch-bar">
                <div class="d-flex align-items-center">
                    <i class="fa fa-check-square me-2 text-warning"></i>
                    <span>Đã chọn <strong id="selectedReviewCount" class="badge-count">0</strong> đánh giá</span>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-success fw-semibold" onclick="batchApproveReviews()">
                        <i class="fa fa-check me-1"></i> Duyệt hiển thị đã chọn
                    </button>
                    <button type="button" class="btn btn-sm btn-warning text-dark fw-semibold" onclick="batchRejectReviews()">
                        <i class="fa fa-eye-slash me-1"></i> Ẩn đã chọn
                    </button>
                    <button type="button" class="btn btn-sm btn-danger fw-semibold" onclick="batchDeleteReviews()">
                        <i class="fa fa-trash-alt me-1"></i> Xóa đã chọn
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-light" onclick="clearSelectedReviews()">
                        Bỏ chọn
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40px;" class="text-center">
                                <input type="checkbox" id="selectAllReviews" class="fuu-checkbox" onchange="toggleSelectAllReviews(this)" title="Chọn tất cả">
                            </th>
                            <th style="min-width: 200px;">Sản phẩm</th>
                            <th>Khách hàng</th>
                            <th>Đánh giá</th>
                            <th style="min-width: 250px;">Nội dung nhận xét</th>
                            <th>Ngày gửi</th>
                            <th>Trạng thái</th>
                            <th class="text-end" style="min-width: 150px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="reviewTableBody">
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">Đang tải danh sách đánh giá...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentFilter = 'pending';
        let allReviewsCache = [];

        document.addEventListener("DOMContentLoaded", function () {
            loadReviews();
        });

        function showAlert(message, type = "success") {
            const box = document.getElementById("alertBox");
            box.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            setTimeout(() => { box.innerHTML = ""; }, 4000);
        }

        function setFilter(filter, el) {
            currentFilter = filter;
            document.querySelectorAll("#filterTabs .nav-link").forEach(btn => btn.classList.remove("active"));
            el.classList.add("active");
            clearSelectedReviews();
            filterAndRender();
        }

        async function loadReviews() {
            clearSelectedReviews();
            try {
                const res = await fetch("/api/admin/reviews?filter=all", { method: "GET", credentials: "include" });
                if (!res.ok) throw new Error("Không thể tải danh sách đánh giá");
                allReviewsCache = await res.json();

                // Cập nhật số lượng trên các badge tabs
                const pending = allReviewsCache.filter(r => !r.isApproved).length;
                const approved = allReviewsCache.filter(r => r.isApproved).length;

                document.getElementById("badgePendingCount").textContent = pending;
                document.getElementById("badgeApprovedCount").textContent = approved;
                document.getElementById("badgeAllCount").textContent = allReviewsCache.length;

                filterAndRender();
            } catch (err) {
                showAlert(err.message, "danger");
            }
        }

        function filterAndRender() {
            let list = allReviewsCache;
            if (currentFilter === 'pending') {
                list = list.filter(r => !r.isApproved);
            } else if (currentFilter === 'approved') {
                list = list.filter(r => r.isApproved);
            }
            renderTable(list);
        }

        function renderTable(list) {
            const tbody = document.getElementById("reviewTableBody");
            if (!list || list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">Không có đánh giá nào trong mục này.</td></tr>';
                return;
            }

            tbody.innerHTML = list.map(r => {
                // Tạo số sao vàng
                let stars = '';
                for (let i = 1; i <= 5; i++) {
                    stars += i <= r.rating ? '<span style="color: #f9bf29; font-size: 1.1rem;">★</span>' : '<span style="color: #cbd5e1; font-size: 1.1rem;">★</span>';
                }

                const statusBadge = r.isApproved
                    ? '<span class="badge bg-success">Đã duyệt (Hiển thị)</span>'
                    : '<span class="badge bg-warning text-dark">Chờ duyệt (Đang ẩn)</span>';

                const thumb = r.productThumbnail
                    ? `<img src="${r.productThumbnail}" class="rounded me-2 border" style="width: 40px; height: 40px; object-fit: cover;" />`
                    : `<div class="rounded bg-light me-2 d-flex align-items-center justify-content-center border" style="width: 40px; height: 40px;"><i class="fa fa-box text-secondary"></i></div>`;

                const createdDate = new Date(r.createdAt).toLocaleString('vi-VN', { dateStyle: 'short', timeStyle: 'short' });

                return `
                    <tr>
                        <td class="text-center">
                            <input type="checkbox" class="fuu-checkbox review-select-checkbox" value="${r.reviewId}" onchange="handleReviewRowSelect()" />
                        </td>
                        <td>
                            <div class="d-flex align-items-center">
                                ${thumb}
                                <div>
                                    <div class="fw-semibold text-dark text-truncate" style="max-width: 180px;">${escapeHtml(r.productName || 'Sản phẩm #' + r.productId)}</div>
                                    <small class="text-muted">ID: ${r.productId}</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">${escapeHtml(r.customerName)}</div>
                            <small class="text-muted">${escapeHtml(r.customerEmail || 'Chưa có email')}</small>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1">${stars}</div>
                            <small class="text-muted">${r.rating}/5 sao</small>
                        </td>
                        <td>
                            <p class="mb-0 text-break" style="font-size: 0.9rem;">${escapeHtml(r.comment || '(Khách hàng không để lại nhận xét chữ)')}</p>
                        </td>
                        <td class="small text-muted">${createdDate}</td>
                        <td>${statusBadge}</td>
                        <td class="text-end">
                            <div class="fuu-action-group justify-content-end">
                                ${!r.isApproved ? `
                                    <button type="button" class="fuu-btn-action fuu-btn-approve" onclick="approveReview(${r.reviewId})" title="Duyệt hiển thị">
                                        <i class="fa fa-check"></i> <span>Duyệt</span>
                                    </button>
                                ` : `
                                    <button type="button" class="fuu-btn-action fuu-btn-hide" onclick="rejectReview(${r.reviewId})" title="Ẩn đánh giá">
                                        <i class="fa fa-eye-slash"></i> <span>Ẩn</span>
                                    </button>
                                `}
                                <button type="button" class="fuu-btn-action fuu-btn-delete" onclick="deleteReview(${r.reviewId})" title="Xóa vĩnh viễn">
                                    <i class="fa fa-trash-alt"></i> <span>Xóa</span>
                                </button>
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // ==========================================
        // XỬ LÝ CHỌN HÀNG LOẠT (BATCH ACTIONS)
        // ==========================================
        function toggleSelectAllReviews(master) {
            const checkboxes = document.querySelectorAll(".review-select-checkbox");
            checkboxes.forEach(cb => cb.checked = master.checked);
            handleReviewRowSelect();
        }

        function handleReviewRowSelect() {
            const checkedBoxes = document.querySelectorAll(".review-select-checkbox:checked");
            const allBoxes = document.querySelectorAll(".review-select-checkbox");
            const count = checkedBoxes.length;

            const countEl = document.getElementById("selectedReviewCount");
            if (countEl) countEl.textContent = count;

            const bar = document.getElementById("batchActionBar");
            if (bar) {
                if (count > 0) bar.classList.remove("d-none");
                else bar.classList.add("d-none");
            }

            const master = document.getElementById("selectAllReviews");
            if (master) {
                master.checked = allBoxes.length > 0 && checkedBoxes.length === allBoxes.length;
            }
        }

        function clearSelectedReviews() {
            const master = document.getElementById("selectAllReviews");
            if (master) master.checked = false;
            document.querySelectorAll(".review-select-checkbox").forEach(cb => cb.checked = false);
            handleReviewRowSelect();
        }

        function getSelectedReviewIds() {
            const checkedBoxes = document.querySelectorAll(".review-select-checkbox:checked");
            return Array.from(checkedBoxes).map(cb => parseInt(cb.value)).filter(id => !isNaN(id) && id > 0);
        }

        async function batchApproveReviews() {
            const ids = getSelectedReviewIds();
            if (ids.length === 0) {
                showAlert("Vui lòng chọn ít nhất một đánh giá để duyệt.", "warning");
                return;
            }

            if (!confirm(`Bạn có chắc chắn muốn duyệt và cho phép hiển thị ${ids.length} đánh giá đã chọn trên website?`)) {
                return;
            }

            try {
                const res = await fetch("/api/admin/reviews/batch-approve", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: "include",
                    body: JSON.stringify({ reviewIds: ids })
                });

                const data = await res.json();
                if (!res.ok || !data.success) throw new Error(data.message || "Lỗi thao tác hàng loạt");

                showAlert(data.message, "success");
                loadReviews();
            } catch (err) {
                showAlert(err.message, "danger");
            }
        }

        async function batchRejectReviews() {
            const ids = getSelectedReviewIds();
            if (ids.length === 0) {
                showAlert("Vui lòng chọn ít nhất một đánh giá để ẩn.", "warning");
                return;
            }

            if (!confirm(`Bạn có chắc chắn muốn ẩn ${ids.length} đánh giá đã chọn khỏi website?`)) {
                return;
            }

            try {
                const res = await fetch("/api/admin/reviews/batch-reject", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: "include",
                    body: JSON.stringify({ reviewIds: ids })
                });

                const data = await res.json();
                if (!res.ok || !data.success) throw new Error(data.message || "Lỗi thao tác hàng loạt");

                showAlert(data.message, "warning");
                loadReviews();
            } catch (err) {
                showAlert(err.message, "danger");
            }
        }

        async function batchDeleteReviews() {
            const ids = getSelectedReviewIds();
            if (ids.length === 0) {
                showAlert("Vui lòng chọn ít nhất một đánh giá để xóa.", "warning");
                return;
            }

            if (!confirm(`CẢNH BÁO: Bạn sắp xóa vĩnh viễn ${ids.length} đánh giá đã chọn? Thao tác này không thể hoàn tác.`)) {
                return;
            }

            try {
                const res = await fetch("/api/admin/reviews/batch-delete", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: "include",
                    body: JSON.stringify({ reviewIds: ids })
                });

                const data = await res.json();
                if (!res.ok || !data.success) throw new Error(data.message || "Lỗi xóa hàng loạt");

                showAlert(data.message, "success");
                loadReviews();
            } catch (err) {
                showAlert(err.message, "danger");
            }
        }

        // ==========================================
        // THAO TÁC ĐƠN LẺ
        // ==========================================
        async function approveReview(id) {
            try {
                const res = await fetch(`/api/admin/reviews/${id}/approve`, { method: "POST", credentials: "include" });
                const data = await res.json();
                if (!res.ok) throw new Error(data.message || "Lỗi thao tác");
                showAlert(data.message);
                loadReviews();
            } catch (err) {
                showAlert(err.message, "danger");
            }
        }

        async function rejectReview(id) {
            try {
                const res = await fetch(`/api/admin/reviews/${id}/reject`, { method: "POST", credentials: "include" });
                const data = await res.json();
                if (!res.ok) throw new Error(data.message || "Lỗi thao tác");
                showAlert(data.message, "warning");
                loadReviews();
            } catch (err) {
                showAlert(err.message, "danger");
            }
        }

        async function deleteReview(id) {
            if (!confirm("Bạn có chắc chắn muốn xóa vĩnh viễn đánh giá này?")) return;

            try {
                const res = await fetch(`/api/admin/reviews/${id}`, { method: "DELETE", credentials: "include" });
                const data = await res.json();
                if (!res.ok) throw new Error(data.message || "Lỗi thao tác");
                showAlert(data.message);
                loadReviews();
            } catch (err) {
                showAlert(err.message, "danger");
            }
        }

        function escapeHtml(text) {
            if (!text) return "";
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
}
