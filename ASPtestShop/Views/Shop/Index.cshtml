    .product-item:hover .icon-cross img {
        filter: brightness(0) invert(1);
    }

    /* Phân trang */
    .pagination-fuu .page-link {
        color: #334155;
        border: 1px solid #cbd5e1;
        margin: 0 3px;
        border-radius: 8px !important;
        font-size: 0.85rem;
        padding: 6px 12px;
    }

    .pagination-fuu .page-item.active .page-link {
        background-color: var(--fuu-primary);
        border-color: var(--fuu-primary);
