</style>

<script>
    let allProducts = [];
    let filteredProducts = [];
    let currentNavCategoryId = null;

    const filterState = {
        keyword: "",
        inStock: false,
        onSale: false,
        category: "",
        brand: "",
        priceRange: "",
        customMinPrice: null,
        customMaxPrice: null,
        sort: "popular",
        page: 1,
        pageSize: 12
    };

    let debounceTimer = null;

    // Helper bỏ dấu tiếng Việt để tìm kiếm thông minh
    function removeVietnameseDiacritics(str) {
        if (!str) return "";
        return str.normalize("NFD")
                  .replace(/[\u0300-\u036f]/g, "")
                  .replace(/đ/g, "d").replace(/Đ/g, "D")
                  .toLowerCase();
    }

    // ============================================================
    // Khởi tạo trang
    // ============================================================
    document.addEventListener("DOMContentLoaded", function () {
        detectNavModeAndParams();
        fetchProductsData();
        loadSidebarCategories();
        setupSearchInput();

        const filterCollapse = document.getElementById("shopSidebarCollapse");
        if (filterCollapse) {
            filterCollapse.addEventListener("show.bs.collapse", function () {
                const chev = document.getElementById("mobileFilterChevron");
                if (chev) chev.className = "fa-solid fa-chevron-up";
            });
            filterCollapse.addEventListener("hide.bs.collapse", function () {
                const chev = document.getElementById("mobileFilterChevron");
                if (chev) chev.className = "fa-solid fa-chevron-down";
            });
        }
    });

    // Đọc URL parameters khi tải trang
    function detectNavModeAndParams() {
        const params = new URLSearchParams(window.location.search);
        currentNavCategoryId = params.get("categoryId");

        if (currentNavCategoryId) {
            filterState.sort = params.get("sort") || "az";
            loadCategoryName(currentNavCategoryId);
        } else {
            filterState.sort = params.get("sort") || "popular";
        }

        if (params.get("keyword")) filterState.keyword = params.get("keyword");
        if (params.get("inStock") === "1") filterState.inStock = true;
        if (params.get("onSale") === "1") filterState.onSale = true;
        if (params.get("category") && !currentNavCategoryId) filterState.category = params.get("category");
        if (params.get("brand")) filterState.brand = params.get("brand");
        if (params.get("price")) filterState.priceRange = params.get("price");
        if (params.get("minPrice")) filterState.customMinPrice = parseFloat(params.get("minPrice")) || null;
        if (params.get("maxPrice")) filterState.customMaxPrice = parseFloat(params.get("maxPrice")) || null;
        if (params.get("page")) filterState.page = parseInt(params.get("page")) || 1;
        if (params.get("pageSize")) filterState.pageSize = parseInt(params.get("pageSize")) || 12;

        // Đồng bộ lên giao diện bộ lọc đứng
        syncUiFromState();
    }

    function syncUiFromState() {
        // Keyword
        const searchInput = document.getElementById("searchInput");
        if (searchInput) {
            searchInput.value = filterState.keyword;
            toggleClearBtn(filterState.keyword);
        }

        // Brand buttons
        document.querySelectorAll(".brand-grid-btn").forEach(btn => {
            btn.classList.toggle("active", btn.dataset.brand === filterState.brand);
        });

        // Price radio
        if (filterState.customMinPrice !== null || filterState.customMaxPrice !== null) {
            document.querySelectorAll('input[name="priceRangeRadio"]').forEach(r => r.checked = false);
            if (filterState.customMinPrice) document.getElementById("customMinPrice").value = filterState.customMinPrice;
            if (filterState.customMaxPrice) document.getElementById("customMaxPrice").value = filterState.customMaxPrice;
        } else {
            const radio = document.querySelector(`input[name="priceRangeRadio"][value="${filterState.priceRange}"]`);
            if (radio) radio.checked = true;
        }

        // Checkboxes
        const inStockBox = document.getElementById("checkInStock");
        if (inStockBox) inStockBox.checked = filterState.inStock;

        const onSaleBox = document.getElementById("checkOnSale");
        if (onSaleBox) onSaleBox.checked = filterState.onSale;

        // Sort buttons
        document.querySelectorAll(".sort-pill-btn").forEach(btn => {
            btn.classList.toggle("active", btn.dataset.sort === filterState.sort);
        });

        // Category pills
        document.querySelectorAll(".filter-category-pill").forEach(p => {
            if (!filterState.category) {
                p.classList.toggle("active", p.textContent.trim() === "Tất cả" || p.textContent.trim().startsWith("Tất cả"));
            } else {
                p.classList.toggle("active", p.textContent.trim() === filterState.category);
            }
        });

        updateClearBtnVisibility();
    }

    // Nạp danh mục động vào Sidebar
    async function loadSidebarCategories() {
        const catList = document.getElementById("sidebarCategoryList");
        const titleEl = document.getElementById("sidebarCategoryHeaderTitle");
        if (!catList) return;

        try {
            let allCats = [];
            const cached = sessionStorage.getItem("fuu_global_categories");
            if (cached) {
                allCats = JSON.parse(cached);
            } else {
                const res = await fetch("/api/categories");
                if (res.ok) allCats = await res.json();
            }

            if (!Array.isArray(allCats) || allCats.length === 0) {
                catList.innerHTML = '<span class="text-muted small">Đang cập nhật...</span>';
                return;
            }

            if (currentNavCategoryId) {
                // Hiển thị các danh mục con của danh mục hiện tại
                const currentCat = allCats.find(c => c.categoryId == currentNavCategoryId);
                const currentName = currentCat ? currentCat.categoryName : "Danh mục";
                if (titleEl) titleEl.textContent = `Phân loại ${currentName}`;

                const children = allCats.filter(c => c.parentCategoryId == currentNavCategoryId && c.isActive);
                if (children.length > 0) {
                    let pills = `<button type="button" class="filter-category-pill ${!filterState.category ? 'active' : ''}" onclick="selectCategoryFilter('')">Tất cả</button>`;
                    children.forEach(ch => {
                        const isActive = filterState.category === ch.categoryName;
                        pills += `<button type="button" class="filter-category-pill ${isActive ? 'active' : ''}" onclick="selectCategoryFilter('${ch.categoryName}')">${ch.categoryName}</button>`;
                    });
                    catList.innerHTML = pills;
                } else {
                    catList.innerHTML = `<button type="button" class="filter-category-pill active" onclick="selectCategoryFilter('')">Tất cả ${currentName}</button>`;
                }
            } else {
                // Shop tổng: Hiển thị các danh mục gốc
                if (titleEl) titleEl.textContent = "Danh mục sản phẩm";
                const roots = allCats.filter(c => !c.parentCategoryId && c.isActive);
                let pills = `<button type="button" class="filter-category-pill ${!filterState.category ? 'active' : ''}" onclick="selectCategoryFilter('')">Tất cả</button>`;
                roots.forEach(r => {
                    const isActive = filterState.category === r.categoryName;
                    pills += `<button type="button" class="filter-category-pill ${isActive ? 'active' : ''}" onclick="selectCategoryFilter('${r.categoryName}')">${r.categoryName}</button>`;
                });
                catList.innerHTML = pills;
            }
        } catch (e) {
            console.warn("Load sidebar categories error:", e);
        }
    }

    async function loadCategoryName(catId) {
        try {
            const res = await fetch(`/api/categories/${catId}`);
            if (res.ok) {
                const cat = await res.json();
                const name = cat.categoryName || "Danh mục";
                document.getElementById("shopHeroTitle").textContent = name;
                document.getElementById("shopHeroDesc").textContent = cat.description || `Các sản phẩm ${name} chính hãng chất lượng cao tại FuuFishing.`;
                document.getElementById("searchInput").placeholder = `Tìm kiếm trong ${name}...`;
                
                const breadcrumbCat = document.getElementById("breadcrumbCategoryName");
                if (breadcrumbCat) {
                    breadcrumbCat.textContent = name;
                    breadcrumbCat.style.display = "inline-block";
                }
            }
        } catch (e) {
            console.warn("Could not fetch category name:", e);
        }
    }

    // ============================================================
    // Tải dữ liệu sản phẩm từ API
    // ============================================================
    async function fetchProductsData() {
        const productList = document.getElementById("productList");
        
        let skeletonHtml = "";
        for (let i = 0; i < 9; i++) {
            skeletonHtml += `
                <div class="col-6 col-md-6 col-lg-4">
                    <div class="skeleton-product-card p-3 bg-white rounded-3 border">
                        <div class="skeleton-thumb mb-3" style="height: 180px; border-radius: 8px; background:#edf2f0;"></div>
                        <div class="skeleton-title mb-2" style="height: 16px; width: 85%; border-radius: 4px; background:#edf2f0;"></div>
                        <div class="skeleton-price" style="height: 16px; width: 45%; border-radius: 4px; background:#edf2f0;"></div>
                    </div>
                </div>
            `;
        }
        productList.innerHTML = skeletonHtml;

        try {
            const apiUrl = currentNavCategoryId 
                ? `/api/products/category/${currentNavCategoryId}` 
                : "/api/products";

            const res = await fetch(apiUrl, {
                method: "GET",
                headers: { "Accept": "application/json" }
            });

            if (!res.ok) throw new Error(`Lỗi tải dữ liệu (${res.status})`);

            const data = await res.json();
            allProducts = Array.isArray(data) ? data : (data.items || data.data || []);

            applyFiltersAndRender();
        } catch (err) {
            console.error("Fetch products error:", err);
            productList.innerHTML = `
                <div class="col-12 py-5 text-center">
                    <div class="alert alert-danger d-inline-block">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>Không thể tải danh sách sản phẩm. Vui lòng thử lại!
                    </div>
                </div>
            `;
        }
    }

    // ============================================================
    // BỘ LỌC VÀ SẮP XẾP SẢN PHẨM
    // ============================================================
    function applyFiltersAndRender(keepPage = false) {
        if (!keepPage) {
            filterState.page = 1;
        }

        let result = allProducts.filter(p => {
            // 1. Tìm kiếm thông minh (Đa từ khóa, Không dấu / Có dấu)
            if (filterState.keyword) {
                const rawKw = filterState.keyword.trim().toLowerCase();
                const normKw = removeVietnameseDiacritics(rawKw);
                const tokens = rawKw.split(/[\s,+-]+/).filter(Boolean);
                const normTokens = normKw.split(/[\s,+-]+/).filter(Boolean);

                const rawCombined = ((p.productName || "") + " " + (p.categoryName || "") + " " + (p.description || "")).toLowerCase();
                const normCombined = removeVietnameseDiacritics(rawCombined);

                const allTokensMatch = tokens.every((tok, idx) => {
                    const normTok = normTokens[idx];
                    return rawCombined.includes(tok) || normCombined.includes(normTok);
                });

                if (!allTokensMatch) return false;
            }

            // 2. Sẵn hàng
            if (filterState.inStock && p.stockQuantity <= 0) {
                return false;
            }

            // 3. Khuyến mãi
            if (filterState.onSale && !(p.originalPrice > p.price)) {
                return false;
            }

            // 4. Mức giá tùy chọn (Custom range)
            if (filterState.customMinPrice !== null && p.price < filterState.customMinPrice) return false;
            if (filterState.customMaxPrice !== null && p.price > filterState.customMaxPrice) return false;

            // Mức giá radio chuẩn
            if (filterState.priceRange && filterState.priceRange !== "custom") {
                const pr = p.price;
                if (filterState.priceRange === "under-500k" && !(pr < 500000)) return false;
                if (filterState.priceRange === "500k-1m" && !(pr >= 500000 && pr <= 1000000)) return false;
                if (filterState.priceRange === "1m-3m" && !(pr > 1000000 && pr <= 3000000)) return false;
                if (filterState.priceRange === "above-3m" && !(pr > 3000000)) return false;
            }

            // 5. Hãng sản xuất / Thương hiệu
            if (filterState.brand) {
                const brand = filterState.brand.toLowerCase();
                if (!(p.productName || "").toLowerCase().includes(brand)) return false;
            }

            // 6. Danh mục / Phân loại
            if (filterState.category) {
                const cat = filterState.category.toLowerCase();
                if (!p.categoryName || !p.categoryName.toLowerCase().includes(cat)) return false;
            }

            return true;
        });

        // Sắp xếp
        if (filterState.keyword && (!filterState.sort || filterState.sort === "popular")) {
            const rawKw = filterState.keyword.trim().toLowerCase();
            const normKw = removeVietnameseDiacritics(rawKw);
            result.sort((a, b) => {
                const aName = (a.productName || "").toLowerCase();
                const bName = (b.productName || "").toLowerCase();
                const aNorm = removeVietnameseDiacritics(aName);
                const bNorm = removeVietnameseDiacritics(bName);

                const score = (name, norm) => {
                    if (name === rawKw || norm === normKw) return 100;
                    if (name.startsWith(rawKw) || norm.startsWith(normKw)) return 80;
                    if (name.includes(rawKw) || norm.includes(normKw)) return 60;
                    return 10;
                };

                const scoreA = score(aName, aNorm);
                const scoreB = score(bName, bNorm);
                if (scoreA !== scoreB) return scoreB - scoreA;
                return (a.productName || "").localeCompare(b.productName || "", "vi");
            });
        } else {
            result.sort((a, b) => {
                if (filterState.sort === "az") {
                    return (a.productName || "").localeCompare(b.productName || "", "vi", { sensitivity: "base" });
                } else if (filterState.sort === "za") {
                    return (b.productName || "").localeCompare(a.productName || "", "vi", { sensitivity: "base" });
                } else if (filterState.sort === "price-asc") {
                    return a.price - b.price;
                } else if (filterState.sort === "price-desc") {
                    return b.price - a.price;
                } else if (filterState.sort === "latest") {
                    return new Date(b.createdAt || 0) - new Date(a.createdAt || 0);
                } else {
                    if (b.isFeatured !== a.isFeatured) {
                        return b.isFeatured ? 1 : -1;
                    }
                    return b.productId - a.productId;
                }
            });
        }

        filteredProducts = result;
        updateUrlState();
        // Category pills
        document.querySelectorAll(".filter-category-pill").forEach(p => {
            if (!filterState.category) {
                p.classList.toggle("active", p.textContent.trim() === "Tất cả" || p.textContent.trim().startsWith("Tất cả"));
            } else {
                p.classList.toggle("active", p.textContent.trim() === filterState.category);
            }
        });

        updateClearBtnVisibility();
        renderProductsGrid();
        renderPagination();
    }

    // ============================================================
    // CÁC HÀM XỬ LÝ EVENT BỘ LỌC
    // ============================================================
    function toggleBrandFilter(brand) {
        if (filterState.brand === brand) {
            filterState.brand = "";
        } else {
            filterState.brand = brand;
        }

        document.querySelectorAll(".brand-grid-btn").forEach(btn => {
            btn.classList.toggle("active", btn.dataset.brand === filterState.brand);
        });

        applyFiltersAndRender();
    }

    function setPriceFilterRadio(val) {
        filterState.priceRange = val;
        filterState.customMinPrice = null;
        filterState.customMaxPrice = null;

        const minInput = document.getElementById("customMinPrice");
        const maxInput = document.getElementById("customMaxPrice");
        if (minInput) minInput.value = "";
        if (maxInput) maxInput.value = "";

        applyFiltersAndRender();
    }

    function applyCustomPriceRange() {
        const minVal = parseFloat(document.getElementById("customMinPrice").value);
        const maxVal = parseFloat(document.getElementById("customMaxPrice").value);

        filterState.customMinPrice = !isNaN(minVal) ? minVal : null;
        filterState.customMaxPrice = !isNaN(maxVal) ? maxVal : null;
        filterState.priceRange = "custom";

        // Bỏ chọn radio
        document.querySelectorAll('input[name="priceRangeRadio"]').forEach(r => r.checked = false);

        applyFiltersAndRender();
    }

    function selectCategoryFilter(catName) {
        filterState.category = (filterState.category === catName) ? "" : catName;

        document.querySelectorAll(".filter-category-pill").forEach(p => {
            if (!filterState.category) {
                p.classList.toggle("active", p.textContent.trim() === "Tất cả");
            } else {
                p.classList.toggle("active", p.textContent.trim() === filterState.category);
            }
        });

        applyFiltersAndRender();
    }

    function toggleQuickFilter(key) {
        if (key === "inStock") {
            const chk = document.getElementById("checkInStock");
            filterState.inStock = chk ? chk.checked : !filterState.inStock;
        } else if (key === "onSale") {
            const chk = document.getElementById("checkOnSale");
            filterState.onSale = chk ? chk.checked : !filterState.onSale;
        }
        applyFiltersAndRender();
    }

    function setSortOption(sortKey) {
        filterState.sort = sortKey;
        document.querySelectorAll(".sort-pill-btn").forEach(btn => {
            btn.classList.toggle("active", btn.dataset.sort === sortKey);
        });
        applyFiltersAndRender();
    }

    function resetAllFilters() {
        filterState.keyword = "";
        filterState.brand = "";
        filterState.priceRange = "";
        filterState.customMinPrice = null;
        filterState.customMaxPrice = null;
        filterState.category = "";
        filterState.inStock = false;
        filterState.onSale = false;
        filterState.sort = currentNavCategoryId ? "az" : "popular";
        filterState.page = 1;

        // Reset UI
        const searchInput = document.getElementById("searchInput");
        if (searchInput) searchInput.value = "";
        toggleClearBtn("");

        document.querySelectorAll(".brand-grid-btn").forEach(b => b.classList.remove("active"));
        
        const allPriceRadio = document.querySelector('input[name="priceRangeRadio"][value=""]');
        if (allPriceRadio) allPriceRadio.checked = true;

        const minInput = document.getElementById("customMinPrice");
        const maxInput = document.getElementById("customMaxPrice");
        if (minInput) minInput.value = "";
        if (maxInput) maxInput.value = "";

        const inStockBox = document.getElementById("checkInStock");
        if (inStockBox) inStockBox.checked = false;

        const onSaleBox = document.getElementById("checkOnSale");
        if (onSaleBox) onSaleBox.checked = false;

        document.querySelectorAll(".filter-category-pill").forEach(p => {
            p.classList.toggle("active", p.textContent.trim() === "Tất cả");
        });

        document.querySelectorAll(".sort-pill-btn").forEach(b => {
            b.classList.toggle("active", b.dataset.sort === filterState.sort);
        });

        applyFiltersAndRender();
    }

    function updateClearBtnVisibility() {
        const activeFiltersList = [
            Boolean(filterState.keyword),
            Boolean(filterState.brand),
            Boolean(filterState.priceRange),
            filterState.customMinPrice !== null || filterState.customMaxPrice !== null,
            Boolean(filterState.category),
            Boolean(filterState.inStock),
            Boolean(filterState.onSale)
        ];
        const activeCount = activeFiltersList.filter(Boolean).length;
        const hasFilter = activeCount > 0;

        const clearBtn = document.getElementById("clearAllFiltersBtn");
        if (clearBtn) {
            clearBtn.classList.toggle("d-none", !hasFilter);
        }

        const mobileBadge = document.getElementById("mobileFilterBadge");
        if (mobileBadge) {
            mobileBadge.textContent = activeCount;
            mobileBadge.classList.toggle("d-none", activeCount === 0);
        }
    }

    function updateUrlState() {
        const params = new URLSearchParams();
        if (currentNavCategoryId) params.set("categoryId", currentNavCategoryId);
        if (filterState.keyword) params.set("keyword", filterState.keyword);
        if (filterState.inStock) params.set("inStock", "1");
        if (filterState.onSale) params.set("onSale", "1");
        if (filterState.category && !currentNavCategoryId) params.set("category", filterState.category);
        if (filterState.brand) params.set("brand", filterState.brand);
        if (filterState.priceRange && filterState.priceRange !== "custom") params.set("price", filterState.priceRange);
        if (filterState.customMinPrice) params.set("minPrice", filterState.customMinPrice);
        if (filterState.customMaxPrice) params.set("maxPrice", filterState.customMaxPrice);

        const defaultSort = currentNavCategoryId ? "az" : "popular";
        if (filterState.sort !== defaultSort) params.set("sort", filterState.sort);
        if (filterState.page > 1) params.set("page", filterState.page);

        const newUrl = window.location.pathname + (params.toString() ? "?" + params.toString() : "");
        window.history.replaceState({}, "", newUrl);
    }

    // ============================================================
    // Render Lưới Sản Phẩm 3 Cột
    // ============================================================
    function renderProductsGrid() {
        const productList = document.getElementById("productList");
        const statusEl = document.getElementById("searchStatus");
        const total = filteredProducts.length;

        statusEl.innerHTML = `Tìm thấy <strong class="text-dark">${total}</strong> sản phẩm`;

        if (total === 0) {
            productList.innerHTML = `
                <div class="col-12 text-center py-5">
                    <div class="py-4">
                        <i class="fa-solid fa-box-open fa-3x text-muted mb-3 opacity-50"></i>
                        <h5 class="fw-bold text-dark">Không tìm thấy sản phẩm phù hợp</h5>
                        <p class="text-muted small">Hãy thử điều chỉnh mức giá, từ khóa tìm kiếm hoặc bấm đặt lại bộ lọc.</p>
                        <button class="btn btn-sm btn-outline-success rounded-pill px-4" onclick="resetAllFilters()">
                            <i class="fa-solid fa-arrow-rotate-left me-1"></i>Xem tất cả sản phẩm
                        </button>
                    </div>
                </div>
            `;
            return;
        }

        const startIndex = (filterState.page - 1) * filterState.pageSize;
        const pageItems = filteredProducts.slice(startIndex, startIndex + filterState.pageSize);

        let html = "";
        pageItems.forEach(p => {
            const imgUrl = p.thumbnailUrl || p.imageUrl || "/images/no-image.png";
            const currentPrice = p.price ? p.price.toLocaleString("vi-VN") : "0";
            const originalPrice = (p.originalPrice && p.originalPrice > p.price) ? p.originalPrice.toLocaleString("vi-VN") : null;
            const discountPercent = originalPrice ? Math.round(((p.originalPrice - p.price) / p.originalPrice) * 100) : 0;
            const isOutOfStock = p.stockQuantity <= 0;

            let brandTag = "";
            const brands = ["Shimano", "Daiwa", "Abu Garcia", "Penn", "Handing", "GW", "Ryobi", "Rapala"];
            for (let b of brands) {
                if (p.productName && p.productName.toLowerCase().includes(b.toLowerCase())) {
                    brandTag = `<span class="badge-brand-tag">${b}</span>`;
                    break;
                }
            }
            if (!brandTag && p.categoryName) {
                brandTag = `<span class="badge-brand-tag">${p.categoryName}</span>`;
            }

            html += `
                <div class="col-6 col-md-6 col-lg-4">
                    <a class="product-item" href="/Product/Detail/${p.productId}">
                        ${discountPercent > 0 ? `<span class="badge-discount">-${discountPercent}%</span>` : ""}
                        ${isOutOfStock ? `<span class="badge-stock-out">Hết hàng</span>` : ""}

                        <img src="${imgUrl}" 
                             class="img-fluid product-thumbnail" 
                             alt="${p.productName}"
                             loading="lazy" 
                             onerror="this.onerror=null; this.src='/images/no-image.png';">

                        ${brandTag}

                        <h3 class="product-title" title="${p.productName}">${p.productName}</h3>

                        <div class="d-flex align-items-baseline justify-content-center">
                            <span class="product-price">${currentPrice} đ</span>
                            ${originalPrice ? `<span class="product-original-price">${originalPrice} đ</span>` : ""}
                        </div>

                        <span class="icon-cross" title="Xem chi tiết">
                            <img src="/images/cross.svg" class="img-fluid">
                        </span>
                    </a>
                </div>
            `;
        });

        productList.innerHTML = html;
    }

    // ============================================================
    // Render Phân Trang
    // ============================================================
    function renderPagination() {
        const total = filteredProducts.length;
        const totalPages = Math.ceil(total / filterState.pageSize) || 1;
        const currentPage = Math.min(filterState.page, totalPages);
        filterState.page = currentPage;

        const summaryEl = document.getElementById("paginationSummary");
        const controlsEl = document.getElementById("paginationControls");

        if (total === 0) {
            summaryEl.textContent = "Không có sản phẩm";
            controlsEl.innerHTML = "";
            return;
        }

        const startIndex = (currentPage - 1) * filterState.pageSize + 1;
        const endIndex = Math.min(currentPage * filterState.pageSize, total);
        summaryEl.textContent = `Hiển thị ${startIndex} - ${endIndex} trên ${total} sản phẩm`;

        let controlsHtml = "";

        // Nút Prev
        controlsHtml += `
            <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                <button class="page-link" onclick="goToPage(${currentPage - 1})" aria-label="Previous">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
            </li>
        `;

        // Các số trang
        const maxButtons = 5;
        let startPage = Math.max(1, currentPage - Math.floor(maxButtons / 2));
        let endPage = Math.min(totalPages, startPage + maxButtons - 1);
        if (endPage - startPage + 1 < maxButtons) {
            startPage = Math.max(1, endPage - maxButtons + 1);
        }

        if (startPage > 1) {
            controlsHtml += `<li class="page-item"><button class="page-link" onclick="goToPage(1)">1</button></li>`;
            if (startPage > 2) {
                controlsHtml += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        for (let p = startPage; p <= endPage; p++) {
            controlsHtml += `
                <li class="page-item ${p === currentPage ? 'active' : ''}">
                    <button class="page-link" onclick="goToPage(${p})">${p}</button>
                </li>
            `;
        }

        if (endPage < totalPages) {
            if (endPage < totalPages - 1) {
                controlsHtml += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
            controlsHtml += `<li class="page-item"><button class="page-link" onclick="goToPage(${totalPages})">${totalPages}</button></li>`;
        }

        // Nút Next
        controlsHtml += `
            <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                <button class="page-link" onclick="goToPage(${currentPage + 1})" aria-label="Next">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </li>
        `;

        controlsEl.innerHTML = controlsHtml;
    }

    function goToPage(page) {
        const totalPages = Math.ceil(filteredProducts.length / filterState.pageSize) || 1;
        if (page < 1 || page > totalPages) return;
        filterState.page = page;
        renderProductsGrid();
        renderPagination();
        updateUrlState();

        const section = document.getElementById("products-section");
        if (section) section.scrollIntoView({ behavior: "smooth" });
    }

    function changePageSize(size) {
        filterState.pageSize = parseInt(size) || 12;
        filterState.page = 1;
        applyFiltersAndRender();
    }

    // ============================================================
    // Thiết lập ô tìm kiếm
    // ============================================================
    function setupSearchInput() {
        const input = document.getElementById("searchInput");
        const clearBtn = document.getElementById("clearSearchBtn");
        if (!input) return;

        input.addEventListener("input", function (e) {
            const val = e.target.value.trim();
            toggleClearBtn(val);

            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                filterState.keyword = val;
                applyFiltersAndRender();
            }, 250);
        });

        clearBtn?.addEventListener("click", function () {
            input.value = "";
            toggleClearBtn("");
            filterState.keyword = "";
            applyFiltersAndRender();
            input.focus();
        });
    }

    function toggleClearBtn(val) {
        const clearBtn = document.getElementById("clearSearchBtn");
        if (clearBtn) {
            clearBtn.style.display = (val && val.length > 0) ? "block" : "none";
        }
    }
</script>
