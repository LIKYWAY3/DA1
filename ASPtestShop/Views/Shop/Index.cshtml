        .product-item {
            padding: 10px;
        }
        .product-item .product-thumbnail {
            height: 125px;
            margin-bottom: 8px;
        }
        .product-item .product-title {
            font-size: 0.8125rem;
            margin-bottom: 4px;
        }
        .product-item .product-price {
            font-size: 0.875rem;
        }
