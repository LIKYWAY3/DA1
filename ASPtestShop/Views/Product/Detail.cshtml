    @{
        ViewData["Title"] = "Chi tiết sản phẩm";
        Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    }

    <div class="container my-5 py-5">

        <!-- Loading -->
        <div id="product-loading"
             class="d-flex justify-content-center align-items-center py-5">

            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Đang tải...</span>
            </div>

            <h3 class="text-muted ms-3">
                Đang tải thông tin sản phẩm...
            </h3>
        </div>

        <!-- Thông báo lỗi tải sản phẩm -->
        <div id="product-error"
             class="alert alert-danger text-center py-4 d-none">

            <h4>Rất tiếc, đã xảy ra lỗi</h4>

            <p id="product-error-message"></p>

            <a href="/shop" class="btn btn-primary">
                Quay lại cửa hàng
            </a>
        </div>

        <!-- Nội dung sản phẩm -->
        <div id="product-content" class="row d-none">

            <!-- Cột ảnh sản phẩm -->
            <div class="col-md-5">
                <div class="bg-white rounded shadow-sm p-3">

                    <img id="product-image"
                         src="/images/no-image.png"
                         alt="Ảnh sản phẩm"
                         class="img-fluid rounded"
                         style="
                            width: 100%;
                            min-height: 420px;
                            max-height: 520px;
                            object-fit: contain;
                         ">

                </div>
            </div>

            <!-- Cột thông tin sản phẩm -->
            <div class="col-md-7 mt-4 mt-md-0">

                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">

                        <li class="breadcrumb-item">
                            <a href="/"
                               style="text-decoration: none; color: #555;">
                                Trang chủ
                            </a>
                        </li>

                        <li class="breadcrumb-item">
                            <a href="/shop"
                               style="text-decoration: none; color: #555;">
                                Sản phẩm
                            </a>
                        </li>

                        <li id="breadcrumb-product-name"
                            class="breadcrumb-item active"
                            aria-current="page">
                            Chi tiết sản phẩm
                        </li>

                    </ol>
                </nav>

                <!-- Tên sản phẩm -->
                <h1 id="product-name"
                    class="display-6 fw-bold"
                    style="color: #2b3a28;">
                </h1>

                <!-- Giá bán -->
                <div class="mt-3">

                    <h2 id="product-price"
                        class="text-danger fw-bold mb-0">
                    </h2>

                    <div id="original-price-container"
                         class="mt-1 d-none">

                        <span id="product-original-price"
                              class="text-muted text-decoration-line-through">
                        </span>

                    </div>

                </div>

                <!-- Mô tả -->
                <div class="mt-4">
                    <p id="product-description"
                       class="text-muted"
                       style="line-height: 1.8;">
                    </p>
                </div>

                <!-- Thông báo thêm giỏ hàng -->
                <div id="cart-message" class="mt-3"></div>

                <!-- Số lượng và nút thêm giỏ -->
                <div class="d-flex flex-wrap align-items-center gap-3 mt-4">

                    <label for="qty" class="fw-bold mb-0">
                        Số lượng:
                    </label>

                    <input type="number"
                           id="qty"
                           class="form-control text-center"
                           value="1"
                           min="1"
                           max="99"
                           style="width: 90px;">

                    <button type="button"
                            id="btn-add-to-cart"
                            class="btn btn-success btn-lg"
                            style="
                                background-color: #121617;
                                border-color: #3b5d49;
                            ">

                        <i class="fas fa-shopping-cart me-2"></i>
                        <span>Thêm vào giỏ</span>

                    </button>

                </div>

            </div>
        </div>

        <!-- KHỐI ĐÁNH GIÁ VÀ NHẬN XÉT SẢN PHẨM -->
        <div id="product-reviews-section" class="mt-5 pt-5 border-top d-none">
            <div class="row g-4">
                <!-- Cột trái: Thống kê & Biểu đồ sao -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm p-4 h-100" style="border-radius: 12px; background: #fff;">
                        <h4 class="fw-bold mb-3">Đánh giá sản phẩm</h4>
                        <div class="d-flex align-items-baseline gap-2 mb-2">
                            <span id="review-avg-score" class="display-5 fw-bold text-warning">0.0</span>
                            <span class="fs-5 text-muted">/ 5</span>
                        </div>
                        <div id="review-stars-visual" class="fs-4 text-warning mb-2">
                            ☆☆☆☆☆
                        </div>
                        <div class="text-muted small mb-4">
                            Dựa trên <span id="review-total-count" class="fw-bold text-dark">0</span> lượt đánh giá
                        </div>

                        <!-- Thanh tiến trình từng sao -->
                        <div class="d-flex flex-column gap-2" id="star-breakdown-container">
                            <div class="d-flex align-items-center gap-2 small">
                                <span style="width: 40px;">5 ★</span>
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div id="progress-star-5" class="progress-bar bg-warning" style="width: 0%;"></div>
                                </div>
                                <span id="count-star-5" class="text-muted" style="width: 30px; text-align: right;">0</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 small">
                                <span style="width: 40px;">4 ★</span>
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div id="progress-star-4" class="progress-bar bg-warning" style="width: 0%;"></div>
                                </div>
                                <span id="count-star-4" class="text-muted" style="width: 30px; text-align: right;">0</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 small">
                                <span style="width: 40px;">3 ★</span>
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div id="progress-star-3" class="progress-bar bg-warning" style="width: 0%;"></div>
                                </div>
                                <span id="count-star-3" class="text-muted" style="width: 30px; text-align: right;">0</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 small">
                                <span style="width: 40px;">2 ★</span>
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div id="progress-star-2" class="progress-bar bg-warning" style="width: 0%;"></div>
                                </div>
                                <span id="count-star-2" class="text-muted" style="width: 30px; text-align: right;">0</span>
                            </div>
                            <div class="d-flex align-items-center gap-2 small">
                                <span style="width: 40px;">1 ★</span>
                                <div class="progress flex-grow-1" style="height: 8px;">
                                    <div id="progress-star-1" class="progress-bar bg-warning" style="width: 0%;"></div>
                                </div>
                                <span id="count-star-1" class="text-muted" style="width: 30px; text-align: right;">0</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Cột phải: Form viết đánh giá & Danh sách đánh giá -->
                <div class="col-lg-8">
                    <!-- Form viết đánh giá -->
                    <div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 12px; background: #fff;">
                        <h5 class="fw-bold mb-3">Viết nhận xét của bạn</h5>
                        <div id="review-alert-container"></div>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form id="submitReviewForm">
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted mb-1">Đánh giá số sao:</label>
                                    <div class="star-rating-selector fs-3 text-warning d-flex align-items-center gap-1" id="starSelector" style="cursor: pointer;">
                                        <span class="star-btn" data-star="1">★</span>
                                        <span class="star-btn" data-star="2">★</span>
                                        <span class="star-btn" data-star="3">★</span>
                                        <span class="star-btn" data-star="4">★</span>
                                        <span class="star-btn" data-star="5">★</span>
                                        <span class="ms-2 fs-6 text-muted" id="starLabel">Tuyệt vời (5/5)</span>
                                    </div>
                                    <input type="hidden" id="selectedStarValue" value="5">
                                </div>

                                <div class="mb-3">
                                    <label for="reviewCommentInput" class="form-label small fw-semibold text-muted">Nội dung nhận xét:</label>
                                    <textarea id="reviewCommentInput" class="form-control" rows="3" maxlength="1000" placeholder="Chia sẻ trải nghiệm thực tế của bạn về sản phẩm này..." required></textarea>
                                </div>

                                <button type="submit" id="btnSubmitReview" class="btn btn-dark px-4 py-2">
                                    Gửi đánh giá
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="p-3 bg-light rounded text-center border">
                                <p class="mb-2 text-muted">Vui lòng đăng nhập tài khoản để viết nhận xét và đánh giá cho sản phẩm này.</p>
                                <a href="/account/login?returnUrl=/Product/Detail/@ViewBag.ProductId" class="btn btn-outline-dark btn-sm px-4">
                                    Đăng nhập ngay
                                </a>
                            </div>
                        }
                    </div>

                    <!-- Danh sách đánh giá -->
                    <div class="card border-0 shadow-sm p-4" style="border-radius: 12px; background: #fff;">
                        <h5 class="fw-bold mb-3">Nhận xét từ khách hàng (<span id="reviewListCount">0</span>)</h5>
                        <div id="reviewsListContainer" class="d-flex flex-column gap-3">
                            <div class="text-center text-muted py-4">Đang tải nhận xét...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            const isUserLoggedIn = @(User.Identity?.IsAuthenticated == true ? "true" : "false");

            function redirectToLogin() {
                const returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
                window.location.href = `/account/login?returnUrl=${returnUrl}`;
            }

            const productIdFromRoute = 
                Number.parseInt('@ViewBag.ProductId', 10) || 
                Number.parseInt(window.location.pathname.split('/').filter(Boolean).pop(), 10) || 0;

            let currentProductId = 0;

            document.addEventListener("DOMContentLoaded", function () {
                loadProductDetail();
                initReviewForm();

                const btnAdd = document.getElementById("btn-add-to-cart");
                if (btnAdd) {
                    btnAdd.addEventListener("click", addToCart);
                }

                const qtyInput = document.getElementById("qty");
                if (qtyInput) {
                    qtyInput.addEventListener("click", function () {
                        if (!isUserLoggedIn) redirectToLogin();
                    });
                    qtyInput.addEventListener("change", function () {
                        if (!isUserLoggedIn) redirectToLogin();
                    });
                }
            });

            // ==================== LOAD PRODUCT ====================

            async function loadProductDetail() {
                if (productIdFromRoute <= 0) {
                    showProductError("ID sản phẩm không hợp lệ.");
                    return;
                }

                try {
                    const response = await fetch(
                        `/api/products/${productIdFromRoute}`,
                        {
                            method: "GET",
                            credentials: "include",
                            headers: {
                                "Accept": "application/json"
                            }
                        }
                    );

                    const result = await readJsonResponse(response);

                    if (!response.ok) {
                        throw new Error(
                            result?.message
                            ?? result?.error
                            ?? "Không tìm thấy sản phẩm."
                        );
                    }

                    // Hỗ trợ API trả trực tiếp hoặc bọc trong thuộc tính data
                    const product = result?.data ?? result;

                    if (!product) {
                        throw new Error("Dữ liệu sản phẩm không hợp lệ.");
                    }

                    renderProduct(product);
                }
                catch (error) {
                    console.error("Load product detail error:", error);

                    showProductError(
                        error?.message
                        ?? "Không thể tải thông tin sản phẩm."
                    );
                }
            }

            // ==================== RENDER PRODUCT ====================

            function renderProduct(product) {
                currentProductId = Number(
                    product.productId
                    ?? product.id
                    ?? productIdFromRoute
                );

                if (!Number.isInteger(currentProductId)
                    || currentProductId <= 0) {

                    showProductError(
                        "Không xác định được ID sản phẩm."
                    );

                    return;
                }

                const productName =
                    product.productName
                    ?? product.name
                    ?? "Sản phẩm";

                const description =
                    product.description
                    ?? product.shortDescription
                    ?? "Chưa có mô tả cho sản phẩm này.";

                const price = Number(
                    product.price
                    ?? product.salePrice
                    ?? 0
                );

                const originalPrice = Number(
                    product.originalPrice
                    ?? product.price
                    ?? 0
                );

                const imageUrl =
                    product.thumbnailUrl
                    ?? product.imageUrl
                    ?? product.images?.[0]?.imageUrl
                    ?? product.images?.[0]
                    ?? "/images/no-image.png";

                // Gán tên sản phẩm
                document.getElementById("product-name").textContent =
                    productName;

                document.getElementById(
                    "breadcrumb-product-name"
                ).textContent = productName;

                // Gán mô tả
                document.getElementById(
                    "product-description"
                ).textContent = description;

                // Gán giá
                document.getElementById(
                    "product-price"
                ).textContent = formatCurrency(price);

                // Hiển thị giá gốc nếu có giảm giá
                const originalPriceContainer =
                    document.getElementById(
                        "original-price-container"
                    );

                if (originalPrice > price) {
                    document.getElementById(
                        "product-original-price"
                    ).textContent = formatCurrency(originalPrice);

                    originalPriceContainer.classList.remove("d-none");
                }
                else {
                    originalPriceContainer.classList.add("d-none");
                }

                // Gán ảnh
                const productImage =
                    document.getElementById("product-image");

                productImage.src = imageUrl;
                productImage.alt = productName;

                productImage.onerror = function () {
                    this.onerror = null;
                    this.src = "/images/no-image.png";
                };

                // Ẩn loading, hiện nội dung
                document
                    .getElementById("product-loading")
                    .classList.add("d-none");

                document
                    .getElementById("product-content")
                    .classList.remove("d-none");

                const reviewsSection = document.getElementById("product-reviews-section");
                if (reviewsSection) reviewsSection.classList.remove("d-none");
                loadProductReviews(currentProductId);
            }

            // ==================== ADD TO CART ====================

            async function addToCart() {
                if (!isUserLoggedIn) {
                    redirectToLogin();
                    return;
                }

                const quantityInput =
                    document.getElementById("qty");

                const quantity =
                    Number.parseInt(quantityInput.value, 10);

                clearCartMessage();

                if (!Number.isInteger(currentProductId)
                    || currentProductId <= 0) {

                    showCartMessage(
                        "Không xác định được sản phẩm.",
                        "danger"
                    );

                    return;
                }

                if (!Number.isInteger(quantity) || quantity <= 0) {
                    showCartMessage(
                        "Số lượng phải lớn hơn 0.",
                        "warning"
                    );

                    quantityInput.focus();
                    return;
                }

                if (quantity > 99) {
                    showCartMessage(
                        "Số lượng tối đa là 99 sản phẩm.",
                        "warning"
                    );

                    quantityInput.value = 99;
                    quantityInput.focus();
                    return;
                }

                setAddButtonLoading(true);

                try {
                    const response = await fetch("/api/cart/add", {
                        method: "POST",
                        credentials: "include",
                        headers: {
                            "Content-Type": "application/json",
                            "Accept": "application/json"
                        },
                        body: JSON.stringify({
                            productId: currentProductId,
                            quantity: quantity
                        })
                    });

                    // Chưa đăng nhập hoặc bị chuyển hướng
                    if (response.status === 401 || response.status === 403 || response.redirected) {
                        redirectToLogin();
                        return;
                    }

                    const result = await readJsonResponse(response);

                    if (!result || !response.ok) {
                        if (!result) {
                            redirectToLogin();
                            return;
                        }
                        throw new Error(
                            result?.message
                            ?? result?.error
                            ?? result?.title
                            ?? "Không thể thêm sản phẩm vào giỏ hàng."
                        );
                    }

                    showCartMessage(
                        result?.message
                        ?? "Đã thêm sản phẩm vào giỏ hàng.",
                        "success",
                        true
                    );

                    updateCartCount(result);
                }
                catch (error) {
                    console.error("Add to cart error:", error);

                    showCartMessage(
                        error?.message
                        ?? "Không thể kết nối đến hệ thống giỏ hàng.",
                        "danger"
                    );
                }
                finally {
                    setAddButtonLoading(false);
                }
            }

            // ==================== CART MESSAGE ====================

            function showCartMessage(
                message,
                type,
                showCartLink = false
            ) {
                const messageContainer =
                    document.getElementById("cart-message");

                messageContainer.innerHTML = "";

                const alertElement =
                    document.createElement("div");

                alertElement.className =
                    `alert alert-${type} alert-dismissible fade show`;

                alertElement.setAttribute("role", "alert");

                const messageElement =
                    document.createElement("span");

                messageElement.textContent = message;

                alertElement.appendChild(messageElement);

                if (showCartLink) {
                    const cartLink =
                        document.createElement("a");

                    cartLink.href = "/cart";
                    cartLink.className = "alert-link ms-2";
                    cartLink.textContent = "Xem giỏ hàng";

                    alertElement.appendChild(cartLink);
                }

                const closeButton =
                    document.createElement("button");

                closeButton.type = "button";
                closeButton.className = "btn-close";
                closeButton.setAttribute(
                    "data-bs-dismiss",
                    "alert"
                );
                closeButton.setAttribute(
                    "aria-label",
                    "Đóng"
                );

                alertElement.appendChild(closeButton);
                messageContainer.appendChild(alertElement);
            }

            function clearCartMessage() {
                document.getElementById(
                    "cart-message"
                ).innerHTML = "";
            }

            // ==================== BUTTON LOADING ====================

            function setAddButtonLoading(isLoading) {
                const button =
                    document.getElementById(
                        "btn-add-to-cart"
                    );

                button.disabled = isLoading;

                if (isLoading) {
                    button.innerHTML = `
                        <span class="spinner-border spinner-border-sm me-2"
                              role="status"
                              aria-hidden="true">
                        </span>
                        Đang thêm...
                    `;
                }
                else {
                    button.innerHTML = `
                        <i class="fas fa-shopping-cart me-2"></i>
                        <span>Thêm vào giỏ</span>
                    `;
                }
            }

            // ==================== CART COUNT ====================

            function updateCartCount(result) {
                const cartCountElement =
                    document.getElementById("cart-count");

                if (!cartCountElement) {
                    return;
                }

                const cartCount =
                    result?.cartItemCount
                    ?? result?.totalQuantity
                    ?? result?.data?.cartItemCount
                    ?? result?.data?.totalQuantity;

                if (cartCount !== undefined
                    && cartCount !== null) {

                    cartCountElement.textContent =
                        cartCount;
                }
            }

            // ==================== ERROR ====================

            function showProductError(message) {
                document
                    .getElementById("product-loading")
                    .classList.add("d-none");

                document
                    .getElementById("product-content")
                    .classList.add("d-none");

                const errorContainer =
                    document.getElementById("product-error");

                document.getElementById(
                    "product-error-message"
                ).textContent = message;

                errorContainer.classList.remove("d-none");
            }

            // ==================== HELPERS ====================

            async function readJsonResponse(response) {
                const contentType =
                    response.headers.get("content-type") ?? "";

                if (!contentType.includes("application/json")) {
                    return null;
                }

                try {
                    return await response.json();
                }
                catch {
                    return null;
                }
            }

            function formatCurrency(value) {
            return new Intl.NumberFormat("vi-VN", {
                style: "currency",
                currency: "VND"
            }).format(Number(value) || 0);
        }

        // ==================== REVIEWS LOGIC ====================
        function initReviewForm() {
            const starSelector = document.getElementById("starSelector");
            const hiddenStar = document.getElementById("selectedStarValue");
            const starLabel = document.getElementById("starLabel");
            const reviewForm = document.getElementById("submitReviewForm");

            if (starSelector && hiddenStar) {
                const starBtns = starSelector.querySelectorAll(".star-btn");
                const labels = {
                    1: "Rất tệ (1/5)",
                    2: "Không hài lòng (2/5)",
                    3: "Bình thường (3/5)",
                    4: "Hài lòng (4/5)",
                    5: "Tuyệt vời (5/5)"
                };

                function highlightStars(val) {
                    starBtns.forEach(btn => {
                        const starNum = Number(btn.dataset.star);
                        btn.style.color = starNum <= val ? "#ffc107" : "#dee2e6";
                    });
                    if (starLabel) starLabel.textContent = labels[val] || `${val}/5`;
                }

                starBtns.forEach(btn => {
                    btn.addEventListener("click", function() {
                        const val = Number(btn.dataset.star);
                        hiddenStar.value = val;
                        highlightStars(val);
                    });

                    btn.addEventListener("mouseenter", function() {
                        highlightStars(Number(btn.dataset.star));
                    });
                });

                starSelector.addEventListener("mouseleave", function() {
                    highlightStars(Number(hiddenStar.value || 5));
                });

                highlightStars(5);
            }

            if (reviewForm) {
                reviewForm.addEventListener("submit", submitReviewHandler);
            }
        }

        async function loadProductReviews(productId) {
            const listContainer = document.getElementById("reviewsListContainer");
            if (!listContainer || !productId) return;

            try {
                const res = await fetch(`/api/reviews/product/${productId}`, {
                    method: "GET",
                    headers: { "Accept": "application/json" }
                });

                if (!res.ok) throw new Error("Không thể tải danh sách đánh giá");
                const data = await res.json();

                renderReviews(data);
            } catch (err) {
                console.error("Lỗi tải reviews:", err);
                listContainer.innerHTML = '<div class="text-center text-muted py-3">Không thể tải nhận xét của sản phẩm.</div>';
            }
        }

        function renderReviews(data) {
            const avg = Number(data.averageRating) || 0;
            const total = Number(data.totalReviews) || 0;

            document.getElementById("review-avg-score").textContent = avg.toFixed(1);
            document.getElementById("review-total-count").textContent = total;
            document.getElementById("reviewListCount").textContent = total;
            document.getElementById("review-stars-visual").innerHTML = getStarString(avg);

            // Cập nhật progress bars
            const counts = data.starCounts || {};
            for (let i = 1; i <= 5; i++) {
                const starCount = counts[i] || 0;
                const pct = total > 0 ? Math.round((starCount / total) * 100) : 0;
                const bar = document.getElementById(`progress-star-${i}`);
                const countLabel = document.getElementById(`count-star-${i}`);
                if (bar) bar.style.width = `${pct}%`;
                if (countLabel) countLabel.textContent = starCount;
            }

            // Danh sách review items
            const listContainer = document.getElementById("reviewsListContainer");
            const reviews = data.reviews || [];

            if (reviews.length === 0) {
                listContainer.innerHTML = `
                    <div class="text-center text-muted py-4">
                        <div class="fs-1 mb-2">💬</div>
                        <div>Chưa có đánh giá nào cho sản phẩm này. Hãy là người đầu tiên trải nghiệm và để lại nhận xét!</div>
                    </div>
                `;
                return;
            }

            listContainer.innerHTML = reviews.map(r => `
                <div class="p-3 bg-light rounded border">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle bg-dark text-white fw-bold d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; font-size: 0.9rem;">
                                ${(r.fullName || r.userName || 'K').charAt(0).toUpperCase()}
                            </div>
                            <div>
                                <strong class="text-dark d-block">${escapeHtml(r.fullName || r.userName)}</strong>
                                <small class="text-muted">${new Date(r.createdAt).toLocaleDateString('vi-VN')}</small>
                            </div>
                        </div>
                        <div class="text-warning fs-6">
                            ${getStarString(r.rating)}
                        </div>
                    </div>
                    <p class="mb-0 text-secondary" style="font-size: 0.95rem; line-height: 1.6;">
                        ${escapeHtml(r.comment || "")}
                    </p>
                </div>
            `).join('');
        }

        async function submitReviewHandler(e) {
            e.preventDefault();

            const rating = Number(document.getElementById("selectedStarValue")?.value || 5);
            const comment = document.getElementById("reviewCommentInput")?.value.trim() || "";
            const btn = document.getElementById("btnSubmitReview");

            if (!comment) {
                showReviewAlert("Vui lòng nhập nội dung nhận xét.", "warning");
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Đang gửi...';

            try {
                const res = await fetch("/api/reviews", {
                    method: "POST",
                    credentials: "include",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify({
                        productId: currentProductId,
                        rating: rating,
                        comment: comment
                    })
                });

                if (res.status === 401) {
                    showReviewAlert("Bạn cần đăng nhập để viết nhận xét.", "danger");
                    return;
                }

                const data = await res.json();
                if (!res.ok || !data.success) {
                    showReviewAlert(data.message || "Gửi đánh giá thất bại.", "danger");
                    return;
                }

                showReviewAlert("Cảm ơn bạn! Đánh giá của bạn đã được ghi nhận.", "success");
                document.getElementById("reviewCommentInput").value = "";

                // Tải lại danh sách review
                await loadProductReviews(currentProductId);

            } catch (err) {
                showReviewAlert("Lỗi mạng khi gửi đánh giá.", "danger");
            } finally {
                btn.disabled = false;
                btn.textContent = "Gửi đánh giá";
            }
        }

        function showReviewAlert(msg, type = "info") {
            const box = document.getElementById("review-alert-container");
            if (!box) return;
            box.innerHTML = `<div class="alert alert-${type} py-2 mb-3 small" role="alert">${msg}</div>`;
            setTimeout(() => { box.innerHTML = ""; }, 4000);
        }

        function getStarString(rating) {
            const rounded = Math.round(Number(rating) || 0);
            let str = "";
            for (let i = 1; i <= 5; i++) {
                str += i <= rounded ? "★" : "☆";
            }
            return str;
        }

        function escapeHtml(value) {
            return String(value ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }
    </script>
}