@{
    ViewData["Title"] = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">Quản lý đơn hàng</h3>
            <p class="text-muted small mb-0">Theo dõi, cập nhật tiến độ xử lý và dọn dẹp các đơn hàng đã bị hủy</p>
        </div>

        <div class="d-flex gap-2">
            <button type="button" id="btnCleanupCancelled" class="btn btn-outline-danger d-none" onclick="cleanupAllCancelledOrders()">
                🧹 Dọn dẹp tất cả đơn đã hủy (<span id="cancelledCountBadge">0</span>)
            </button>
            <a href="/admin" class="btn btn-outline-dark">
                Quay lại Admin
            </a>
        </div>
    </div>

    <div id="orderMessage"></div>

    <!-- TABS LỌC TRẠNG THÁI -->
    <ul class="nav nav-pills mb-3 gap-2" id="orderStatusTabs">
        <li class="nav-item">
            <button class="nav-link active rounded-pill px-3 py-1" onclick="filterByStatus('ALL', this)">
                Tất cả (<span id="countAll">0</span>)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-3 py-1" onclick="filterByStatus('Pending', this)">
                Chờ xử lý (<span id="countPending">0</span>)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-3 py-1" onclick="filterByStatus('Confirmed', this)">
                Đã xác nhận (<span id="countConfirmed">0</span>)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-3 py-1" onclick="filterByStatus('Shipped', this)">
                Đang giao (<span id="countShipped">0</span>)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-3 py-1" onclick="filterByStatus('Completed', this)">
                Hoàn thành (<span id="countCompleted">0</span>)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-3 py-1 text-danger" onclick="filterByStatus('Cancelled', this)">
                Đã hủy (<span id="countCancelled">0</span>)
            </button>
        </li>
    </ul>

    <div class="card border-0 shadow-sm" style="border-radius: 12px; background: #fff;">
        <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0">
            <!-- Ô TÌM KIẾM -->
            <div class="row g-2 align-items-center">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0">🔍</span>
                        <input type="text" class="form-control border-start-0 bg-light" id="orderSearchInput" placeholder="Tìm theo mã đơn, người nhận, SĐT..." onkeyup="handleOrderSearch()">
                    </div>
                </div>
                <div class="col-md-7 text-md-end text-muted small">
                    Đang hiển thị: <span class="fw-bold text-dark" id="displayOrderCount">0</span> đơn hàng
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã đơn</th>
                            <th>Người nhận</th>
                            <th>SĐT</th>
                            <th>Tổng tiền</th>
                            <th>Trạng thái đơn</th>
                            <th>Thanh toán</th>
                            <th>Phương thức</th>
                            <th>Ngày đặt</th>
                            <th class="text-end">Thao tác</th>
                        </tr>
                    </thead>

                    <tbody id="orderTableBody">
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                Đang tải danh sách đơn hàng...
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const orderTableBody = document.getElementById("orderTableBody");
        const orderMessage = document.getElementById("orderMessage");

        let allOrders = [];
        let currentStatusFilter = "ALL";

        document.addEventListener("DOMContentLoaded", function() {
            loadAdminOrders();
        });

        function showMessage(msg, type = "success") {
            orderMessage.innerHTML = `
                <div class="alert alert-${type} alert-dismissible fade show" role="alert">
                    ${msg}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            `;
            setTimeout(() => { orderMessage.innerHTML = ""; }, 4500);
        }

        async function loadAdminOrders() {
            try {
                const response = await fetch("/api/admin/orders", {
                    method: "GET",
                    credentials: "include"
                });

                if (response.status === 401 || response.status === 403) {
                    window.location.href = "/admin/login";
                    return;
                }

                if (!response.ok) {
                    showMessage("Không thể tải danh sách đơn hàng.", "danger");
                    orderTableBody.innerHTML = "";
                    return;
                }

                allOrders = await response.json();
                updateCounts();
                applyFilterAndRender();

            } catch (error) {
                console.error("Lỗi tải admin orders:", error);
                showMessage("Có lỗi xảy ra khi tải danh sách đơn hàng.", "danger");
                orderTableBody.innerHTML = "";
            }
        }

        function updateCounts() {
            const counts = {
                ALL: allOrders.length,
                Pending: 0,
                Confirmed: 0,
                Shipped: 0,
                Completed: 0,
                Cancelled: 0
            };

            allOrders.forEach(o => {
                const s = o.orderStatus || "Pending";
                if (counts[s] !== undefined) counts[s]++;
                else if (s === "Delivered") counts.Completed++;
            });

            document.getElementById("countAll").textContent = counts.ALL;
            document.getElementById("countPending").textContent = counts.Pending;
            document.getElementById("countConfirmed").textContent = counts.Confirmed;
            document.getElementById("countShipped").textContent = counts.Shipped;
            document.getElementById("countCompleted").textContent = counts.Completed;
            document.getElementById("countCancelled").textContent = counts.Cancelled;
            document.getElementById("cancelledCountBadge").textContent = counts.Cancelled;

            // Nút cleanup hiển thị khi ở tab Cancelled hoặc có đơn hủy
            const cleanupBtn = document.getElementById("btnCleanupCancelled");
            if (counts.Cancelled > 0 && currentStatusFilter === "Cancelled") {
                cleanupBtn.classList.remove("d-none");
            } else {
                cleanupBtn.classList.add("d-none");
            }
        }

        function filterByStatus(status, tabBtn) {
            currentStatusFilter = status;
            document.querySelectorAll("#orderStatusTabs .nav-link").forEach(btn => btn.classList.remove("active"));
            if (tabBtn) tabBtn.classList.add("active");

            // Hiển thị nút cleanup nếu đang ở tab Cancelled
            const cancelledCount = allOrders.filter(o => o.orderStatus === "Cancelled").length;
            const cleanupBtn = document.getElementById("btnCleanupCancelled");
            if (status === "Cancelled" && cancelledCount > 0) {
                cleanupBtn.classList.remove("d-none");
            } else {
                cleanupBtn.classList.add("d-none");
            }

            applyFilterAndRender();
        }

        function handleOrderSearch() {
            applyFilterAndRender();
        }

        function applyFilterAndRender() {
            const query = (document.getElementById("orderSearchInput")?.value || "").trim().toLowerCase();

            let filtered = allOrders;

            // Lọc trạng thái
            if (currentStatusFilter !== "ALL") {
                if (currentStatusFilter === "Completed") {
                    filtered = filtered.filter(o => o.orderStatus === "Completed" || o.orderStatus === "Delivered");
                } else {
                    filtered = filtered.filter(o => o.orderStatus === currentStatusFilter);
                }
            }

            // Lọc từ khóa tìm kiếm
            if (query) {
                filtered = filtered.filter(o =>
                    (o.orderCode && o.orderCode.toLowerCase().includes(query)) ||
                    (o.receiverName && o.receiverName.toLowerCase().includes(query)) ||
                    (o.receiverPhone && o.receiverPhone.includes(query))
                );
            }

            document.getElementById("displayOrderCount").textContent = filtered.length;
            renderOrders(filtered);
        }

        function renderOrders(orders) {
            if (!Array.isArray(orders) || orders.length === 0) {
                orderTableBody.innerHTML = `
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            Không tìm thấy đơn hàng nào.
                        </td>
                    </tr>
                `;
                return;
            }

            orderTableBody.innerHTML = orders.map(order => {
                const isCancelled = order.orderStatus === "Cancelled";

                const deleteBtnHtml = isCancelled
                    ? `<button type="button" class="btn btn-sm btn-outline-danger" title="Xóa đơn hàng đã hủy" onclick="deleteCancelledOrder(${order.orderId}, '${order.orderCode}')">
                            🗑️
                       </button>`
                    : '';

                return `
                    <tr>
                        <td><strong>${order.orderCode || ""}</strong></td>
                        <td>${escapeHtml(order.receiverName || "")}</td>
                        <td>${escapeHtml(order.receiverPhone || "")}</td>
                        <td><strong class="text-dark">${formatCurrency(order.finalAmount)}</strong></td>
                        <td>${renderOrderStatus(order.orderStatus)}</td>
                        <td>${renderPaymentStatus(order.paymentStatus)}</td>
                        <td>${order.paymentMethod || "COD"}</td>
                        <td class="small text-muted">${formatDate(order.createdAt)}</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <a href="/admin/orders/detail/${order.orderId}" class="btn btn-sm btn-dark">
                                    Chi tiết
                                </a>
                                ${deleteBtnHtml}
                            </div>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        async function deleteCancelledOrder(orderId, orderCode) {
            if (!confirm(`Bạn có chắc chắn muốn xóa vĩnh viễn đơn hàng đã hủy '${orderCode}'? Thao tác này không thể hoàn tác.`)) {
                return;
            }

            try {
                const res = await fetch(`/api/admin/orders/${orderId}`, {
                    method: "DELETE",
                    credentials: "include"
                });

                const data = await res.json();
                if (!res.ok || !data.success) {
                    showMessage(data.message || "Xóa đơn hàng thất bại.", "danger");
                    return;
                }

                showMessage(data.message, "success");
                await loadAdminOrders();

            } catch (err) {
                showMessage("Lỗi kết nối khi xóa đơn hàng.", "danger");
            }
        }

        async function cleanupAllCancelledOrders() {
            const cancelledCount = allOrders.filter(o => o.orderStatus === "Cancelled").length;
            if (cancelledCount === 0) {
                showMessage("Không có đơn hàng đã hủy nào cần dọn dẹp.", "info");
                return;
            }

            if (!confirm(`CẢNH BÁO: Bạn sắp dọn dẹp và xóa vĩnh viễn toàn bộ ${cancelledCount} đơn hàng có trạng thái Đã hủy (Cancelled). Bạn có chắc chắn muốn tiếp tục?`)) {
                return;
            }

            try {
                const res = await fetch("/api/admin/orders/cleanup-cancelled", {
                    method: "DELETE",
                    credentials: "include"
                });

                const data = await res.json();
                if (!res.ok || !data.success) {
                    showMessage(data.message || "Dọn dẹp đơn hàng thất bại.", "danger");
                    return;
                }

                showMessage(data.message, "success");
                await loadAdminOrders();

            } catch (err) {
                showMessage("Lỗi kết nối khi dọn dẹp đơn hàng.", "danger");
            }
        }

        function formatCurrency(value) {
            return new Intl.NumberFormat("vi-VN", {
                style: "currency",
                currency: "VND"
            }).format(value || 0);
        }

        function formatDate(value) {
            if (!value) return "";
            const date = new Date(value);
            return date.toLocaleDateString("vi-VN") + " " + date.toLocaleTimeString("vi-VN", {
                hour: "2-digit",
                minute: "2-digit"
            });
        }

        function renderOrderStatus(status) {
            const value = status || "Pending";
            let badgeClass = "bg-secondary";
            if (value === "Pending") badgeClass = "bg-warning text-dark";
            if (value === "Confirmed") badgeClass = "bg-primary";
            if (value === "Shipped") badgeClass = "bg-info text-dark";
            if (value === "Completed" || value === "Delivered") badgeClass = "bg-success";
            if (value === "Cancelled") badgeClass = "bg-danger";
            return `<span class="badge ${badgeClass}">${value}</span>`;
        }

        function renderPaymentStatus(status) {
            const value = status || "Unpaid";
            let badgeClass = "bg-secondary";
            if (value === "Unpaid") badgeClass = "bg-warning text-dark";
            if (value === "Paid") badgeClass = "bg-success";
            if (value === "Failed") badgeClass = "bg-danger";
            return `<span class="badge ${badgeClass}">${value}</span>`;
        }

        function escapeHtml(text) {
            if (!text) return "";
            return String(text).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");
        }
    </script>
}