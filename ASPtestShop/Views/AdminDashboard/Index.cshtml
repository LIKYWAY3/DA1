@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-0">
    <!-- HÀNG 1: THẺ KPI CHỈ SỐ DOANH THU & ĐƠN HÀNG -->
    <div class="row g-3 mb-4">
        <!-- Tổng doanh thu -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: linear-gradient(135deg, #253f36 0%, #3b5d50 100%); color: #fff;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-uppercase fw-semibold" style="font-size: 0.8rem; letter-spacing: 0.5px; opacity: 0.85;">Tổng doanh thu</span>
                        <span style="font-size: 1.5rem;">💰</span>
                    </div>
                    <h3 class="fw-bold mb-1" id="kpiTotalRevenue">0 đ</h3>
                    <small style="opacity: 0.8;">Đơn hoàn tất & đã thanh toán</small>
                </div>
            </div>
        </div>

        <!-- Doanh thu tháng này -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #ffffff;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-uppercase fw-semibold text-muted" style="font-size: 0.8rem; letter-spacing: 0.5px;">Doanh thu tháng này</span>
                        <span style="font-size: 1.5rem;">📈</span>
                    </div>
                    <h3 class="fw-bold text-success mb-1" id="kpiMonthRevenue">0 đ</h3>
                    <small class="text-muted" id="currentMonthLabel">Tháng hiện tại</small>
                </div>
            </div>
        </div>

        <!-- Đơn chờ xử lý -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #ffffff;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-uppercase fw-semibold text-muted" style="font-size: 0.8rem; letter-spacing: 0.5px;">Đơn chờ xử lý</span>
                        <span style="font-size: 1.5rem;">⏳</span>
                    </div>
                    <h3 class="fw-bold text-warning mb-1" id="kpiPendingOrders">0</h3>
                    <small class="text-muted">Cần xác nhận & đóng gói</small>
                </div>
            </div>
        </div>

        <!-- Khách hàng -->
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #ffffff;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-uppercase fw-semibold text-muted" style="font-size: 0.8rem; letter-spacing: 0.5px;">Tổng khách hàng</span>
                        <span style="font-size: 1.5rem;">👥</span>
                    </div>
                    <h3 class="fw-bold text-primary mb-1" id="kpiTotalCustomers">0</h3>
                    <small class="text-muted">Tài khoản đã đăng ký</small>
                </div>
            </div>
        </div>
    </div>

    <!-- HÀNG 2: BIỂU ĐỒ DOANH THU 7 NGÀY & ĐIỀU HƯỚNG NHANH -->
    <div class="row g-3 mb-4">
        <!-- Biểu đồ doanh thu -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #fff;">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1">Xu hướng doanh thu 7 ngày qua</h5>
                        <p class="text-muted small mb-0">Biểu đồ tổng hợp doanh thu theo từng ngày</p>
                    </div>
                    <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">Thời gian thực</span>
                </div>
                <div class="card-body p-4">
                    <div style="height: 280px; position: relative;">
                        <canvas id="revenueChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Lối tắt quản lý nhanh 6 phân hệ -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm h-100" style="border-radius: 12px; background: #fff;">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2">
                    <h5 class="fw-bold mb-1">Truy cập nhanh phân hệ</h5>
                    <p class="text-muted small mb-0">Điều hướng đến các module quản trị</p>
                </div>
                <div class="card-body p-3">
                    <div class="list-group list-group-flush">
                        <a href="/admin/orders" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-3 border-0 rounded mb-1" style="background: #f8faf9;">
                            <div class="d-flex align-items-center gap-3">
                                <span style="font-size: 1.3rem;">📦</span>
                                <div>
                                    <div class="fw-semibold">Quản lý đơn hàng</div>
                                    <small class="text-muted">Duyệt và cập nhật trạng thái đơn</small>
                                </div>
                            </div>
                            <span class="badge bg-warning text-dark" id="badgePendingOrders">0</span>
                        </a>

                        <a href="/admin/products" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-3 border-0 rounded mb-1" style="background: #f8faf9;">
                            <div class="d-flex align-items-center gap-3">
                                <span style="font-size: 1.3rem;">🎣</span>
                                <div>
                                    <div class="fw-semibold">Quản lý sản phẩm</div>
                                    <small class="text-muted">Kho hàng đồ câu & hình ảnh</small>
                                </div>
                            </div>
                            <span class="badge bg-secondary" id="badgeTotalProducts">0</span>
                        </a>

                        <a href="/admin/coupons" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-3 border-0 rounded mb-1" style="background: #f8faf9;">
                            <div class="d-flex align-items-center gap-3">
                                <span style="font-size: 1.3rem;">🎟️</span>
                                <div>
                                    <div class="fw-semibold">Quản lý mã giảm giá</div>
                                    <small class="text-muted">Tạo coupon & cấu hình hạn mức</small>
                                </div>
                            </div>
                            <span class="text-muted">&rarr;</span>
                        </a>

                        <a href="/admin/reviews" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-3 border-0 rounded mb-1" style="background: #f8faf9;">
                            <div class="d-flex align-items-center gap-3">
                                <span style="font-size: 1.3rem;">⭐</span>
                                <div>
                                    <div class="fw-semibold">Kiểm duyệt đánh giá</div>
                                    <small class="text-muted">Duyệt bình luận khách hàng</small>
                                </div>
                            </div>
                            <span class="text-muted">&rarr;</span>
                        </a>

                        <a href="/admin/users" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-3 border-0 rounded mb-1" style="background: #f8faf9;">
                            <div class="d-flex align-items-center gap-3">
                                <span style="font-size: 1.3rem;">👥</span>
                                <div>
                                    <div class="fw-semibold">Quản lý khách hàng</div>
                                    <small class="text-muted">Xem thành viên & khóa tài khoản</small>
                                </div>
                            </div>
                            <span class="text-muted">&rarr;</span>
                        </a>

                        <a href="/admin/categories" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-3 border-0 rounded" style="background: #f8faf9;">
                            <div class="d-flex align-items-center gap-3">
                                <span style="font-size: 1.3rem;">🗂️</span>
                                <div>
                                    <div class="fw-semibold">Quản lý danh mục</div>
                                    <small class="text-muted">Cây phân cấp danh mục cha - con</small>
                                </div>
                            </div>
                            <span class="text-muted">&rarr;</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- HÀNG 3: BẢNG 5 ĐƠN HÀNG GẦN ĐÂY CẦN CHÚ Ý -->
    <div class="row g-3">
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="border-radius: 12px; background: #fff;">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1">Đơn hàng mới nhất</h5>
                        <p class="text-muted small mb-0">Các giao dịch đặt hàng phát sinh gần đây</p>
                    </div>
                    <a href="/admin/orders" class="btn btn-sm btn-outline-success rounded-pill px-3">Xem tất cả đơn &rarr;</a>
                </div>
                <div class="card-body p-4 pt-2">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã đơn</th>
                                    <th>Người nhận</th>
                                    <th>Tổng tiền</th>
                                    <th>Phương thức</th>
                                    <th>Thanh toán</th>
                                    <th>Trạng thái đơn</th>
                                    <th>Ngày đặt</th>
                                    <th class="text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="recentOrdersBody">
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">Đang tải số liệu...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            loadDashboardData();
        });

        let revenueChart = null;

        async function loadDashboardData() {
            try {
                const res = await fetch("/api/admin/dashboard/stats", {
                    method: "GET",
                    credentials: "include"
                });

                if (!res.ok) throw new Error("Không thể tải dữ liệu thống kê");
                const data = await res.json();

                // Format tiền tệ VNĐ
                const formatVND = (num) => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(num || 0);

                // Điền KPI
                document.getElementById("kpiTotalRevenue").textContent = formatVND(data.totalRevenue);
                document.getElementById("kpiMonthRevenue").textContent = formatVND(data.monthRevenue);
                document.getElementById("kpiPendingOrders").textContent = (data.pendingOrders || 0).toLocaleString();
                document.getElementById("kpiTotalCustomers").textContent = (data.totalCustomers || 0).toLocaleString();

                document.getElementById("badgePendingOrders").textContent = data.pendingOrders || 0;
                document.getElementById("badgeTotalProducts").textContent = data.totalProducts || 0;

                const currentMonth = new Date().getMonth() + 1;
                document.getElementById("currentMonthLabel").textContent = `Tháng ${currentMonth}/${new Date().getFullYear()}`;

                // Vẽ biểu đồ
                renderRevenueChart(data.dailyRevenues || []);

                // Điền đơn hàng gần đây
                renderRecentOrders(data.recentOrders || []);
            } catch (err) {
                console.error("Lỗi tải dashboard:", err);
            }
        }

        function renderRevenueChart(dailyData) {
            const ctx = document.getElementById('revenueChart').getContext('2d');
            const labels = dailyData.map(d => d.date);
            const revenues = dailyData.map(d => d.revenue);

            if (revenueChart) {
                revenueChart.destroy();
            }

            revenueChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: revenues,
                        borderColor: '#3b5d50',
                        backgroundColor: 'rgba(59, 93, 80, 0.12)',
                        borderWidth: 3,
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#f9bf29',
                        pointBorderColor: '#3b5d50',
                        pointBorderWidth: 2,
                        pointRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (context) => 'Doanh thu: ' + new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y)
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: (val) => val >= 1000000 ? (val / 1000000) + ' Tr' : (val >= 1000 ? (val / 1000) + ' k' : val)
                            },
                            grid: { color: 'rgba(0,0,0,0.05)' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        function renderRecentOrders(orders) {
            const tbody = document.getElementById("recentOrdersBody");
            if (!orders || orders.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">Chưa có đơn hàng nào phát sinh.</td></tr>';
                return;
            }

            const formatVND = (num) => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(num || 0);

            tbody.innerHTML = orders.map(o => {
                const statusBadge = getStatusBadge(o.orderStatus);
                const payBadge = o.paymentStatus === 'Paid' ? '<span class="badge bg-success">Đã thanh toán</span>' : '<span class="badge bg-secondary">Chưa thanh toán</span>';
                const createdDate = new Date(o.createdAt).toLocaleString('vi-VN', { dateStyle: 'short', timeStyle: 'short' });

                return `
                    <tr>
                        <td class="fw-semibold text-primary">#${o.orderCode}</td>
                        <td>${o.receiverName || 'Khách vãng lai'}</td>
                        <td class="fw-bold text-dark">${formatVND(o.finalAmount)}</td>
                        <td><span class="badge bg-light text-dark border">${o.paymentMethod || 'COD'}</span></td>
                        <td>${payBadge}</td>
                        <td>${statusBadge}</td>
                        <td class="text-muted small">${createdDate}</td>
                        <td class="text-end">
                            <a href="/admin/orders/detail/${o.orderId}" class="btn btn-sm btn-outline-dark rounded-pill px-3">Chi tiết</a>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        function getStatusBadge(status) {
            switch (status) {
                case "Pending":
                    return '<span class="badge bg-warning text-dark">Chờ xử lý</span>';
                case "Processing":
                    return '<span class="badge bg-info text-dark">Đang xử lý</span>';
                case "Shipped":
                    return '<span class="badge bg-primary">Đang giao</span>';
                case "Delivered":
                case "Completed":
                    return '<span class="badge bg-success">Hoàn thành</span>';
                case "Cancelled":
                    return '<span class="badge bg-danger">Đã hủy</span>';
                default:
                    return `<span class="badge bg-secondary">${status || 'N/A'}</span>`;
            }
        }
    </script>
}