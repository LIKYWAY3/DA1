@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<div class="container-fluid px-0">

    <!-- =================================================================== -->
    <!-- HÀNG 1: TODAY'S SALES & TỔNG QUAN CHỈ SỐ DOANH SỐ HỆ THỐNG          -->
    <!-- =================================================================== -->
    <div class="admin-card p-4 mb-4">
        <!-- Header khối Today's Sales -->
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 mb-3 border-bottom">
            <div>
                <h5 class="fw-bold mb-1 text-dark fs-5">
                    <i class="fa-solid fa-chart-line text-fuu-primary me-2"></i>Tổng quan doanh số &amp; hoạt động
                </h5>
                <p class="text-muted small mb-0">Thống kê kinh doanh phát sinh trong ngày và lũy kế hệ thống FuuFishing</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn-refresh-stats" onclick="loadDashboardData()" title="Cập nhật lại số liệu mới nhất">
                    <i class="fa-solid fa-rotate me-1"></i> Làm mới
                </button>
            </div>
        </div>

        <!-- 4 thẻ KPI con bên trong (Grid 4 cột chuẩn Dabang, style FuuFishing) -->
        <div class="row g-3">
            <!-- 1. Doanh số hôm nay -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="kpi-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <span class="text-uppercase fw-bold text-muted" style="font-size: 0.725rem; letter-spacing: 0.5px;">Doanh số hôm nay</span>
                            <h3 class="fw-bold mb-0 mt-1 font-monospace text-dark fs-4" id="kpiTodayRevenue">0₫</h3>
                        </div>
                        <div class="kpi-icon-wrap primary">
                            <i class="fa-solid fa-coins"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top border-light">
                        <small class="text-muted"><i class="fa-regular fa-calendar-check me-1"></i>Phát sinh hôm nay</small>
                        <span class="badge bg-light text-secondary border" style="font-size: 0.7rem;">Hôm nay</span>
                    </div>
                </div>
            </div>

            <!-- 2. Đơn chờ xử lý -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="kpi-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <span class="text-uppercase fw-bold text-muted" style="font-size: 0.725rem; letter-spacing: 0.5px;">Đơn chờ xử lý</span>
                            <h3 class="fw-bold mb-0 mt-1 font-monospace text-warning-emphasis fs-4" id="kpiPendingOrders">0</h3>
                        </div>
                        <div class="kpi-icon-wrap warning">
                            <i class="fa-solid fa-clock"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top border-light">
                        <small class="text-danger fw-semibold"><i class="fa-solid fa-circle-exclamation me-1"></i>Cần duyệt gấp</small>
                        <a href="/admin/orders" class="text-decoration-none small text-fuu-primary fw-semibold">Xử lý ngay &rarr;</a>
                    </div>
                </div>
            </div>

            <!-- 3. Đơn đã hoàn tất -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="kpi-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <span class="text-uppercase fw-bold text-muted" style="font-size: 0.725rem; letter-spacing: 0.5px;">Đơn hoàn tất</span>
                            <h3 class="fw-bold mb-0 mt-1 font-monospace text-success fs-4" id="kpiCompletedOrders">0</h3>
                        </div>
                        <div class="kpi-icon-wrap success">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top border-light">
                        <small class="text-muted">Tổng: <strong class="text-dark font-monospace" id="kpiTotalOrders">0</strong> đơn</small>
                        <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size: 0.7rem;">Đã giao</span>
                    </div>
                </div>
            </div>

            <!-- 4. Doanh thu tháng này -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="kpi-card">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <span class="text-uppercase fw-bold text-muted" style="font-size: 0.725rem; letter-spacing: 0.5px;" id="currentMonthLabel">Doanh thu tháng này</span>
                            <h3 class="fw-bold mb-0 mt-1 font-monospace text-fuu-primary fs-4" id="kpiMonthRevenue">0₫</h3>
                        </div>
                        <div class="kpi-icon-wrap primary">
                            <i class="fa-solid fa-sack-dollar"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between pt-2 border-top border-light">
                        <small class="text-muted">Lũy kế: <strong class="text-dark font-monospace" id="kpiTotalRevenue">0₫</strong></small>
                        <span class="badge bg-light text-dark border" style="font-size: 0.7rem;">Toàn shop</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Dải chỉ số phụ hệ thống (Không dùng block ảo) -->
        <div class="pt-3 mt-3 border-top d-flex flex-wrap gap-4 small">
            <span class="text-muted">
                <i class="fa-solid fa-box-archive text-secondary me-1"></i>Sản phẩm đang bán:
                <strong class="text-dark font-monospace" id="summaryTotalProducts">0</strong>
            </span>
            <span class="text-muted">
                <i class="fa-solid fa-users text-secondary me-1"></i>Khách hàng đã đăng ký:
                <strong class="text-dark font-monospace" id="summaryTotalCustomers">0</strong>
            </span>
            <span class="text-muted">
                <i class="fa-solid fa-rotate-left text-secondary me-1"></i>Yêu cầu hoàn tiền chờ duyệt:
                <strong class="text-danger font-monospace" id="summaryPendingRefunds">0</strong>
            </span>
        </div>
    </div>

    <!-- =================================================================== -->
    <!-- HÀNG 2: BIỂU ĐỒ DOANH THU 7 NGÀY (8 COLS) & TRUY CẬP NHANH (4 COLS) -->
    <!-- =================================================================== -->
    <div class="row g-3 mb-4">
        <!-- Cột 8: Biểu đồ doanh thu 7 ngày -->
        <div class="col-12 col-lg-8">
            <div class="admin-card h-100 p-4">
                <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                    <div>
                        <h5 class="fw-bold mb-1 text-dark fs-6">
                            <i class="fa-solid fa-chart-column text-fuu-primary me-2"></i>Xu hướng doanh thu 7 ngày qua
                        </h5>
                        <p class="text-muted small mb-0">Biểu đồ tổng hợp doanh thu và đơn hàng thực tế từng ngày</p>
                    </div>
                    <span class="badge-realtime">
                        <i class="fa-solid fa-bolt me-1"></i>Thời gian thực
                    </span>
                </div>

                <div style="height: 290px; position: relative;">
                    <canvas id="revenueChart"></canvas>
                </div>

                <!-- Footer tóm tắt biểu đồ 7 ngày -->
                <div class="d-flex flex-wrap justify-content-between align-items-center pt-3 mt-3 border-top small text-muted">
                    <div>
                        Tổng doanh thu 7 ngày qua: <strong class="text-fuu-primary font-monospace fs-6 ms-1" id="chart7DayTotal">0₫</strong>
                    </div>
                    <div>
                        Tổng số đơn phát sinh: <strong class="text-dark font-monospace fs-6 ms-1" id="chart7DayOrders">0</strong> đơn
                    </div>
                </div>
            </div>
        </div>

        <!-- Cột 4: Lối tắt quản lý nhanh 6 phân hệ (Chuẩn dữ liệu có thật) -->
        <div class="col-12 col-lg-4">
            <div class="admin-card h-100 p-4">
                <div class="pb-3 mb-2 border-bottom">
                    <h5 class="fw-bold mb-1 text-dark fs-6">
                        <i class="fa-solid fa-compass text-fuu-primary me-2"></i>Truy cập nhanh phân hệ
                    </h5>
                    <p class="text-muted small mb-0">Điều hướng đến các module quản lý chính</p>
                </div>

                <div class="d-flex flex-column gap-2 mt-2">
                    <!-- 1. Quản lý đơn hàng -->
                    <a href="/admin/orders" class="text-decoration-none d-flex align-items-center justify-content-between p-2 px-3 rounded-2 border bg-light" style="transition: all 0.15s ease;">
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-fuu-primary fs-5"><i class="fa-solid fa-receipt"></i></span>
                            <div>
                                <div class="fw-semibold text-dark small">Quản lý đơn hàng</div>
                                <div class="text-muted" style="font-size: 0.725rem;">Duyệt & cập nhật trạng thái đơn</div>
                            </div>
                        </div>
                        <span class="badge bg-warning text-dark font-monospace" id="badgePendingOrders">0</span>
                    </a>

                    <!-- 2. Quản lý hoàn tiền -->
                    <a href="/admin/refunds" class="text-decoration-none d-flex align-items-center justify-content-between p-2 px-3 rounded-2 border bg-light" style="transition: all 0.15s ease;">
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-danger fs-5"><i class="fa-solid fa-rotate-left"></i></span>
                            <div>
                                <div class="fw-semibold text-dark small">Quản lý hoàn tiền</div>
                                <div class="text-muted" style="font-size: 0.725rem;">Xử lý yêu cầu hoàn tiền online</div>
                            </div>
                        </div>
                        <span class="badge bg-danger text-white font-monospace" id="badgePendingRefunds">0</span>
                    </a>

                    <!-- 3. Quản lý sản phẩm -->
                    <a href="/admin/products" class="text-decoration-none d-flex align-items-center justify-content-between p-2 px-3 rounded-2 border bg-light" style="transition: all 0.15s ease;">
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-secondary fs-5"><i class="fa-solid fa-box-archive"></i></span>
                            <div>
                                <div class="fw-semibold text-dark small">Quản lý sản phẩm</div>
                                <div class="text-muted" style="font-size: 0.725rem;">Kho đồ câu, máy &amp; cần</div>
                            </div>
                        </div>
                        <span class="badge bg-secondary font-monospace" id="badgeTotalProducts">0</span>
                    </a>

                    <!-- 4. Quản lý mã giảm giá -->
                    <a href="/admin/coupons" class="text-decoration-none d-flex align-items-center justify-content-between p-2 px-3 rounded-2 border bg-light" style="transition: all 0.15s ease;">
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-warning-emphasis fs-5"><i class="fa-solid fa-ticket"></i></span>
                            <div>
                                <div class="fw-semibold text-dark small">Quản lý mã giảm giá</div>
                                <div class="text-muted" style="font-size: 0.725rem;">Tạo voucher &amp; cấu hình khuyến mãi</div>
                            </div>
                        </div>
                        <span class="text-muted small">&rarr;</span>
                    </a>

                    <!-- 5. Kiểm duyệt đánh giá -->
                    <a href="/admin/reviews" class="text-decoration-none d-flex align-items-center justify-content-between p-2 px-3 rounded-2 border bg-light" style="transition: all 0.15s ease;">
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-warning fs-5"><i class="fa-solid fa-star"></i></span>
                            <div>
                                <div class="fw-semibold text-dark small">Kiểm duyệt đánh giá</div>
                                <div class="text-muted" style="font-size: 0.725rem;">Duyệt nhận xét người mua</div>
                            </div>
                        </div>
                        <span class="text-muted small">&rarr;</span>
                    </a>

                    <!-- 6. Quản lý khách hàng -->
                    <a href="/admin/users" class="text-decoration-none d-flex align-items-center justify-content-between p-2 px-3 rounded-2 border bg-light" style="transition: all 0.15s ease;">
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-primary fs-5"><i class="fa-solid fa-users"></i></span>
                            <div>
                                <div class="fw-semibold text-dark small">Quản lý khách hàng</div>
                                <div class="text-muted" style="font-size: 0.725rem;">Hồ sơ thành viên &amp; bảo mật</div>
                            </div>
                        </div>
                        <span class="text-muted small">&rarr;</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- =================================================================== -->
    <!-- HÀNG 3: BẢNG 5 ĐƠN HÀNG MỚI NHẤT (Có bộ Badge đồng bộ)              -->
    <!-- =================================================================== -->
    <div class="admin-card p-4">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 mb-3 border-bottom">
            <div>
                <h5 class="fw-bold mb-1 text-dark fs-6">
                    <i class="fa-solid fa-clock-rotate-left text-fuu-primary me-2"></i>Đơn hàng mới nhất cần chú ý
                </h5>
                <p class="text-muted small mb-0">Các giao dịch đặt hàng phát sinh gần đây nhất trên hệ thống</p>
            </div>
            <a href="/admin/orders" class="btn-view-all-orders">
                <i class="fa-solid fa-list-check me-1"></i> Xem tất cả đơn &rarr;
            </a>
        </div>

        <div class="table-responsive">
            <table class="table admin-table align-middle table-hover mb-0">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Tổng tiền</th>
                        <th>Phương thức</th>
                        <th>Thanh toán</th>
                        <th>Trạng thái đơn</th>
                        <th>Ngày đặt</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="recentOrdersBody">
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <div class="spinner-border spinner-border-sm text-fuu-primary me-2" role="status"></div>
                            Đang tải số liệu đơn hàng...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        let revenueChart = null;

        document.addEventListener("DOMContentLoaded", function () {
            loadDashboardData();
        });

        async function loadDashboardData() {
            try {
                const res = await fetch("/api/admin/dashboard/stats", {
                    method: "GET",
                    credentials: "include"
                });

                if (!res.ok) throw new Error("Không thể tải dữ liệu thống kê.");
                const data = await res.json();

                // Format tiền tệ VNĐ
                const formatVND = (num) => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(num || 0);

                // Điền KPI Hàng 1
                document.getElementById("kpiTodayRevenue").textContent = formatVND(data.todayRevenue);
                document.getElementById("kpiPendingOrders").textContent = (data.pendingOrders || 0).toLocaleString();
                document.getElementById("kpiCompletedOrders").textContent = (data.completedOrders || 0).toLocaleString();
                document.getElementById("kpiTotalOrders").textContent = (data.totalOrders || 0).toLocaleString();
                document.getElementById("kpiMonthRevenue").textContent = formatVND(data.monthRevenue);
                document.getElementById("kpiTotalRevenue").textContent = formatVND(data.totalRevenue);

                // Dải tóm tắt phụ
                document.getElementById("summaryTotalProducts").textContent = (data.totalProducts || 0).toLocaleString();
                document.getElementById("summaryTotalCustomers").textContent = (data.totalCustomers || 0).toLocaleString();
                document.getElementById("summaryPendingRefunds").textContent = (data.pendingRefunds || 0).toLocaleString();

                // Badge phân hệ
                document.getElementById("badgePendingOrders").textContent = data.pendingOrders || 0;
                document.getElementById("badgePendingRefunds").textContent = data.pendingRefunds || 0;
                document.getElementById("badgeTotalProducts").textContent = data.totalProducts || 0;

                // Cập nhật badge trên menu bên trái
                const menuOrderBadge = document.getElementById("badgePendingOrdersMenu");
                if (menuOrderBadge) {
                    if (data.pendingOrders > 0) {
                        menuOrderBadge.textContent = data.pendingOrders;
                        menuOrderBadge.classList.remove("d-none");
                    } else {
                        menuOrderBadge.classList.add("d-none");
                    }
                }

                const menuRefundBadge = document.getElementById("menuRefundPendingBadge");
                if (menuRefundBadge) {
                    if (data.pendingRefunds > 0) {
                        menuRefundBadge.textContent = data.pendingRefunds;
                        menuRefundBadge.classList.remove("d-none");
                    } else {
                        menuRefundBadge.classList.add("d-none");
                    }
                }

                // Tiêu đề tháng
                const currentMonth = new Date().getMonth() + 1;
                document.getElementById("currentMonthLabel").textContent = `Doanh thu tháng ${currentMonth}/${new Date().getFullYear()}`;

                // Vẽ biểu đồ 7 ngày
                renderRevenueChart(data.dailyRevenues || []);

                // Render bảng 5 đơn gần nhất
                renderRecentOrders(data.recentOrders || []);

            } catch (err) {
                console.error("Lỗi nạp dashboard:", err);
            }
        }

        // Vẽ biểu đồ xu hướng doanh thu 7 ngày (Tone màu xanh rêu #253f36 và vàng #f9bf29)
        function renderRevenueChart(dailyData) {
            const ctx = document.getElementById('revenueChart').getContext('2d');
            const labels = dailyData.map(d => d.date);
            const revenues = dailyData.map(d => d.revenue);
            const total7Days = revenues.reduce((a, b) => a + b, 0);
            const orders7Days = dailyData.reduce((sum, d) => sum + (d.orderCount || 0), 0);

            document.getElementById("chart7DayTotal").textContent = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(total7Days);
            document.getElementById("chart7DayOrders").textContent = orders7Days.toLocaleString();

            if (revenueChart) {
                revenueChart.destroy();
            }

            revenueChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Doanh thu (VNĐ)',
                        data: revenues,
                        borderColor: '#253f36',
                        backgroundColor: 'rgba(37, 63, 54, 0.08)',
                        borderWidth: 2.5,
                        fill: true,
                        tension: 0.35,
                        pointBackgroundColor: '#f9bf29',
                        pointBorderColor: '#253f36',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        pointHoverRadius: 7
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#1e293b',
                            padding: 10,
                            titleFont: { size: 12, weight: 'bold' },
                            bodyFont: { size: 12 },
                            callbacks: {
                                label: (context) => 'Doanh thu: ' + new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(context.parsed.y)
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                font: { size: 11 },
                                callback: (val) => val >= 1000000 ? (val / 1000000) + ' Tr' : (val >= 1000 ? (val / 1000) + ' k' : val)
                            },
                            grid: { color: 'rgba(0,0,0,0.06)' }
                        },
                        x: {
                            ticks: { font: { size: 11 } },
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        // Render 5 đơn hàng mới nhất với bộ Badge đồng bộ .fuu-status-badge
        function renderRecentOrders(orders) {
            const tbody = document.getElementById("recentOrdersBody");
            if (!orders || orders.length === 0) {
                tbody.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-4">Chưa có đơn hàng nào phát sinh gần đây.</td></tr>';
                return;
            }

            const formatVND = (num) => new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(num || 0);

            tbody.innerHTML = orders.map(o => {
                const statusBadge = renderStatusBadge(o.orderStatus);
                const payBadge = o.paymentStatus === 'Paid'
                    ? '<span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="fa-solid fa-check me-1"></i>Đã thanh toán</span>'
                    : '<span class="badge bg-light text-secondary border px-2 py-1"><i class="fa-regular fa-clock me-1"></i>Chưa thanh toán</span>';
                
                const createdDate = new Date(o.createdAt).toLocaleString('vi-VN', { dateStyle: 'short', timeStyle: 'short' });

                return `
                    <tr>
                        <td class="fw-bold font-monospace text-fuu-primary">#${escapeHtml(o.orderCode)}</td>
                        <td>
                            <div class="fw-semibold text-dark">${escapeHtml(o.receiverName || 'Khách vãng lai')}</div>
                        </td>
                        <td class="fw-bold font-monospace text-dark">${formatVND(o.finalAmount)}</td>
                        <td><span class="badge bg-light text-dark border">${escapeHtml(o.paymentMethod || 'COD')}</span></td>
                        <td>${payBadge}</td>
                        <td>${statusBadge}</td>
                        <td class="text-muted small">${createdDate}</td>
                        <td class="text-end">
                            <a href="/admin/orders/detail/${o.orderId}" class="btn-order-action">
                                Chi tiết <i class="fa-solid fa-chevron-right ms-1" style="font-size: 0.65rem;"></i>
                            </a>
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Định dạng trạng thái đơn hàng (Đồng bộ 100% với Customer Order Views)
        function renderStatusBadge(status) {
            const val = (status || "Pending").trim();
            const lower = val.toLowerCase();
            if (lower === "pending" || lower === "chờ xác nhận" || lower === "chờ xử lý") {
                return `<span class="fuu-status-badge status-pending"><i class="fa-solid fa-clock me-1"></i>Chờ xử lý</span>`;
            }
            if (lower === "confirmed" || lower === "đã xác nhận") {
                return `<span class="fuu-status-badge status-confirmed"><i class="fa-solid fa-spinner me-1"></i>Đã xác nhận</span>`;
            }
            if (lower === "processing" || lower === "đang chuẩn bị" || lower === "chờ lấy hàng") {
                return `<span class="fuu-status-badge status-processing"><i class="fa-solid fa-box me-1"></i>Chờ lấy hàng</span>`;
            }
            if (lower === "shipped" || lower === "đang giao" || lower === "đang vận chuyển") {
                return `<span class="fuu-status-badge status-shipped"><i class="fa-solid fa-truck-fast me-1"></i>Đang vận chuyển</span>`;
            }
            if (lower === "completed" || lower === "delivered" || lower === "đã giao" || lower === "hoàn thành") {
                return `<span class="fuu-status-badge status-completed"><i class="fa-solid fa-circle-check me-1"></i>Hoàn thành</span>`;
            }
            if (lower === "cancelled" || lower === "đã hủy" || lower === "hủy") {
                return `<span class="fuu-status-badge status-cancelled"><i class="fa-solid fa-ban me-1"></i>Đã hủy</span>`;
            }
            return `<span class="fuu-status-badge status-default">${escapeHtml(val)}</span>`;
        }

        function escapeHtml(str) {
            if (!str) return "";
            return str.replace(/[&<>'"]/g, tag => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                "'": '&#39;',
                '"': '&quot;'
            }[tag] || tag));
        }
    </script>
}
