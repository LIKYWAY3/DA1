@{
    var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
}

<div class="admin-menu">
    <div class="admin-brand">
        <div class="admin-brand-icon">
            <i class="fa-solid fa-fish-fins"></i>
        </div>

        <div>
            <div class="admin-brand-title">Fuu Fishing<span class="brand-dot">.</span></div>
            <span class="admin-brand-subtitle">Trang quản trị</span>
        </div>
    </div>

    <div class="admin-menu-label">
        Menu Quản Trị
    </div>

    <ul class="admin-menu-list">
        <li>
            <a class="admin-menu-link @(currentPath == "/admin" || currentPath == "/admin/" ? "active" : "")"
               href="/admin">
                <span class="admin-menu-icon"><i class="fa-solid fa-chart-pie"></i></span>
                Dashboard
            </a>
        </li>

        <li>
            <a class="admin-menu-link @(currentPath.StartsWith("/admin/orders") ? "active" : "") d-flex align-items-center justify-content-between"
               href="/admin/orders">
                <div class="d-inline-flex align-items-center gap-2">
                    <span class="admin-menu-icon"><i class="fa-solid fa-receipt"></i></span>
                    Quản lý đơn hàng
                </div>
                <span id="badgePendingOrdersMenu" class="badge bg-warning text-dark rounded-pill d-none" style="font-size: 0.7rem; padding: 2px 7px;">0</span>
            </a>
        </li>

        <li>
            <a class="admin-menu-link @(currentPath.StartsWith("/admin/refunds") ? "active" : "") d-flex align-items-center justify-content-between"
               href="/admin/refunds">
                <div class="d-inline-flex align-items-center gap-2">
                    <span class="admin-menu-icon"><i class="fa-solid fa-rotate-left"></i></span>
                    Quản lý hoàn tiền
                </div>
                <span id="menuRefundPendingBadge" class="badge bg-danger text-white rounded-pill d-none" style="font-size: 0.7rem; padding: 2px 7px;">0</span>
            </a>
        </li>

        <li>
            <a class="admin-menu-link @(currentPath.StartsWith("/admin/products") ? "active" : "")"
               href="/admin/products">
                <span class="admin-menu-icon"><i class="fa-solid fa-box-archive"></i></span>
                Quản lý sản phẩm
            </a>
        </li>

        <li>
            <a class="admin-menu-link @(currentPath.StartsWith("/admin/categories") ? "active" : "")"
               href="/admin/categories">
                <span class="admin-menu-icon"><i class="fa-solid fa-folder-tree"></i></span>
                Quản lý danh mục
            </a>
        </li>

        <li>
            <a class="admin-menu-link @(currentPath.StartsWith("/admin/coupons") ? "active" : "")"
               href="/admin/coupons">
                <span class="admin-menu-icon"><i class="fa-solid fa-ticket"></i></span>
                Quản lý mã giảm giá
            </a>
        </li>

        <li>
            <a class="admin-menu-link @(currentPath.StartsWith("/admin/reviews") ? "active" : "")"
               href="/admin/reviews">
                <span class="admin-menu-icon"><i class="fa-solid fa-star"></i></span>
                Kiểm duyệt đánh giá
            </a>
        </li>

        <li>
            <a class="admin-menu-link @(currentPath.StartsWith("/admin/users") ? "active" : "")"
               href="/admin/users">
                <span class="admin-menu-icon"><i class="fa-solid fa-users"></i></span>
                Quản lý khách hàng
            </a>
        </li>
    </ul>

    <div class="admin-menu-footer">
        <form action="/admin/logout" method="post">
            @Html.AntiForgeryToken()

            <button type="submit" class="admin-logout-btn">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                Đăng xuất
            </button>
        </form>
    </div>
</div>
