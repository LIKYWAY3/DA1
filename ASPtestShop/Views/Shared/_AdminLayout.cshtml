<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Fuu Fishing Admin</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>

<body>
    <div class="admin-wrapper">
        <aside class="admin-sidebar">
            @await Html.PartialAsync("_AdminMenu")
        </aside>

        <section class="admin-content">
            <div class="admin-topbar">
                <div>
                    <h1 class="admin-page-title">
                        @ViewData["Title"]
                    </h1>
                    <p class="admin-page-subtitle">
                        Quản lý dữ liệu hệ thống Fuu Fishing
                    </p>
                </div>

                <div class="admin-topbar-badge">
                    Fuu Fishing Admin
                </div>
            </div>

            <main class="admin-main">
                @RenderBody()
            </main>
        </section>
    </div>

    <div id="adminToastContainer" style="position: fixed; top: 20px; right: 20px; z-index: 9999; max-width: 380px; width: 100%; display: flex; flex-direction: column; gap: 10px;"></div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/security-guard.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script>
        (function () {
            // Web Audio Synthesizer: Chuông "Ting Ting" thông báo thanh thoát không cần file mp3
            function playChime() {
                try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    const now = ctx.currentTime;

                    const osc1 = ctx.createOscillator();
                    const gain1 = ctx.createGain();
                    osc1.type = 'sine';
                    osc1.frequency.setValueAtTime(1318.51, now);
                    gain1.gain.setValueAtTime(0.3, now);
                    gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.35);
                    osc1.connect(gain1);
                    gain1.connect(ctx.destination);
                    osc1.start(now);
                    osc1.stop(now + 0.35);

                    const osc2 = ctx.createOscillator();
                    const gain2 = ctx.createGain();
                    osc2.type = 'sine';
                    osc2.frequency.setValueAtTime(1661.22, now + 0.15);
                    gain2.gain.setValueAtTime(0.4, now + 0.15);
                    gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.6);
                    osc2.connect(gain2);
                    gain2.connect(ctx.destination);
                    osc2.start(now + 0.15);
                    osc2.stop(now + 0.6);
                } catch (e) {
                    console.log("Audio notify error:", e);
                }
            }

            function showOrderToast(order) {
                playChime();
                const container = document.getElementById("adminToastContainer");
                if (!container) return;

                const toast = document.createElement("div");
                toast.className = "toast show shadow-lg border-0";
                toast.style.cssText = "background: #ffffff; border-radius: 12px; overflow: hidden; border-left: 5px solid #28a745 !important; margin-bottom: 8px;";

                const formattedPrice = new Intl.NumberFormat("vi-VN", { style: "currency", currency: "VND" }).format(order.finalAmount || 0);

                toast.innerHTML = `
                    <div class="toast-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="fa fa-bell text-success me-2 fs-5"></i>
                            <strong class="text-success me-auto">ĐƠN HÀNG MỚI!</strong>
                        </div>
                        <small class="text-muted">${order.createdAt || "Vừa xong"}</small>
                        <button type="button" class="btn-close ms-2" onclick="this.closest('.toast').remove()"></button>
                    </div>
                    <div class="toast-body px-3 pb-3">
                        <p class="mb-1 text-dark"><strong>Mã đơn:</strong> <span class="badge bg-light text-dark border">${order.orderCode}</span></p>
                        <p class="mb-1 text-dark"><strong>Khách hàng:</strong> ${order.receiverName}</p>
                        <p class="mb-2 text-danger"><strong>Tổng tiền:</strong> <strong class="fs-6">${formattedPrice}</strong> (${order.paymentMethod})</p>
                        <a href="/AdminOrder" class="btn btn-sm btn-success w-100 py-1" style="border-radius: 8px;">Xem danh sách đơn</a>
                    </div>
                `;

                container.prepend(toast);

                setTimeout(() => {
                    if (toast.parentElement) {
                        toast.style.transition = "opacity 0.5s ease, transform 0.5s ease";
                        toast.style.opacity = "0";
                        toast.style.transform = "translateX(50px)";
                        setTimeout(() => toast.remove(), 500);
                    }
                }, 12000);
            }

            try {
                if (typeof signalR !== "undefined") {
                    const connection = new signalR.HubConnectionBuilder()
                        .withUrl("/hubs/order")
                        .withAutomaticReconnect([0, 2000, 5000, 10000])
                        .build();

                    connection.on("NewOrderReceived", function (order) {
                        console.log("[SignalR] Nhận đơn hàng mới:", order);
                        showOrderToast(order);
                    });

                    connection.start().then(function () {
                        console.log("[SignalR] Đã kết nối thành công tới OrderHub.");
                        connection.invoke("JoinAdminGroup").catch(err => console.error("JoinAdminGroup err:", err));
                    }).catch(function (err) {
                        console.error("[SignalR] Lỗi kết nối OrderHub:", err);
                    });
                }
            } catch (err) {
                console.error("SignalR Init Error:", err);
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            (function() {
                let sessionTerminated = false;
                let isChecking = false;

                                async function verifyActiveSession() {
                    if (sessionTerminated || isChecking) return;
                    isChecking = true;

                    try {
                        const res = await fetch("/api/auth/check-session", {
                            method: "GET",
                            credentials: "include",
                            headers: { "Accept": "application/json" }
                        });

                        if (res.ok) {
                            const data = await res.json();
                            if (data) {
                                if (data.reason === "account_locked") {
                                    sessionTerminated = true;
                                    window.location.href = "/account/login?accountLocked=true";
                                } else if (data.reason === "session_expired") {
                                    sessionTerminated = true;
                                    window.location.href = "/account/login?sessionExpired=true";
                                } else if (!data.isAuthenticated) {
                                    sessionTerminated = true;
                                    window.location.href = "/account/login";
                                }
                            }
                        } else if (res.status === 401) {
                            sessionTerminated = true;
                            const reason = res.headers.get("X-Logout-Reason");
                            if (reason === "account_locked") {
                                window.location.href = "/account/login?accountLocked=true";
                            } else if (reason === "session_expired") {
                                window.location.href = "/account/login?sessionExpired=true";
                            } else {
                                window.location.href = "/account/login";
                            }
                        }
                    } catch (e) {
                    } finally {
                        isChecking = false;
                    }
                }

                try {
                    const bc = new BroadcastChannel("fuu_auth_channel");
                    bc.onmessage = function(e) {
                        if (e.data === "account_locked") {
                            sessionTerminated = true;
                            window.location.href = "/account/login?accountLocked=true";
                        } else if (e.data === "session_expired" || e.data === "new_login") {
                            sessionTerminated = true;
                            window.location.href = "/account/login?sessionExpired=true";
                        }
                    };
                } catch(e) {}

                setInterval(verifyActiveSession, 2000);
                window.addEventListener("focus", verifyActiveSession);

                async function updateRefundBadge() {
                    try {
                        const res = await fetch("/api/refunds/admin/pending-count", { credentials: "include" });
                        if (res.ok) {
                            const data = await res.json();
                            const badge = document.getElementById("menuRefundPendingBadge");
                            if (badge) {
                                if (data && data.count > 0) {
                                    badge.textContent = data.count;
                                    badge.classList.remove("d-none");
                                } else {
                                    badge.classList.add("d-none");
                                }
                            }
                        }
                    } catch(e) {}
                }
                updateRefundBadge();
                document.addEventListener("visibilitychange", function() {
                    if (document.visibilityState === "visible") {
                        verifyActiveSession();
                    }
                });
            })();
        </script>
    }
</body>
</html>
