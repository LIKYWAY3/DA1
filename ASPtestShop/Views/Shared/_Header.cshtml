

<!-- Start Header/Navigation -->
<style>
	/* Nút dropdown trên navbar */
	.shop-category-dropdown {
		color: #ffffff !important;
	}

		.shop-category-dropdown:hover,
		.shop-category-dropdown:focus {
			color: #f9bf29 !important;
		}

	/* Khung dropdown */
	.shop-category-dropdown-menu.dropdown-menu {
		background-color: #121617 !important;
		border: 1px solid #f9bf29 !important;
		min-width: 190px !important;
		padding: 8px 0 !important;
	}

	/* Chữ item trong dropdown */
	.shop-category-dropdown-menu .dropdown-item {
		color: #ffffff !important;
		background-color: transparent !important;
		padding: 10px 18px !important;
		font-weight: 500 !important;
	}

		.shop-category-dropdown-menu .dropdown-item:hover,
		.shop-category-dropdown-menu .dropdown-item:focus {
			color: #000000 !important;
			background-color: #f9bf29 !important;
		}

		.shop-category-dropdown-menu .dropdown-item.disabled {
			color: #cccccc !important;
		}

	.custom-navbar-nav .nav-item.dropdown:hover > .dropdown-menu {
		display: block;
		margin-top: 0;
	}

	.custom-navbar-nav .nav-item.dropdown:hover > .nav-link {
		color: #f9bf29 !important;
	}
	.custom-navbar-cta .dropdown-menu {
		padding: 0 !important;
		margin: 0 !important;
		overflow: hidden !important;
	}

		.custom-navbar-cta .dropdown-menu li {
			margin: 0 !important;
			padding: 0 !important;
		}

	.custom-navbar-cta .dropdown-item {
		padding: 12px 20px !important; 
		margin: 0 !important;
		border-radius: 0 !important; 
	}

	.custom-navbar-nav .nav-item.active .dropdown-menu a::before,
	.custom-navbar-nav .nav-item.active .dropdown-menu a::after {
		display: none !important;
	}

	.shop-category-dropdown-menu .dropdown-item.active {
		color: #000000 !important;
		background-color: #f9bf29 !important;
		font-weight: bold !important;
	}
</style>

<nav class="custom-navbar navbar navbar-expand-md navbar-dark bg-dark" aria-label="Fuu Fishing navigation bar">
	<div class="container">
		<a class="navbar-brand" asp-controller="Home" asp-action="Index">Fuu Fishing<span>.</span></a>

		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarsFurni"
				aria-controls="navbarsFurni" aria-expanded="false" aria-label="Toggle navigation">
			<span class="navbar-toggler-icon"></span>
		</button>

		<div class="collapse navbar-collapse" id="navbarsFurni">
			<ul class="custom-navbar-nav navbar-nav ms-auto mb-2 mb-md-0" id="mainNavbarNav">
				<li class="nav-item">
					<a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
				</li>

				<!-- Danh mục cha và con sẽ được nạp động từ API /api/categories -->

				<li class="nav-item" id="navShopAllItem">
					<a class="nav-link"
					   asp-controller="Shop"
					   asp-action="Index">
						Shop
					</a>
				</li>
			</ul>

			<ul class="custom-navbar-cta navbar-nav mb-2 mb-md-0 ms-5">
				@if (User.Identity != null && User.Identity.IsAuthenticated)
				{
					<li class="nav-item dropdown">
						<a class="nav-link dropdown-toggle"
						   href="#"
						   role="button"
						   data-bs-toggle="dropdown"
						   aria-expanded="false">
							@User.Identity.Name
						</a>

						<ul class="dropdown-menu dropdown-menu-end">
							<li>
								<a class="dropdown-item" href="/account/profile">
									Tài khoản của tôi
								</a>
							</li>
							<li>
								<a class="dropdown-item" href="/orders/history">
									Lịch sử đơn hàng
								</a>
							</li>
							<li>
								<a class="dropdown-item" href="/account/logout">
									Đăng xuất
								</a>
							</li>
						</ul>
					</li>
				}
				else
				{
					<li class="nav-item dropdown">
						<a class="nav-link dropdown-toggle"
						   href="#"
						   role="button"
						   data-bs-toggle="dropdown"
						   aria-expanded="false">
							<img src="/images/user.svg" alt="User">
						</a>

						<ul class="dropdown-menu dropdown-menu-end">
							<li>
								<a class="dropdown-item" href="/account/login">
									Đăng nhập
								</a>
							</li>

							<li>
								<a class="dropdown-item" href="/account/register">
									Đăng ký
								</a>
							</li>
						</ul>
					</li>
				}

				<li><a class="nav-link" asp-controller="Cart" asp-action="Index"><img src="/images/cart.svg" alt="Giỏ hàng"></a></li>
			</ul>
		</div>
	</div>
</nav>

<script>
	document.addEventListener("DOMContentLoaded", async function () {
		await loadNavbarCategories();
		setActiveNav();
	});
	//thêm hàm setActiveNav
	function setActiveNav() {
		const currentUrl = new URL(window.location.href);
		const currentPath = currentUrl.pathname.toLowerCase();
		const currentCatId = currentUrl.searchParams.get('categoryId');
		
		const navItems = document.querySelectorAll('.custom-navbar-nav .nav-item');
		const dropdownItems = document.querySelectorAll('.custom-navbar-nav .dropdown-item');
		
		// 1. Dọn dẹp sạch sẽ màu vàng cũ ở cả menu cha và menu con
		navItems.forEach(item => item.classList.remove('active'));
		dropdownItems.forEach(item => item.classList.remove('active'));

		let isMatched = false;

		if (currentPath === '/' || currentPath === '/home') {
			navItems[0].classList.add('active');
			isMatched = true;
		} 
		else if (currentPath === '/shop') {
			if (!currentCatId) {
				const topLinks = document.querySelectorAll('.custom-navbar-nav > li > a.nav-link');
				topLinks.forEach(link => {
					if (link.textContent.trim().toLowerCase() === 'shop') {
						link.closest('.nav-item').classList.add('active');
						isMatched = true;
					}
				});
			} 
			else {
				const allLinks = document.querySelectorAll('.custom-navbar-nav a');
				for (const link of allLinks) {
					const linkHref = link.getAttribute('href');
					if (linkHref) {
						try {
							const parsedLink = new URL(linkHref, window.location.origin);
							if (parsedLink.pathname.toLowerCase() === '/shop' && 
								parsedLink.searchParams.get('categoryId') === currentCatId) {
								
								link.closest('.nav-item').classList.add('active');
								
								if (link.classList.contains('dropdown-item')) {
									link.classList.add('active');
								}
								
								isMatched = true;
							}
						} catch(e) {}
					}
				}
			}
		}

		if (!isMatched) {
			navItems[0].classList.add('active');
		}
	}
	
	async function loadNavbarCategories() {
		try {
			const response = await fetch("/api/categories");

			if (!response.ok) {
				console.log("Không lấy được category");
				return;
			}

			const categories = await response.json();
			renderDynamicNavbarCategories(categories);

		} catch (error) {
			console.error("Lỗi load navbar categories:", error);
		}
	}

	function renderDynamicNavbarCategories(categories) {
		const navBar = document.getElementById("mainNavbarNav");
		if (!navBar) return;

		// Xóa các danh mục cũ nếu đã có (giữ Home đầu và Shop cuối)
		const existingCatItems = navBar.querySelectorAll('.nav-item-category');
		existingCatItems.forEach(el => el.remove());

		const shopItem = document.getElementById("navShopAllItem");

		const activeCats = categories.filter(c => c.isActive);
		const rootCats = activeCats.filter(c => !c.parentCategoryId);

		rootCats.forEach(root => {
			const children = activeCats.filter(c => c.parentCategoryId === root.categoryId);

			const li = document.createElement("li");
			li.className = "nav-item dropdown nav-item-category";
			li.dataset.categoryId = root.categoryId;

			let dropdownMenuHtml = `
				<ul class="dropdown-menu shop-category-dropdown-menu" aria-labelledby="catDropdown_${root.categoryId}">
					<li>
						<a class="dropdown-item fw-bold" href="/Shop?categoryId=${root.categoryId}#products" style="color: #f9bf29 !important; border-bottom: 1px solid rgba(249,191,41,0.2);">
							Tất cả ${root.categoryName}
						</a>
					</li>
			`;

			if (children.length === 0) {
				dropdownMenuHtml += `
					<li>
						<span class="dropdown-item disabled">Chưa có danh mục con</span>
					</li>
				`;
			} else {
				children.forEach(child => {
					dropdownMenuHtml += `
						<li>
							<a class="dropdown-item" href="/Shop?categoryId=${child.categoryId}#products">
								${child.categoryName}
							</a>
						</li>
					`;
				});
			}

			dropdownMenuHtml += `</ul>`;

			li.innerHTML = `
				<a class="nav-link dropdown-toggle shop-category-dropdown"
				   href="/Shop?categoryId=${root.categoryId}#products"
				   id="catDropdown_${root.categoryId}">
					${root.categoryName}
				</a>
				${dropdownMenuHtml}
			`;

			if (shopItem) {
				navBar.insertBefore(li, shopItem);
			} else {
				navBar.appendChild(li);
			}
		});

		setActiveNav();
	}
</script>
<!-- End Header/Navigation -->