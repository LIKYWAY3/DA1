<!DOCTYPE html>

<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<meta name="author" content="Untree.co">
	<link rel="shortcut icon" href="~/favicon.png">

	<meta name="description" content="" />
	<meta name="keywords" content="bootstrap, bootstrap4" />

	<!-- Bootstrap CSS -->
	<link href="~/css/bootstrap.min.css" rel="stylesheet">	
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
	<link href="~/css/tiny-slider.css" rel="stylesheet">
	<link href="~/css/style.css" rel="stylesheet">
	<link href="~/css/skeleton.css" rel="stylesheet">
	<title>Fuu Fishing</title>
	@await RenderSectionAsync("Styles", required: false)
</head>
<body>
	<!-- Start Header/Navigation -->
	<partial name="_Header" />
	<!-- End Header/Navigation -->
    <div>
        @RenderBody()
    </div>
	@await Html.PartialAsync("_Footer")
	@await RenderSectionAsync("Scripts", required: false)
	<script src="~/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/tiny-slider.js"></script>
	<script src="~/js/custom.js"></script>
	<script src="~/js/security-guard.min.js"></script>

	@if (User.Identity?.IsAuthenticated == true)
	{
		<script>
			(function() {
				let sessionTerminated = false;
				let isChecking = false;

								async function verifyActiveSession() {
					if (sessionTerminated || isChecking) return;
					isChecking = true;

					try {
						const res = await fetch("/api/auth/check-session", {
							method: "GET",
							credentials: "include",
							headers: { "Accept": "application/json" }
						});

						if (res.ok) {
							const data = await res.json();
							if (data) {
								if (data.reason === "account_locked") {
									sessionTerminated = true;
									window.location.href = "/account/login?accountLocked=true";
								} else if (data.reason === "session_expired") {
									sessionTerminated = true;
									window.location.href = "/account/login?sessionExpired=true";
								}
							}
						} else if (res.status === 401) {
							sessionTerminated = true;
							const reason = res.headers.get("X-Logout-Reason");
							if (reason === "account_locked") {
								window.location.href = "/account/login?accountLocked=true";
							} else if (reason === "session_expired") {
								window.location.href = "/account/login?sessionExpired=true";
							}
						}
					} catch (e) {
						// Bỏ qua lỗi mạng chập chờn
					} finally {
						isChecking = false;
					}
				}

				try {
					const bc = new BroadcastChannel("fuu_auth_channel");
					bc.onmessage = function(e) {
						if (e.data === "account_locked") {
							sessionTerminated = true;
							window.location.href = "/account/login?accountLocked=true";
						} else if (e.data === "session_expired" || e.data === "new_login") {
							sessionTerminated = true;
							window.location.href = "/account/login?sessionExpired=true";
						}
					};
				} catch(e) {}

				// Kiểm tra định kỳ mỗi 2 giây để phản hồi nhanh nhất
				setInterval(verifyActiveSession, 2000);

				// Kiểm tra tức thì khi chuyển tab hoặc focus trình duyệt
				window.addEventListener("focus", verifyActiveSession);
				document.addEventListener("visibilitychange", function() {
					if (document.visibilityState === "visible") {
						verifyActiveSession();
					}
				});
			})();
		</script>
	}
</body>
</html>

