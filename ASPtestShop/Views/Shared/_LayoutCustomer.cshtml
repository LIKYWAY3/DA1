<!DOCTYPE html>

<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<meta name="author" content="Untree.co">
	<link rel="shortcut icon" href="~/favicon.png">

	<meta name="description" content="" />
	<meta name="keywords" content="bootstrap, bootstrap4" />

	<!-- Bootstrap CSS -->
	<link href="~/css/bootstrap.min.css" rel="stylesheet">	
	<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
	<link href="~/css/tiny-slider.css" rel="stylesheet">
	<link href="~/css/style.css" rel="stylesheet">
	<title>Fuu Fishing</title>
	@await RenderSectionAsync("Styles", required: false)
</head>
<body>
	<!-- Start Header/Navigation -->
	<partial name="_Header" />
	<!-- End Header/Navigation -->
    <div>
        @RenderBody()
    </div>
	@await Html.PartialAsync("_Footer")
	@await RenderSectionAsync("Scripts", required: false)
	<script src="~/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/tiny-slider.js"></script>
	<script src="~/js/custom.js"></script>

	@if (User.Identity?.IsAuthenticated == true)
	{
		<script>
			(function() {
				let sessionTerminated = false;
				let isChecking = false;

				async function verifyActiveSession() {
					if (sessionTerminated || isChecking) return;
					isChecking = true;

					try {
						const res = await fetch("/api/auth/check-session", {
							method: "GET",
							credentials: "include",
							headers: { "Accept": "application/json" }
						});

						if (res.ok) {
							const data = await res.json();
							if (data && (!data.valid || data.reason === "session_expired")) {
								sessionTerminated = true;
								alert("Tài khoản của bạn đã được đăng nhập từ một thiết bị khác!\nPhiên làm việc trên thiết bị này sẽ được tự động đăng xuất để bảo mật.");
								window.location.href = "/account/login?sessionExpired=true";
							}
						} else if (res.status === 401) {
							sessionTerminated = true;
							window.location.href = "/account/login?sessionExpired=true";
						}
					} catch (e) {
						// Bỏ qua lỗi mạng chập chờn
					} finally {
						isChecking = false;
					}
				}

				// Kiểm tra định kỳ mỗi 5 giây
				setInterval(verifyActiveSession, 5000);

				// Kiểm tra tức thì khi chuyển tab hoặc focus trình duyệt
				window.addEventListener("focus", verifyActiveSession);
				document.addEventListener("visibilitychange", function() {
					if (document.visibilityState === "visible") {
						verifyActiveSession();
					}
				});
			})();
		</script>
	}
</body>
</html>
