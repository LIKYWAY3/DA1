@model ASPtestShop.Models.ViewModels.Auth.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu - FuuFishing";
}

<style>
    /* Ẩn hình cần câu lớn ở footer để không va chạm vào form */
    .footer-section .sofa-img {
        display: none !important;
    }

    .reset-page-container {
        min-height: calc(100vh - 460px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 16px 90px 16px;
    }

    .reset-wrapper {
        width: 100%;
        max-width: 440px;
        margin: 0 auto;
    }

    .reset-title {
        color: #253f36;
        font-size: 1.85rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        text-align: center;
        margin-bottom: 8px;
    }

    .reset-desc {
        color: #6b7280;
        font-size: 0.95rem;
        text-align: center;
        margin-bottom: 28px;
        line-height: 1.5;
    }

    .custom-auth-label {
        font-size: 0.925rem;
        font-weight: 600;
        color: #121617;
        margin-bottom: 6px;
        display: block;
        text-align: left;
    }

    .custom-auth-input {
        width: 100%;
        border: 1px solid #2f2f2f;
        background-color: #ffffff;
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 0.95rem;
        color: #121617;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .custom-auth-input:focus {
        border-color: #253f36;
        outline: none;
        box-shadow: 0 0 0 2px rgba(37, 63, 54, 0.18);
        background-color: #ffffff;
    }

    .btn-auth-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 24px;
    }

    .btn-back-login {
        background-color: #ffffff;
        color: #121617;
        border: 1px solid #2f2f2f;
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, border-color 0.2s ease;
        white-space: nowrap;
    }

    .btn-back-login:hover {
        background-color: #f3f4f6;
        color: #121617;
        border-color: #121617;
    }

    .btn-auth-submit {
        background-color: #253f36;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.1s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
    }

    .btn-auth-submit:hover {
        background-color: #192b25;
        color: #ffffff;
    }

    .btn-auth-submit:active {
        transform: translateY(1px);
    }
</style>

<div class="reset-page-container">
    <div class="reset-wrapper">
        <h2 class="reset-title">Đặt lại mật khẩu</h2>
        <p class="reset-desc">Nhập mật khẩu mới cho tài khoản của bạn để hoàn tất quá trình khôi phục.</p>

        <form asp-action="ResetPassword" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="ResetToken" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small" style="border-radius: 8px;"></div>

            <div class="mb-3 text-start">
                <label asp-for="NewPassword" class="custom-auth-label">Mật khẩu mới</label>
                <div class="position-relative">
                    <input asp-for="NewPassword" type="password" class="custom-auth-input pe-5" id="resetNewPassword" placeholder="Nhập mật khẩu mới" autocomplete="new-password" />
                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted text-decoration-none pe-3 border-0 bg-transparent" onclick="togglePasswordVisibility('resetNewPassword', this)" title="Ẩn/hiện mật khẩu" tabindex="-1">
                        <i class="fa fa-eye text-secondary"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block text-start"></span>
            </div>

            <div class="mb-4 text-start">
                <label asp-for="ConfirmPassword" class="custom-auth-label">Nhập lại mật khẩu mới</label>
                <div class="position-relative">
                    <input asp-for="ConfirmPassword" type="password" class="custom-auth-input pe-5" id="resetConfirmPassword" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                    <button type="button" class="btn btn-link position-absolute end-0 top-50 translate-middle-y text-muted text-decoration-none pe-3 border-0 bg-transparent" onclick="togglePasswordVisibility('resetConfirmPassword', this)" title="Ẩn/hiện mật khẩu" tabindex="-1">
                        <i class="fa fa-eye text-secondary"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block text-start"></span>
            </div>

            <div class="btn-auth-actions">
                <a href="/account/login" class="btn-back-login">
                    <i class="fa fa-chevron-left me-2"></i>Quay lại đăng nhập
                </a>
                <button type="submit" class="btn-auth-submit">
                    Cập nhật mật khẩu
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePasswordVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            if (!input) return;
            const icon = btn.querySelector("i");
            if (input.type === "password") {
                input.type = "text";
                if (icon) {
                    icon.className = "fa fa-eye-slash text-secondary";
                }
            } else {
                input.type = "password";
                if (icon) {
                    icon.className = "fa fa-eye text-secondary";
                }
            }
        }
    </script>
}
