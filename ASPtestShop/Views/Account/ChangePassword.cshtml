@model ASPtestShop.Models.ViewModels.Profile.ChangePasswordViewModel

@{
    ViewData["Title"] = "Đổi Mật Khẩu - FuuFishing";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
}

<div class="profile-container py-4">
    <div class="container">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb small">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/Account/Profile" class="text-decoration-none text-muted">Tài khoản</a></li>
                <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Đổi mật khẩu</li>
            </ol>
        </nav>

        <div class="row justify-content-center">
            <div class="col-12 col-md-8 col-lg-6">
                
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
                        <i class="fa-solid fa-circle-check me-2"></i>@TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-3" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="card bg-white border rounded-3 p-4 shadow-sm">
                    <div class="d-flex align-items-center gap-2 pb-3 border-bottom mb-3">
                        <div class="bg-light p-2 rounded-circle border text-dark">
                            <i class="fa-solid fa-key"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-0 fs-6">Đổi Mật Khẩu</h5>
                            <div class="text-muted small">Để bảo mật tài khoản, vui lòng không chia sẻ mật khẩu cho người khác.</div>
                        </div>
                    </div>

                    <form asp-controller="Account" asp-action="ChangePassword" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold text-dark small">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                            <input asp-for="CurrentPassword" type="password" class="form-control fuu-control" placeholder="Nhập mật khẩu hiện tại..." required />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold text-dark small">Mật khẩu mới <span class="text-danger">*</span></label>
                            <input asp-for="NewPassword" type="password" class="form-control fuu-control" placeholder="Nhập mật khẩu mới (ít nhất 6 ký tự)..." required />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold text-dark small">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control fuu-control" placeholder="Nhập lại mật khẩu mới..." required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <a href="/Account/Profile" class="btn btn-outline-secondary w-50 py-2 fw-semibold">Quay lại Hồ sơ</a>
                            <button type="submit" class="btn btn-fuu-primary w-50 py-2 fw-semibold">Lưu thay đổi</button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    /* Ẩn cần câu trang trí footer gây che khuất */
    .footer-section .sofa-img {
        display: none !important;
    }
    .fuu-control {
        border: 1px solid #cbd5e1 !important;
        border-radius: 6px !important;
        padding: 9px 12px !important;
        font-size: 0.875rem !important;
    }
    .fuu-control:focus {
        border-color: #253f36 !important;
        box-shadow: 0 0 0 2px rgba(37, 63, 54, 0.15) !important;
    }
    .btn-fuu-primary {
        background-color: #253f36 !important;
        color: #fff !important;
        border: none !important;
        border-radius: 6px !important;
    }
    .btn-fuu-primary:hover {
        background-color: #1b2f28 !important;
        color: #fff !important;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
