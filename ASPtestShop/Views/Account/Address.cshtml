@model ASPtestShop.Models.ViewModels.Profile.UserProfileViewModel

@{
    ViewData["Title"] = "Địa Chỉ Của Tôi";
}

@section Styles {
    <style>
        .address-page-wrapper .btn-address-primary {
            background-color: #3b5d50;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            transition: 0.2s;
            font-weight: 500;
        }

        .address-page-wrapper .btn-address-primary:hover {
            background-color: #2c4c41;
            color: white;
        }

        .address-page-wrapper .badge-default {
            color: #3b5d50;
            border: 1px solid #3b5d50;
            padding: 2px 6px;
            font-size: 11px;
            border-radius: 3px;
            margin-top: 5px;
            display: inline-block;
            font-weight: 600;
        }

        .address-page-wrapper .action-link {
            color: #3b5d50;
            text-decoration: none;
            font-size: 14px;
            margin-left: 10px;
            cursor: pointer;
        }

        .address-page-wrapper .action-link:hover {
            text-decoration: underline;
            color: #2c4c41;
        }

        .address-page-wrapper .btn-set-default {
            background-color: white;
            border: 1px solid #ccc;
            color: #555;
            padding: 4px 12px;
            border-radius: 4px;
            font-size: 13px;
            margin-top: 10px;
        }

        .address-page-wrapper .btn-set-default:hover:not(:disabled) {
            background-color: #f8f9fa;
        }

        .address-page-wrapper .btn-set-default:disabled {
            border-color: #e8e8e8;
            color: #ccc;
            cursor: not-allowed;
        }

        .text-umi {
            color: #3b5d50 !important;
        }

        .avatar-50 {
            width: 50px;
            height: 50px;
            object-fit: cover;
        }

        .radius-2 {
            border-radius: 6px !important;
        }

        .text-title-md {
            font-size: 1.125rem;
        }

        .text-title-lg {
            font-size: 1.25rem;
        }

        .text-name {
            font-size: 16px;
        }

        .lh-15 {
            line-height: 1.5;
        }

        .checkbox-umi {
            accent-color: #3b5d50;
        }

        .btn-modal-cancel {
            padding: 8px 20px;
            border-radius: 4px;
        }

        .btn-modal-submit {
            padding: 8px 30px;
            border-radius: 4px;
        }

        .select-loading {
            position: relative;
            opacity: 0.6;
            pointer-events: none;
        }
    </style>
}

<div class="untree_co-section profile-page-container address-page-wrapper mb-5 mt-4">
    <div class="container">
        <div class="row">

            <div class="col-md-3">
                <div class="sidebar-user-info d-flex align-items-center mb-4">
                    @if (string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="https://ui-avatars.com/api/?name=@Model.UserName&background=3b5d50&color=fff" alt="Avatar" class="sidebar-avatar me-3 rounded-circle avatar-50" />
                    }
                    else
                    {
                        <img src="@Model.AvatarUrl" alt="Avatar" class="sidebar-avatar me-3 rounded-circle avatar-50" />
                    }
                    <div>
                        <h6 class="mb-0 fw-bold">@Model.UserName</h6>
                        <a href="/account/profile" class="text-muted small text-decoration-none edit-profile-link text-umi">
                            <i class="fa fa-pencil-alt me-1"></i> Sửa Hồ Sơ
                        </a>
                    </div>
                </div>

                <ul class="sidebar-menu list-unstyled">
                    <li class="menu-item active mb-2">
                        <a href="#" class="text-decoration-none text-dark fw-bold">
                            <i class="fa fa-user me-2 text-primary"></i> Tài Khoản Của Tôi
                        </a>
                        <ul class="sub-menu list-unstyled ms-4 mt-2">
                            <li><a asp-controller="Account" asp-action="Profile" class="text-muted">Hồ Sơ</a></li>
                            <li><a asp-controller="Account" asp-action="Bank" class="text-muted">Ngân Hàng</a></li>
                            <li><a asp-controller="Account" asp-action="Address" class="fw-bold text-umi">Địa Chỉ</a></li>
                            <li><a asp-controller="Account" asp-action="ChangePassword" class="text-muted">Đổi Mật Khẩu</a></li>
                        </ul>
                    </li>
                    <li class="menu-item mb-2 mt-3">
                        <a asp-controller="Order" asp-action="History" class="text-decoration-none text-dark">
                            <i class="fa fa-shopping-bag me-2 text-info"></i> Đơn Mua
                        </a>
                    </li>
                </ul>
            </div>

            <div class="col-md-9">
                <div class="profile-card card border-0 bg-white shadow-sm radius-2">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success m-4 mb-0 alert-dismissible fade show">
                            <i class="fa fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger m-4 mb-0 alert-dismissible fade show">
                            <i class="fa fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                            <div>
                                <h5 class="mb-1 fw-bold text-title-md">Địa chỉ nhận hàng</h5>
                                <p class="text-muted small mb-0">Quản lý danh sách địa chỉ nhận hàng của bạn</p>
                            </div>
                            <button class="btn-address-primary" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                                <i class="fas fa-plus me-1"></i> Thêm địa chỉ mới
                            </button>
                        </div>

                        <div class="address-list">
                            @{
                                var addressList = ViewBag.Addresses as List<ASPtestShop.Data.Entities.UserAddress>;
                            }

                            @if (addressList != null && addressList.Any())
                            {
                                foreach (var addr in addressList)
                                {
                                    <div class="row mb-3 pb-3 border-bottom align-items-start">
                                        <div class="col-md-8">
                                            <div class="d-flex align-items-center mb-1">
                                                <span class="fw-bold me-2 text-name">@addr.FullName</span>
                                                <span class="text-muted small border-start ps-2 border-secondary">@addr.PhoneNumber</span>
                                            </div>
                                            <div class="text-muted small mb-1 lh-15">
                                                <i class="fa fa-map-marker-alt text-danger me-1"></i> @addr.SpecificAddress
                                            </div>

                                            @if (addr.IsDefault)
                                            {
                                                <span class="badge-default"><i class="fa fa-check me-1"></i>Mặc định</span>
                                            }
                                        </div>

                                        <div class="col-md-4 text-end">
                                            <div class="mb-2">
                                                <a href="javascript:void(0)" onclick="openEditModal(@addr.Id, '@Html.Raw(JavaScriptEncoder.Default.Encode(addr.FullName))', '@Html.Raw(JavaScriptEncoder.Default.Encode(addr.PhoneNumber))', '@Html.Raw(JavaScriptEncoder.Default.Encode(addr.SpecificAddress))', @addr.IsDefault.ToString().ToLower())" class="action-link">
                                                    <i class="fa fa-edit me-1"></i>Cập nhật
                                                </a>

                                                @if (!addr.IsDefault)
                                                {
                                                    <form action="/account/delete-address/@addr.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa địa chỉ này?');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-link action-link text-danger p-0 border-0 bg-transparent">
                                                            <i class="fa fa-trash-alt me-1"></i>Xóa
                                                        </button>
                                                    </form>
                                                }
                                            </div>

                                            @if (!addr.IsDefault)
                                            {
                                                <form action="/account/set-default-address/@addr.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn-set-default">
                                                        Thiết lập mặc định
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-center py-5">
                                    <i class="fa fa-map-marked-alt text-muted fa-3x mb-3"></i>
                                    <div class="text-muted fs-6">Bạn chưa có địa chỉ nhận hàng nào.</div>
                                    <button class="btn btn-sm btn-outline-primary mt-3" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                                        <i class="fa fa-plus me-1"></i> Thêm địa chỉ đầu tiên
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- MODAL THÊM ĐỊA CHỈ MỚI VỚI DROPDOWN 3 CẤP -->
<div class="modal fade" id="addAddressModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 radius-2 shadow">
            <div class="modal-header bg-light pb-3">
                <h5 class="modal-title fw-bold text-title-lg"><i class="fa fa-map-marker-alt text-primary me-2"></i>Thêm địa chỉ mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/account/add-address" method="post" id="addAddressForm" onsubmit="return handleAddressSubmit(this)">
                @Html.AntiForgeryToken()
                <input type="hidden" name="SpecificAddress" id="addFinalSpecificAddress" />

                <div class="modal-body p-4">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Họ và tên người nhận <span class="text-danger">*</span></label>
                            <input type="text" name="FullName" class="form-control" required placeholder="Ví dụ: Nguyễn Văn A">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" name="PhoneNumber" class="form-control" required placeholder="Ví dụ: 0912345678" pattern="[0-9]{10,11}">
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                            <select id="addProvince" class="form-select" required onchange="onProvinceChange(this, 'addDistrict', 'addWard')">
                                <option value="">-- Chọn Tỉnh/TP --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Quận / Huyện <span class="text-danger">*</span></label>
                            <select id="addDistrict" class="form-select" required disabled onchange="onDistrictChange(this, 'addWard')">
                                <option value="">-- Chọn Quận/Huyện --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-semibold">Phường / Xã <span class="text-danger">*</span></label>
                            <select id="addWard" class="form-select" required disabled>
                                <option value="">-- Chọn Phường/Xã --</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Địa chỉ cụ thể (Số nhà, ngõ/ngách, tên đường) <span class="text-danger">*</span></label>
                        <input type="text" id="addStreet" class="form-control" required placeholder="Ví dụ: Số 25, ngõ 123, đường Cầu Giấy">
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input checkbox-umi" type="checkbox" name="IsDefault" value="true" id="addDefaultCheck">
                        <label class="form-check-label text-muted small" for="addDefaultCheck">
                            Đặt làm địa chỉ mặc định
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 pe-4">
                    <button type="button" class="btn btn-light btn-modal-cancel" data-bs-dismiss="modal">Trở lại</button>
                    <button type="submit" class="btn-address-primary btn-modal-submit">Hoàn thành</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL CẬP NHẬT ĐỊA CHỈ -->
<div class="modal fade" id="editAddressModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 radius-2 shadow">
            <div class="modal-header bg-light pb-3">
                <h5 class="modal-title fw-bold text-title-lg"><i class="fa fa-edit text-primary me-2"></i>Cập nhật địa chỉ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form action="/account/edit-address" method="post" id="editAddressForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" id="editId" />

                <div class="modal-body p-4">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" name="FullName" id="editFullName" class="form-control" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="tel" name="PhoneNumber" id="editPhone" class="form-control" required>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Địa chỉ chi tiết <span class="text-danger">*</span></label>
                        <textarea name="SpecificAddress" id="editSpecific" class="form-control" rows="3" required placeholder="Địa chỉ cụ thể..."></textarea>
                    </div>

                    <div class="form-check mb-2">
                        <input class="form-check-input checkbox-umi" type="checkbox" name="IsDefault" value="true" id="editIsDefault">
                        <label class="form-check-label text-muted small" for="editIsDefault">
                            Đặt làm địa chỉ mặc định
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 pb-4 pe-4">
                    <button type="button" class="btn btn-light btn-modal-cancel" data-bs-dismiss="modal">Trở lại</button>
                    <button type="submit" class="btn-address-primary btn-modal-submit">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@using System.Text.Encodings.Web

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            loadProvinces('addProvince');
        });

        async function loadProvinces(selectId) {
            const select = document.getElementById(selectId);
            if (!select) return;

            try {
                select.classList.add('select-loading');
                const res = await fetch('/api/location/provinces');
                if (!res.ok) throw new Error('Không thể tải tỉnh/thành');
                const data = await res.json();

                select.innerHTML = '<option value="">-- Chọn Tỉnh/Thành phố --</option>';
                data.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.code;
                    opt.dataset.name = p.name;
                    opt.textContent = p.name;
                    select.appendChild(opt);
                });
            } catch (err) {
                console.error(err);
                select.innerHTML = '<option value="">-- Lỗi tải dữ liệu --</option>';
            } finally {
                select.classList.remove('select-loading');
            }
        }

        async function onProvinceChange(provinceSelect, districtSelectId, wardSelectId) {
            const districtSelect = document.getElementById(districtSelectId);
            const wardSelect = document.getElementById(wardSelectId);

            districtSelect.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
            wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
            wardSelect.disabled = true;

            const provinceCode = provinceSelect.value;
            if (!provinceCode) {
                districtSelect.disabled = true;
                return;
            }

            try {
                districtSelect.classList.add('select-loading');
                const res = await fetch(`/api/location/districts/${provinceCode}`);
                if (!res.ok) throw new Error('Lỗi tải quận huyện');
                const data = await res.json();

                districtSelect.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
                data.forEach(d => {
                    const opt = document.createElement('option');
                    opt.value = d.code;
                    opt.dataset.name = d.name;
                    opt.textContent = d.name;
                    districtSelect.appendChild(opt);
                });
                districtSelect.disabled = false;
            } catch (err) {
                console.error(err);
                districtSelect.innerHTML = '<option value="">-- Lỗi tải dữ liệu --</option>';
            } finally {
                districtSelect.classList.remove('select-loading');
            }
        }

        async function onDistrictChange(districtSelect, wardSelectId) {
            const wardSelect = document.getElementById(wardSelectId);
            wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';

            const districtCode = districtSelect.value;
            if (!districtCode) {
                wardSelect.disabled = true;
                return;
            }

            try {
                wardSelect.classList.add('select-loading');
                const res = await fetch(`/api/location/wards/${districtCode}`);
                if (!res.ok) throw new Error('Lỗi tải phường xã');
                const data = await res.json();

                wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                data.forEach(w => {
                    const opt = document.createElement('option');
                    opt.value = w.code;
                    opt.dataset.name = w.name;
                    opt.textContent = w.name;
                    wardSelect.appendChild(opt);
                });
                wardSelect.disabled = false;
            } catch (err) {
                console.error(err);
                wardSelect.innerHTML = '<option value="">-- Lỗi tải dữ liệu --</option>';
            } finally {
                wardSelect.classList.remove('select-loading');
            }
        }

        function handleAddressSubmit(form) {
            const provSelect = document.getElementById('addProvince');
            const distSelect = document.getElementById('addDistrict');
            const wardSelect = document.getElementById('addWard');
            const streetInput = document.getElementById('addStreet');

            const provName = provSelect.options[provSelect.selectedIndex]?.dataset.name || '';
            const distName = distSelect.options[distSelect.selectedIndex]?.dataset.name || '';
            const wardName = wardSelect.options[wardSelect.selectedIndex]?.dataset.name || '';
            const street = streetInput.value.trim();

            if (!street || !provName || !distName || !wardName) {
                alert('Vui lòng chọn đầy đủ Tỉnh/Thành phố, Quận/Huyện, Phường/Xã và Số nhà/tên đường.');
                return false;
            }

            const fullAddress = `${street}, ${wardName}, ${distName}, ${provName}`;
            document.getElementById('addFinalSpecificAddress').value = fullAddress;
            return true;
        }

        function openEditModal(id, name, phone, address, isDefault) {
            document.getElementById('editId').value = id;
            document.getElementById('editFullName').value = name;
            document.getElementById('editPhone').value = phone;
            document.getElementById('editSpecific').value = address;
            document.getElementById('editIsDefault').checked = isDefault;

            var editModal = new bootstrap.Modal(document.getElementById('editAddressModal'));
            editModal.show();
        }
    </script>
}
