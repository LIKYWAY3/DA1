@model ASPtestShop.Models.ViewModels.Auth.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Tạo mật khẩu mới - FuuFishing";
}

<style>
    /* Ẩn hình cần câu lớn ở footer để không va chạm vào form Quên mật khẩu */
    .footer-section .sofa-img {
        display: none !important;
    }

    .forgot-page-container {
        min-height: calc(100vh - 460px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 50px 16px 90px 16px;
    }

    .forgot-wrapper {
        width: 100%;
        max-width: 440px;
        margin: 0 auto;
    }

    .forgot-title {
        color: #253f36;
        font-size: 1.85rem;
        font-weight: 800;
        letter-spacing: -0.5px;
        text-align: center;
        margin-bottom: 8px;
    }

    .forgot-desc {
        color: #6b7280;
        font-size: 0.95rem;
        text-align: center;
        margin-bottom: 28px;
        line-height: 1.5;
    }

    .custom-auth-label {
        font-size: 0.925rem;
        font-weight: 600;
        color: #121617;
        margin-bottom: 6px;
        display: block;
        text-align: left;
    }

    .custom-auth-input {
        width: 100%;
        border: 1px solid #2f2f2f;
        background-color: #ffffff;
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 0.95rem;
        color: #121617;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .custom-auth-input:focus {
        border-color: #253f36;
        outline: none;
        box-shadow: 0 0 0 2px rgba(37, 63, 54, 0.18);
        background-color: #ffffff;
    }

    .custom-auth-input::placeholder {
        color: #9ca3af;
        font-size: 0.9rem;
    }

    .btn-auth-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-top: 24px;
    }

    .btn-back-login {
        background-color: #ffffff;
        color: #121617;
        border: 1px solid #2f2f2f;
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s ease, border-color 0.2s ease;
        white-space: nowrap;
    }

    .btn-back-login:hover {
        background-color: #f3f4f6;
        color: #121617;
        border-color: #121617;
    }

    .btn-auth-submit {
        background-color: #253f36;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        padding: 12px 14px;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        transition: background-color 0.2s ease, transform 0.1s ease;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
    }

    .btn-auth-submit:hover {
        background-color: #192b25;
        color: #ffffff;
    }

    .btn-auth-submit:active {
        transform: translateY(1px);
    }
</style>

<div class="forgot-page-container">
    <div class="forgot-wrapper">
        <h2 class="forgot-title">Tạo mật khẩu mới</h2>
        <p class="forgot-desc">Hãy nhập email của bạn vào bên dưới để bắt đầu quá trình khôi phục mật khẩu.</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success d-flex align-items-center mb-4 py-2 px-3" style="border-radius: 8px; border: 1px solid #34d399;">
                <i class="fa fa-check-circle me-2 text-success fs-5"></i>
                <div class="small">@TempData["SuccessMessage"]</div>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger d-flex align-items-center mb-4 py-2 px-3" style="border-radius: 8px; border: 1px solid #f87171;">
                <i class="fa fa-exclamation-circle me-2 text-danger fs-5"></i>
                <div class="small">@TempData["ErrorMessage"]</div>
            </div>
        }

        @if (TempData["ResetLink"] != null)
        {
            <div class="alert alert-info py-2 px-3 mb-4 small" style="border-radius: 8px; word-break: break-all;">
                <strong><i class="fa fa-info-circle me-1"></i>Liên kết đặt lại mật khẩu:</strong>
                <div class="mt-1">
                    <a href="@TempData["ResetLink"]" class="fw-bold text-dark">
                        @TempData["ResetLink"]
                    </a>
                </div>
            </div>
        }

        <form asp-action="ForgotPassword" asp-controller="Account" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small" style="border-radius: 8px;"></div>

            <div class="mb-3">
                <label asp-for="Email" class="custom-auth-label">Email</label>
                <input asp-for="Email" class="custom-auth-input" placeholder="Nhập email của bạn" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block text-start"></span>
            </div>

            <!-- Hàng 2 nút 50% - 50%: Quay lại đăng nhập & Tiếp tục -->
            <div class="btn-auth-actions">
                <a href="/account/login" class="btn-back-login">
                    <i class="fa fa-chevron-left me-2"></i>Quay lại đăng nhập
                </a>
                <button type="submit" class="btn-auth-submit">
                    Tiếp tục
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
