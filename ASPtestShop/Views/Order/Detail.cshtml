                            <hr class="my-2 border-secondary-subtle">

                            <!-- Nhóm 2: Thanh toán -->
                            <div>
                                <div class="fw-semibold text-secondary x-small text-uppercase mb-2">Thanh toán</div>
                                <div class="d-flex justify-content-between align-items-center py-2 mb-1">
                                    <div>
                                        <div class="fw-bold text-dark">Tổng số tiền</div>
                                        <div class="text-muted x-small">(Đã bao gồm VAT và làm tròn)</div>
                                    </div>
                                    <div class="fw-bold fs-5 text-danger">${formatCurrency(order.finalAmount)}</div>
                                </div>

                                <div class="d-flex justify-content-between py-1 small">
                                    <div>
                                        <span class="text-muted">Tổng số tiền đã thanh toán:</span>
                                        <div class="text-muted x-small">${order.paymentStatus === 'Paid' ? '(Đã thanh toán trước)' : '(Chưa thanh toán)'}</div>
                                    </div>
                                    <strong class="text-dark">${order.paymentStatus === 'Paid' ? formatCurrency(order.finalAmount) : '0₫'}</strong>
                                </div>

                                <div class="d-flex justify-content-between py-1 small">
                                    <div>
                                        <span class="text-muted">Tổng số tiền còn lại:</span>
                                        <div class="text-muted x-small">${order.paymentStatus === 'Paid' ? '(Đã hoàn tất)' : '(Cần thanh toán khi nhận)'}</div>
                                    </div>
                                    <strong class="${order.paymentStatus === 'Paid' ? 'text-success' : 'text-danger'}">${order.paymentStatus === 'Paid' ? '0₫' : formatCurrency(order.finalAmount)}</strong>
                                </div>

                                <div class="d-flex justify-content-between align-items-center py-1 small mt-2 pt-2 border-top">
                                    <span class="text-muted">Phương thức:</span>
                                    <span class="badge bg-light text-dark border">${order.paymentMethod || 'COD'}</span>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            `;
        }

        // 3. Render Order Stepper Timeline (Responsive, chuẩn tỉ lệ, chống tràn)
        function renderOrderStepper(order) {
            const isCancelled = order.orderStatus === "Cancelled";
            const isCompleted = order.orderStatus === "Completed";
            const isShipped = order.orderStatus === "Shipped";
            const isConfirmed = order.orderStatus === "Confirmed" || order.orderStatus === "Processing";

            if (isCancelled) {
                return `
                    <div class="order-stepper">
                        <div class="stepper-item completed">
                            <div class="stepper-node">
                                <div class="stepper-icon"><i class="fa-solid fa-check"></i></div>
                                <div class="stepper-line cancelled"></div>
                            </div>
                            <div class="stepper-title">Đặt hàng thành công</div>
                            <div class="stepper-time">${formatDate(order.createdAt)}</div>
                        </div>

                        <div class="stepper-item cancelled">
                            <div class="stepper-node">
                                <div class="stepper-icon"><i class="fa-solid fa-xmark"></i></div>
                            </div>
                            <div class="stepper-title text-danger">Đã hủy đơn hàng</div>
                            <div class="stepper-time">Đơn đã đóng</div>
                        </div>
                    </div>
                `;
            }

            const step1LineCompleted = isConfirmed || isShipped || isCompleted;
            const step2LineCompleted = isCompleted;

            return `
                <div class="order-stepper">
                    <div class="stepper-item completed">
                        <div class="stepper-node">
                            <div class="stepper-icon"><i class="fa-solid fa-check"></i></div>
                            <div class="stepper-line ${step1LineCompleted ? 'completed' : ''}"></div>
                        </div>
                        <div class="stepper-title">Đặt hàng thành công</div>
                        <div class="stepper-time">${formatDate(order.createdAt)}</div>
                    </div>

                    <div class="stepper-item ${isCompleted ? 'completed' : (isShipped || isConfirmed ? 'active' : '')}">
                        <div class="stepper-node">
                            <div class="stepper-icon"><i class="${isCompleted ? 'fa-solid fa-check' : 'fa-solid fa-truck-fast'}"></i></div>
                            <div class="stepper-line ${step2LineCompleted ? 'completed' : ''}"></div>
                        </div>
                        <div class="stepper-title">${isShipped ? 'Đang vận chuyển' : (isConfirmed ? 'Đang xử lý & chuẩn bị' : 'Chờ xác nhận đơn')}</div>
                        <div class="stepper-time">${isShipped || isConfirmed || isCompleted ? 'Đang xử lý' : 'Chờ duyệt'}</div>
                    </div>

                    <div class="stepper-item ${isCompleted ? 'completed' : ''}">
                        <div class="stepper-node">
                            <div class="stepper-icon"><i class="${isCompleted ? 'fa-solid fa-check' : 'fa-solid fa-box-archive'}"></i></div>
                        </div>
                        <div class="stepper-title">Nhận hàng thành công</div>
                        <div class="stepper-time">${isCompleted ? 'Giao thành công' : 'Dự kiến'}</div>
                    </div>
                </div>
            `;
        }

        // 4. Chức năng Mua lại (Thêm sản phẩm vào giỏ hàng và tới giỏ)
        async function buyAgain(productId) {
            try {
                const response = await fetch("/api/cart/add", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: "include",
                    body: JSON.stringify({ productId: productId, quantity: 1 })
                });

                if (response.status === 401) {
                    window.location.href = `/account/login?returnUrl=/orders/detail/${orderId}`;
                    return;
                }

                const data = await response.json();
                if (response.ok) {
                    window.location.href = "/cart";
                } else {
                    alert(data.message || "Không thể thêm sản phẩm vào giỏ hàng.");
                }
            } catch (err) {
                console.error("Lỗi mua lại:", err);
                alert("Có lỗi xảy ra khi thêm sản phẩm vào giỏ hàng.");
            }
        }

        // Định dạng trạng thái đơn hàng (Badge màu sắc dịu chuẩn Anti-AI-slop & rõ nét)
        function renderStatusBadge(status) {
            const val = (status || "Pending").trim();
            const lower = val.toLowerCase();
            if (lower === "pending" || lower === "chờ xác nhận") {
                return `<span class="fuu-status-badge status-pending"><i class="fa-solid fa-clock me-1"></i>Chờ xác nhận</span>`;
            }
            if (lower === "confirmed" || lower === "đã xác nhận") {
                return `<span class="fuu-status-badge status-confirmed"><i class="fa-solid fa-spinner me-1"></i>Đang xử lý</span>`;
            }
            if (lower === "processing" || lower === "đang chuẩn bị" || lower === "chờ lấy hàng") {
                return `<span class="fuu-status-badge status-processing"><i class="fa-solid fa-box me-1"></i>Chờ lấy hàng</span>`;
            }
            if (lower === "shipped" || lower === "đang giao" || lower === "đang vận chuyển") {
                return `<span class="fuu-status-badge status-shipped"><i class="fa-solid fa-truck-fast me-1"></i>Đang vận chuyển</span>`;
            }
            if (lower === "completed" || lower === "đã giao" || lower === "đã nhận hàng") {
                return `<span class="fuu-status-badge status-completed"><i class="fa-solid fa-circle-check me-1"></i>Đã nhận hàng</span>`;
            }
            if (lower === "cancelled" || lower === "đã hủy" || lower === "hủy") {
                return `<span class="fuu-status-badge status-cancelled"><i class="fa-solid fa-ban me-1"></i>Đã hủy</span>`;
            }
            return `<span class="fuu-status-badge status-default">${escapeHtml(val)}</span>`;
        }

        function formatCurrency(val) {
            return new Intl.NumberFormat("vi-VN", { style: "currency", currency: "VND" }).format(val || 0);
        }

        function formatDate(val) {
            if (!val) return "";
            const d = new Date(val);
            const day = String(d.getDate()).padStart(2, '0');
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const year = d.getFullYear();
            const hours = String(d.getHours()).padStart(2, '0');
            const minutes = String(d.getMinutes()).padStart(2, '0');
            return `${day}/${month}/${year} ${hours}:${minutes}`;
        }

        function escapeHtml(str) {
            if (!str) return "";
            return str.replace(/[&<>'"]/g, tag => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                "'": '&#39;',
                '"': '&quot;'
            }[tag] || tag));
        }

        // ==========================================
        // HÀNH ĐỘNG ĐƠN HÀNG & HỦY ĐƠN / HOÀN TIỀN
        // ==========================================
        let currentRefundOrderId = 0;
        let currentCancelOrderId = 0;
        let currentCancelPaymentStatus = "";
        let currentRequestCancelOrderId = 0;

        function renderOrderActions(order) {
            let html = "";

            if (order.orderStatus === "Pending") {
                html += `
                    <div class="mt-3 pt-3 border-top">
                        <button type="button" class="btn-cancel-order" onclick="openCancelModal(${order.orderId}, '${order.paymentStatus}')">
                            <i class="fa-solid fa-circle-xmark me-1"></i> Hủy đơn hàng
                        </button>
                    </div>
                `;
            } else if (order.orderStatus === "Confirmed") {
                const hasRequested = order.note && order.note.includes("[Yêu cầu hủy]");
                if (hasRequested) {
                    html += `
                        <div class="alert alert-warning mt-3 mb-0 small">
                            <h6 class="alert-heading mb-1 fw-bold"><i class="fa-solid fa-clock me-1"></i> Đang chờ duyệt hủy</h6>
                            Yêu cầu hủy đơn hàng của bạn đang được Ban quản trị xem xét.
                        </div>
                    `;
                } else {
                    html += `
                        <div class="mt-3 pt-3 border-top">
                            <button type="button" class="btn-request-cancel" onclick="openRequestCancelModal(${order.orderId})">
                                <i class="fa-solid fa-ban me-1"></i> Yêu cầu hủy đơn hàng
                            </button>
                        </div>
                    `;
                }
            }

            if (order.paymentStatus === "Paid" && (order.orderStatus === "Completed" || order.orderStatus === "Cancelled")) {
                html += `
                    <div class="mt-3 pt-3 border-top">
                        <button type="button" class="btn-request-refund" onclick="openRefundModal(${order.orderId}, ${order.finalAmount})">
                            <i class="fa-solid fa-rotate-left me-1"></i> Yêu cầu hoàn tiền
                        </button>
                    </div>
                `;
            }

            return html;
        }

        function openCancelModal(orderId, paymentStatus) {
            currentCancelOrderId = orderId;
            currentCancelPaymentStatus = paymentStatus;
            document.getElementById("cancelOrderModalMessage").innerHTML = "";
            document.getElementById("cancelReasonSelect").value = "Đổi ý không muốn mua nữa";
            document.getElementById("customCancelReason").value = "";
            document.getElementById("customCancelReason").classList.add("d-none");

            const refundFields = document.getElementById("cancelRefundFields");
            if (paymentStatus === "Paid") {
                refundFields.classList.remove("d-none");
            } else {
                refundFields.classList.add("d-none");
            }

            const modal = new bootstrap.Modal(document.getElementById("cancelOrderModal"));
            modal.show();
        }

        function toggleCustomCancelReason(select) {
            const customText = document.getElementById("customCancelReason");
            if (select.value === "Lý do khác") {
                customText.classList.remove("d-none");
                customText.focus();
            } else {
                customText.classList.add("d-none");
            }
        }

        async function submitCancelOrder() {
            const select = document.getElementById("cancelReasonSelect");
            const custom = document.getElementById("customCancelReason");
            let reason = select.value;
            const customText = custom.value.trim();

            if (select.value === "Lý do khác") {
                if (!customText) {
                    document.getElementById("cancelOrderModalMessage").innerHTML = `<div class="alert alert-danger py-2 small">Vui lòng nhập chi tiết lý do hủy đơn.</div>`;
                    custom.focus();
                    return;
                }
                reason = customText;
            } else if (customText) {
                reason = `${select.value} (${customText})`;
            }

            const msgDiv = document.getElementById("cancelOrderModalMessage");
            const btn = document.getElementById("btnSubmitCancel");

            let bankName = "";
            let accountNumber = "";
            let accountHolderName = "";

            if (currentCancelPaymentStatus === "Paid") {
                bankName = document.getElementById("cancelBankName").value.trim();
                accountNumber = document.getElementById("cancelAccountNumber").value.trim();
                accountHolderName = document.getElementById("cancelAccountHolderName").value.trim();

                if (!bankName || !accountNumber || !accountHolderName) {
                    msgDiv.innerHTML = `<div class="alert alert-danger py-2 small">Vui lòng nhập đầy đủ thông tin tài khoản ngân hàng để nhận tiền hoàn.</div>`;
                    return;
                }
            }

            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...`;

            try {
                const res = await fetch(`/api/orders/cancel/${currentCancelOrderId}`, {
                    method: "POST",
                    credentials: "include",
                    headers: { "Content-Type": "application/json", "Accept": "application/json" },
                    body: JSON.stringify({
                        reason: reason,
                        bankName: bankName || null,
                        accountNumber: accountNumber || null,
                        accountHolderName: accountHolderName || null
                    })
                });

                const result = await res.json();
                if (!res.ok || !result.success) {
                    throw new Error(result.message || "Hủy đơn hàng thất bại.");
                }

                msgDiv.innerHTML = `<div class="alert alert-success py-2 small">${result.message}</div>`;
                setTimeout(() => {
                    const modal = bootstrap.Modal.getInstance(document.getElementById("cancelOrderModal"));
                    if (modal) modal.hide();
                    loadOrderDetail();
                }, 1200);
            } catch (e) {
                msgDiv.innerHTML = `<div class="alert alert-danger py-2 small">${e.message || "Có lỗi xảy ra"}</div>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-check me-1"></i> Xác nhận hủy đơn`;
            }
        }

        function openRequestCancelModal(orderId) {
            currentRequestCancelOrderId = orderId;
            document.getElementById("requestCancelReason").value = "";
            document.getElementById("requestCancelModalMessage").innerHTML = "";
            const modal = new bootstrap.Modal(document.getElementById("requestCancelModal"));
            modal.show();
        }

        async function submitRequestCancel() {
            const reason = document.getElementById("requestCancelReason").value.trim();
            const msgDiv = document.getElementById("requestCancelModalMessage");
            const btn = document.getElementById("btnSubmitRequestCancel");

            if (!reason) {
                msgDiv.innerHTML = `<div class="alert alert-danger py-2 small">Vui lòng nhập lý do yêu cầu hủy đơn.</div>`;
                return;
            }

            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang gửi...`;

            try {
                const res = await fetch(`/api/orders/request-cancel/${currentRequestCancelOrderId}`, {
                    method: "POST",
                    credentials: "include",
                    headers: { "Content-Type": "application/json", "Accept": "application/json" },
                    body: JSON.stringify({ reason: reason })
                });

                const result = await res.json();
                if (!res.ok || !result.success) {
                    throw new Error(result.message || "Gửi yêu cầu hủy thất bại.");
                }

                msgDiv.innerHTML = `<div class="alert alert-success py-2 small">${result.message}</div>`;
                setTimeout(() => {
                    const modal = bootstrap.Modal.getInstance(document.getElementById("requestCancelModal"));
                    if (modal) modal.hide();
                    loadOrderDetail();
                }, 1200);
            } catch (e) {
                msgDiv.innerHTML = `<div class="alert alert-danger py-2 small">${e.message || "Có lỗi xảy ra"}</div>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-paper-plane me-1"></i> Gửi yêu cầu`;
            }
        }

        async function openRefundModal(orderId, amount) {
            currentRefundOrderId = orderId || parseInt('@orderId') || 0;
            document.getElementById("refundAmountDisplay").value = formatCurrency(amount);
            document.getElementById("refundReason").value = "";
            document.getElementById("refundModalMessage").innerHTML = "";

            // Tự động nạp thông tin tài khoản ngân hàng mặc định của khách hàng từ UC-05
            try {
                const res = await fetch("/api/user/bank-accounts", { credentials: "include" });
                if (res.ok) {
                    const bankResult = await res.json();
                    const banks = bankResult.data || bankResult || [];
                    if (Array.isArray(banks) && banks.length > 0) {
                        const defaultBank = banks.find(b => b.isDefault) || banks[0];
                        if (defaultBank) {
                            if (!document.getElementById("refundBankName").value) {
                                document.getElementById("refundBankName").value = defaultBank.bankName || "";
                            }
                            if (!document.getElementById("refundAccountNumber").value) {
                                document.getElementById("refundAccountNumber").value = defaultBank.accountNumber || "";
                            }
                            if (!document.getElementById("refundAccountHolderName").value) {
                                document.getElementById("refundAccountHolderName").value = defaultBank.accountName || "";
                            }
                        }
                    }
                }
            } catch (err) {
                console.warn("Không thể nạp tự động tài khoản ngân hàng:", err);
            }
            
            const modal = new bootstrap.Modal(document.getElementById("refundModal"));
            modal.show();
        }

        async function submitRefundRequest() {
            const targetOrderId = currentRefundOrderId || parseInt('@orderId') || 0;
            const reason = document.getElementById("refundReason").value.trim();
            const bankName = document.getElementById("refundBankName").value.trim();
            const accountNumber = document.getElementById("refundAccountNumber").value.trim();
            const accountHolderName = document.getElementById("refundAccountHolderName").value.trim();
            const msgDiv = document.getElementById("refundModalMessage");
            const btn = document.getElementById("btnSubmitRefund");

            if (!targetOrderId || targetOrderId <= 0) {
                msgDiv.innerHTML = `<div class="alert alert-danger py-2 small">Không xác định được mã đơn hàng. Vui lòng tải lại trang.</div>`;
                return;
            }

            if (!reason) {
                msgDiv.innerHTML = `<div class="alert alert-danger py-2 small">Vui lòng nhập lý do yêu cầu hoàn tiền.</div>`;
                return;
            }

            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang gửi...`;

            try {
                const response = await fetch("/api/refunds", {
                    method: "POST",
                    credentials: "include",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify({
                        orderId: targetOrderId,
                        reason: reason,
                        bankName: bankName || null,
                        accountNumber: accountNumber || null,
                        accountHolderName: accountHolderName || null
                    })
                });

                const result = await response.json();

                if (!response.ok || !result.success) {
                    throw new Error(result.message || "Gửi yêu cầu hoàn tiền thất bại.");
                }

                msgDiv.innerHTML = `<div class="alert alert-success py-2 small">${result.message}</div>`;
                setTimeout(() => {
                    const modalEl = document.getElementById("refundModal");
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    loadOrderDetail();
                }, 1500);

            } catch (err) {
                msgDiv.innerHTML = `<div class="alert alert-danger py-2 small">${err.message || "Có lỗi xảy ra, vui lòng thử lại."}</div>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-check me-1"></i> Xác nhận gửi yêu cầu`;
            }
        }

        // ==========================================
        // UC-20: THEO DÕI & CẬP NHẬT YÊU CẦU HOÀN TIỀN
        // ==========================================
        let currentResubmitOrderId = 0;

        async function loadCustomerRefundStatus(orderId) {
            const container = document.getElementById("customerRefundSection");
            if (!container) return;

            try {
                const res = await fetch(`/api/refunds/order/${orderId}`, { credentials: "include" });
                if (!res.ok) {
                    container.innerHTML = "";
                    return;
                }

                const refund = await res.json();
                if (!refund) {
                    container.innerHTML = "";
                    return;
                }

                if (refund.status === "Pending") {
                    container.innerHTML = `
                        <div class="alert alert-warning mt-3 mb-0 small shadow-sm border border-warning">
                            <h6 class="alert-heading mb-1 fw-bold text-dark"><i class="fa-solid fa-clock me-1"></i> Yêu cầu hoàn tiền đang chờ xét duyệt</h6>
                            <div class="mb-1">Số tiền yêu cầu: <strong class="text-danger">${formatCurrency(refund.amount)}</strong></div>
                            <div class="mb-1">Tài khoản nhận: <strong>${escapeHtml(refund.bankName || "Chưa có")}</strong> - <code>${escapeHtml(refund.accountNumber || "")}</code> (${escapeHtml(refund.accountHolderName || "")})</div>
                            <div class="text-muted mt-1 small">Yêu cầu hoàn tiền của bạn đang được Ban quản trị xét duyệt.</div>
                        </div>
                    `;
                } else if (refund.status === "Approved") {
                    container.innerHTML = `
                        <div class="alert alert-success mt-3 mb-0 small shadow-sm border border-success">
                            <h6 class="alert-heading mb-1 fw-bold text-success"><i class="fa-solid fa-circle-check me-1"></i> Đã hoàn tiền thành công</h6>
                            <div class="mb-1">Số tiền đã hoàn: <strong class="text-success">${formatCurrency(refund.amount)}</strong></div>
                            ${refund.adminNote ? `<div class="mb-1">Phản hồi Ban quản trị: <strong>${escapeHtml(refund.adminNote)}</strong></div>` : ''}
                            <div class="text-muted mt-1 small">Đã xử lý lúc: ${formatDate(refund.processedAt)}</div>
                        </div>
                    `;
                } else if (refund.status === "Rejected") {
                    container.innerHTML = `
                        <div class="alert alert-danger mt-3 mb-0 small shadow-sm border border-danger">
                            <h6 class="alert-heading mb-1 fw-bold text-danger"><i class="fa-solid fa-circle-xmark me-1"></i> Yêu cầu hoàn tiền đã bị từ chối</h6>
                            <div class="mb-2"><strong>Lý do từ Ban quản trị:</strong> <span class="text-dark">${escapeHtml(refund.adminNote || "Chưa cung cấp lý do cụ thể")}</span></div>
                            <div class="p-2 rounded bg-white text-dark border mb-2 small">
                                Tài khoản đã gửi: ${escapeHtml(refund.bankName || "")} - <code>${escapeHtml(refund.accountNumber || "")}</code> (${escapeHtml(refund.accountHolderName || "")})
                            </div>
                            <button type="button" class="btn-cancel-order py-2 mt-1" onclick="openResubmitRefundModal(${refund.orderId}, '${escapeHtml(refund.bankName || "")}', '${escapeHtml(refund.accountNumber || "")}', '${escapeHtml(refund.accountHolderName || "")}')">
                                <i class="fa-solid fa-rotate-right me-1"></i> Cập nhật lại số tài khoản &amp; gửi lại
                            </button>
                        </div>
                    `;
                }
            } catch (e) {
                console.error("Lỗi tải thông tin hoàn tiền:", e);
            }
        }

        function openResubmitRefundModal(orderId, bankName, accountNumber, accountHolderName) {
            currentResubmitOrderId = orderId || parseInt('@orderId') || 0;
            document.getElementById("resubmitRefundModalMessage").innerHTML = "";
            document.getElementById("resubmitBankName").value = bankName || "";
            document.getElementById("resubmitAccountNumber").value = accountNumber || "";
            document.getElementById("resubmitAccountHolderName").value = accountHolderName || "";
            document.getElementById("resubmitReason").value = "";

            const modal = new bootstrap.Modal(document.getElementById("resubmitRefundModal"));
            modal.show();
        }

        async function submitResubmitRefund() {
            const targetOrderId = currentResubmitOrderId || parseInt('@orderId') || 0;
            const bankName = document.getElementById("resubmitBankName").value.trim();
            const accountNumber = document.getElementById("resubmitAccountNumber").value.trim();
            const accountHolderName = document.getElementById("resubmitAccountHolderName").value.trim();
            const reason = document.getElementById("resubmitReason").value.trim();
            const msgDiv = document.getElementById("resubmitRefundModalMessage");
            const btn = document.getElementById("btnSubmitResubmitRefund");

            if (!targetOrderId || targetOrderId <= 0) {
                msgDiv.innerHTML = `<div class="alert alert-danger py-2 small">Không xác định được mã đơn hàng. Vui lòng tải lại trang.</div>`;
                return;
            }

            if (!bankName || !accountNumber || !accountHolderName) {
                msgDiv.innerHTML = `<div class="alert alert-danger py-2 small">Vui lòng điền đầy đủ tên ngân hàng, số tài khoản và tên chủ tài khoản.</div>`;
                return;
            }

            btn.disabled = true;
            btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang gửi...`;

            try {
                const response = await fetch("/api/refunds/resubmit", {
                    method: "POST",
                    credentials: "include",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify({
                        orderId: targetOrderId,
                        bankName: bankName,
                        accountNumber: accountNumber,
                        accountHolderName: accountHolderName,
                        reason: reason || null
                    })
                });

                const result = await response.json();

                if (!response.ok || !result.success) {
                    throw new Error(result.message || "Gửi lại yêu cầu hoàn tiền thất bại.");
                }

                msgDiv.innerHTML = `<div class="alert alert-success py-2 small">${result.message}</div>`;
                setTimeout(() => {
                    const modalEl = document.getElementById("resubmitRefundModal");
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();
                    loadOrderDetail();
                }, 1500);

            } catch (err) {
                msgDiv.innerHTML = `<div class="alert alert-danger py-2 small">${err.message || "Có lỗi xảy ra, vui lòng thử lại."}</div>`;
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-paper-plane me-1"></i> Gửi lại yêu cầu`;
            }
        }
    </script>
}
