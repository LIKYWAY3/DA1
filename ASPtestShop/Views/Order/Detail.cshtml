@{
    ViewData["Title"] = "Chi tiết đơn hàng - FuuFishing";
    Layout = "~/Views/Shared/_LayoutCustomer.cshtml";
    var orderId = ViewBag.OrderId;
}

<div class="order-detail-page py-4">
    <div class="container">
        
        <!-- 1. BREADCRUMB / ĐIỀU HƯỚNG QUAY LẠI LỊCH SỬ ĐƠN HÀNG -->
        <div class="d-flex align-items-center mb-3">
            <a href="/orders/history" class="text-decoration-none text-dark fw-bold small me-2 back-history-link">
                <i class="fa-solid fa-chevron-left me-1"></i> Lịch sử mua hàng
            </a>
            <span class="text-muted small">/ Chi tiết đơn hàng</span>
        </div>

        <!-- Thông báo lỗi tổng quát nếu có -->
        <div id="orderDetailMessage"></div>

        <!-- NỘI DUNG CHÍNH (DYNAMIC RENDER VIA JS) -->
        <div id="orderDetailContent">
            <div class="text-center py-5 bg-white border rounded-3 shadow-sm">
                <div class="spinner-border text-fuu-primary mb-3" role="status">
                    <span class="visually-hidden">Đang tải...</span>
                </div>
                <div class="text-muted small">Đang tải chi tiết đơn hàng #${orderId}...</div>
            </div>
        </div>

    </div>

    <!-- =================================================================== -->
    <!-- CÁC MODAL NGHIỆP VỤ (HỦY ĐƠN / YÊU CẦU HOÀN TIỀN)                   -->
    <!-- =================================================================== -->

    <!-- Modal Hủy đơn hàng trực tiếp (Pending) -->
    <div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-labelledby="cancelOrderModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white py-3">
                    <h6 class="modal-title fw-bold mb-0" id="cancelOrderModalLabel">
                        <i class="fa-solid fa-circle-xmark me-2"></i>Hủy đơn hàng
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="cancelOrderModalMessage"></div>
                    <div class="mb-3">
                        <label for="cancelReasonSelect" class="form-label fw-semibold small">Lý do hủy đơn <span class="text-danger">*</span></label>
                        <select id="cancelReasonSelect" class="form-select form-select-sm mb-2" onchange="toggleCustomCancelReason(this)">
                            <option value="Đổi ý không muốn mua nữa">Đổi ý không muốn mua nữa</option>
                            <option value="Muốn thay đổi địa chỉ giao hàng / số điện thoại">Muốn thay đổi địa chỉ giao hàng / số điện thoại</option>
                            <option value="Đặt nhầm sản phẩm hoặc số lượng">Đặt nhầm sản phẩm hoặc số lượng</option>
                            <option value="Thời gian giao hàng dự kiến quá lâu">Thời gian giao hàng dự kiến quá lâu</option>
                            <option value="Tìm thấy giá tốt hơn ở nơi khác">Tìm thấy giá tốt hơn ở nơi khác</option>
                            <option value="Lý do khác">Lý do khác...</option>
                        </select>
                        <textarea id="customCancelReason" class="form-control form-control-sm d-none" rows="3" placeholder="Nhập lý do cụ thể..." maxlength="400"></textarea>
                    </div>

                    <div id="cancelRefundFields" class="d-none border-top pt-3 mt-3">
                        <div class="alert alert-warning py-2 small mb-3">
                            <i class="fa-solid fa-circle-info me-1"></i> Đơn hàng này đã thanh toán online. Sau khi hủy, hệ thống sẽ gửi yêu cầu hoàn tiền tới Ban quản trị để hoàn trả lại tiền cho bạn.
                        </div>
                        <h6 class="fw-bold mb-2 small text-uppercase">Tài khoản nhận tiền hoàn</h6>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Tên ngân hàng <span class="text-danger">*</span></label>
                            <input type="text" id="cancelBankName" class="form-control form-control-sm" placeholder="VD: Vietcombank, MB, Techcombank..." maxlength="100" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Số tài khoản <span class="text-danger">*</span></label>
                            <input type="text" id="cancelAccountNumber" class="form-control form-control-sm" placeholder="Nhập số tài khoản ngân hàng" maxlength="50" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Tên chủ tài khoản <span class="text-danger">*</span></label>
                            <input type="text" id="cancelAccountHolderName" class="form-control form-control-sm text-uppercase" placeholder="VD: NGUYEN VAN A" maxlength="100" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" id="btnSubmitCancel" class="btn btn-danger btn-sm fw-bold" onclick="submitCancelOrder()">
                        <i class="fa-solid fa-check me-1"></i> Xác nhận hủy đơn
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Yêu cầu hủy đơn (Confirmed) -->
    <div class="modal fade" id="requestCancelModal" tabindex="-1" aria-labelledby="requestCancelModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white py-3">
                    <h6 class="modal-title fw-bold mb-0" id="requestCancelModalLabel">
                        <i class="fa-solid fa-ban me-2"></i>Yêu cầu hủy đơn hàng
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="requestCancelModalMessage"></div>
                    <div class="alert alert-secondary py-2 small mb-3">
                        <i class="fa-solid fa-circle-info me-1"></i> Đơn hàng đã được xác nhận đóng gói. Yêu cầu của bạn sẽ được gửi tới Ban quản trị để phê duyệt trước khi hủy.
                    </div>
                    <div class="mb-3">
                        <label for="requestCancelReason" class="form-label fw-semibold small">Lý do yêu cầu hủy <span class="text-danger">*</span></label>
                        <textarea id="requestCancelReason" class="form-control form-control-sm" rows="3" placeholder="Nhập lý do bạn muốn hủy đơn..." required maxlength="400"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" id="btnSubmitRequestCancel" class="btn btn-dark btn-sm fw-bold" onclick="submitRequestCancel()">
                        <i class="fa-solid fa-paper-plane me-1"></i> Gửi yêu cầu
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Yêu cầu hoàn tiền -->
    <div class="modal fade" id="refundModal" tabindex="-1" aria-labelledby="refundModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white py-3">
                    <h6 class="modal-title fw-bold mb-0" id="refundModalLabel">
                        <i class="fa-solid fa-hand-holding-dollar me-2"></i>Yêu cầu hoàn tiền
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="refundModalMessage"></div>
                    <form id="refundForm">
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Số tiền hoàn dự kiến</label>
                            <input type="text" id="refundAmountDisplay" class="form-control form-control-sm fw-bold text-danger" readonly />
                        </div>
                        <div class="mb-3">
                            <label for="refundReason" class="form-label small fw-semibold">Lý do yêu cầu hoàn tiền <span class="text-danger">*</span></label>
                            <textarea id="refundReason" class="form-control form-control-sm" rows="3" placeholder="Nhập lý do muốn hoàn tiền..." required maxlength="500"></textarea>
                        </div>
                        <h6 class="border-top pt-3 mt-3 small text-uppercase fw-bold">Thông tin nhận tiền hoàn</h6>
                        <div class="mb-2">
                            <label for="refundBankName" class="form-label small fw-semibold">Tên ngân hàng <span class="text-danger">*</span></label>
                            <input type="text" id="refundBankName" class="form-control form-control-sm" placeholder="VD: Vietcombank, MB, Techcombank..." maxlength="100" />
                        </div>
                        <div class="mb-2">
                            <label for="refundAccountNumber" class="form-label small fw-semibold">Số tài khoản <span class="text-danger">*</span></label>
                            <input type="text" id="refundAccountNumber" class="form-control form-control-sm" placeholder="Nhập số tài khoản ngân hàng" maxlength="50" />
                        </div>
                        <div class="mb-2">
                            <label for="refundAccountHolderName" class="form-label small fw-semibold">Tên chủ tài khoản <span class="text-danger">*</span></label>
                            <input type="text" id="refundAccountHolderName" class="form-control form-control-sm text-uppercase" placeholder="VD: NGUYEN VAN A" maxlength="100" />
                        </div>
                    </form>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" id="btnSubmitRefund" class="btn btn-danger btn-sm fw-bold" onclick="submitRefundRequest()">
                        <i class="fa-solid fa-check me-1"></i> Xác nhận gửi yêu cầu
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Gửi lại thông tin tài khoản hoàn tiền khi bị từ chối -->
    <div class="modal fade" id="resubmitRefundModal" tabindex="-1" aria-labelledby="resubmitRefundModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white py-3">
                    <h6 class="modal-title fw-bold mb-0" id="resubmitRefundModalLabel">
                        <i class="fa-solid fa-rotate-right me-2"></i>Cập nhật thông tin nhận hoàn tiền
                    </h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="resubmitRefundModalMessage"></div>
                    <div class="alert alert-secondary py-2 small mb-3">
                        <i class="fa-solid fa-circle-info me-1"></i> Vui lòng kiểm tra kỹ số tài khoản và ngân hàng chính xác để Ban quản trị xử lý hoàn tiền chuyển khoản nhanh nhất.
                    </div>
                    <div class="mb-2">
                        <label for="resubmitBankName" class="form-label small fw-semibold">Tên ngân hàng <span class="text-danger">*</span></label>
                        <input type="text" id="resubmitBankName" class="form-control form-control-sm" placeholder="VD: Vietcombank, Techcombank, MB..." required maxlength="100" />
                    </div>
                    <div class="mb-2">
                        <label for="resubmitAccountNumber" class="form-label small fw-semibold">Số tài khoản nhận tiền <span class="text-danger">*</span></label>
                        <input type="text" id="resubmitAccountNumber" class="form-control form-control-sm" placeholder="Nhập số tài khoản ngân hàng" required maxlength="50" />
                    </div>
                    <div class="mb-2">
                        <label for="resubmitAccountHolderName" class="form-label small fw-semibold">Tên chủ tài khoản <span class="text-danger">*</span></label>
                        <input type="text" id="resubmitAccountHolderName" class="form-control form-control-sm text-uppercase" placeholder="VD: NGUYEN VAN A" required maxlength="100" />
                    </div>
                    <div class="mb-2">
                        <label for="resubmitReason" class="form-label small fw-semibold">Ghi chú bổ sung (tùy chọn)</label>
                        <textarea id="resubmitReason" class="form-control form-control-sm" rows="2" placeholder="Ghi chú thêm cho Ban quản trị..." maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light py-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" id="btnSubmitResubmitRefund" class="btn btn-danger btn-sm fw-bold" onclick="submitResubmitRefund()">
                        <i class="fa-solid fa-paper-plane me-1"></i> Gửi lại yêu cầu
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Ẩn cần câu footer trang trí gây che khuất */
    .footer-section .sofa-img {
        display: none !important;
    }

    .order-detail-page {
        background-color: #f4f6f8;
        min-height: 80vh;
        padding-bottom: 70px !important;
    }

    .back-history-link:hover {
        color: #253f36 !important;
        text-decoration: underline !important;
    }

    /* Thumbnail sản phẩm */
    .order-detail-thumb {
        width: 70px;
        height: 70px;
        object-fit: cover;
        flex-shrink: 0;
        background-color: #f8fafc;
    }

    /* =================================================== */
    /* Order Stepper Timeline (Responsive & Chống tràn)    */
    /* =================================================== */
    .order-stepper {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        position: relative;
        padding: 16px 8px 8px 8px;
        width: 100%;
        overflow: hidden;
    }

    .stepper-item {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        position: relative;
    }

    .stepper-node {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        margin-bottom: 8px;
    }

    .stepper-icon {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background-color: #ffffff;
        border: 2px solid #cbd5e1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8125rem;
        color: #94a3b8;
        z-index: 2;
        transition: all 0.2s ease;
    }

    .stepper-item.completed .stepper-icon {
        background-color: #253f36;
        border-color: #253f36;
        color: #ffffff;
    }

    .stepper-item.active .stepper-icon {
        background-color: #253f36;
        border-color: #253f36;
        color: #ffffff;
        box-shadow: 0 0 0 4px rgba(37, 63, 54, 0.15);
    }

    .stepper-item.cancelled .stepper-icon {
        background-color: #dc2626;
        border-color: #dc2626;
        color: #ffffff;
    }

    /* Thanh line nối giữa các bước */
    .stepper-line {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 100%;
        height: 3px;
        transform: translateY(-50%);
        background-color: #e2e8f0;
        z-index: 1;
        transition: background-color 0.3s ease;
    }

    .stepper-line.completed {
        background-color: #253f36;
    }

    .stepper-line.cancelled {
        background-color: #dc2626;
    }

    .stepper-title {
        font-size: 0.8125rem;
        font-weight: 600;
        color: #1e293b;
        margin-bottom: 2px;
        padding: 0 4px;
    }

    .stepper-time {
        font-size: 0.725rem;
        color: #64748b;
    }

    /* =================================================== */
    /* Badges trạng thái đơn hàng (Tương thích chuẩn)       */
    /* =================================================== */
    .fuu-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.75rem;
        font-weight: 600;
        padding: 3px 8px;
        border-radius: 4px;
        line-height: 1.3;
        white-space: nowrap;
    }

    .fuu-status-badge.status-pending {
        background-color: #fef3c7 !important;
        color: #92400e !important;
        border: 1px solid #fde68a !important;
    }

    .fuu-status-badge.status-confirmed,
    .fuu-status-badge.status-processing {
        background-color: #e0f2fe !important;
        color: #0369a1 !important;
        border: 1px solid #bae6fd !important;
    }

    .fuu-status-badge.status-shipped {
        background-color: #f0fdfa !important;
        color: #0f766e !important;
        border: 1px solid #99f6e4 !important;
    }

    .fuu-status-badge.status-completed {
        background-color: #dcfce7 !important;
        color: #15803d !important;
        border: 1px solid #bbf7d0 !important;
    }

    .fuu-status-badge.status-cancelled {
        background-color: #fee2e2 !important;
        color: #dc2626 !important;
        border: 1px solid #fecaca !important;
    }

    .fuu-status-badge.status-default {
        background-color: #f1f5f9 !important;
        color: #475569 !important;
        border: 1px solid #e2e8f0 !important;
    }

    /* =================================================== */
    /* Nút bấm chuẩn Anti-AI-slop (Khắc phục .btn đen sì)  */
    /* =================================================== */
    .btn-buy-again {
        background: #ffffff !important;
        color: #dc2626 !important;
        border: 1px solid #dc2626 !important;
        border-radius: 4px !important;
        font-size: 0.8125rem !important;
        font-weight: 600 !important;
        padding: 5px 14px !important;
        cursor: pointer !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        transition: all 0.15s ease !important;
        text-decoration: none !important;
        line-height: 1.4 !important;
    }
    .btn-buy-again:hover {
        background: #fef2f2 !important;
        border-color: #b91c1c !important;
        color: #b91c1c !important;
    }

    .btn-cancel-order {
        background: #ffffff !important;
        color: #dc2626 !important;
        border: 1.5px solid #dc2626 !important;
        border-radius: 6px !important;
        font-size: 0.875rem !important;
        font-weight: 600 !important;
        padding: 9px 16px !important;
        cursor: pointer !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 6px !important;
        width: 100% !important;
        transition: all 0.15s ease !important;
        text-decoration: none !important;
    }
    .btn-cancel-order:hover {
        background: #fef2f2 !important;
        color: #b91c1c !important;
        border-color: #b91c1c !important;
    }

    .btn-request-cancel {
        background: #ffffff !important;
        color: #d97706 !important;
        border: 1.5px solid #d97706 !important;
        border-radius: 6px !important;
        font-size: 0.875rem !important;
        font-weight: 600 !important;
        padding: 9px 16px !important;
        cursor: pointer !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 6px !important;
        width: 100% !important;
        transition: all 0.15s ease !important;
        text-decoration: none !important;
    }
    .btn-request-cancel:hover {
        background: #fffbeb !important;
        color: #b45309 !important;
        border-color: #b45309 !important;
    }

    .btn-request-refund {
        background: #ffffff !important;
        color: #253f36 !important;
        border: 1.5px solid #253f36 !important;
        border-radius: 6px !important;
        font-size: 0.875rem !important;
        font-weight: 600 !important;
        padding: 9px 16px !important;
        cursor: pointer !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 6px !important;
        width: 100% !important;
        transition: all 0.15s ease !important;
        text-decoration: none !important;
    }
    .btn-request-refund:hover {
        background: #f0fdf4 !important;
        color: #1e332c !important;
        border-color: #1e332c !important;
    }

    /* Modal buttons */
    .order-detail-page .modal-footer .btn {
        border-radius: 6px !important;
        padding: 6px 14px !important;
        font-weight: 600 !important;
        font-size: 0.8125rem !important;
    }
    .order-detail-page .modal-footer .btn-danger {
        background-color: #dc2626 !important;
        border-color: #dc2626 !important;
        color: #ffffff !important;
    }
    .order-detail-page .modal-footer .btn-danger:hover {
        background-color: #b91c1c !important;
        border-color: #b91c1c !important;
    }
    .order-detail-page .modal-footer .btn-outline-secondary {
        background-color: #ffffff !important;
        border-color: #cbd5e1 !important;
        color: #475569 !important;
    }
    .order-detail-page .modal-footer .btn-outline-secondary:hover {
        background-color: #f1f5f9 !important;
        color: #1e293b !important;
    }
    .order-detail-page .modal-footer .btn-dark {
        background-color: #253f36 !important;
        border-color: #253f36 !important;
        color: #ffffff !important;
    }
    .order-detail-page .modal-footer .btn-dark:hover {
        background-color: #1e332c !important;
        border-color: #1e332c !important;
    }

    .text-fuu-primary {
        color: #253f36 !important;
    }

    .x-small {
        font-size: 0.75rem;
    }

    @@media (max-width: 576px) {
        .order-detail-page {
            padding-top: 16px !important;
            padding-bottom: 50px !important;
        }
        .order-stepper {
            padding: 12px 2px 4px 2px;
        }
        .stepper-icon {
            width: 26px;
            height: 26px;
            font-size: 0.75rem;
        }
        .stepper-title {
            font-size: 0.7rem;
            padding: 0 1px;
        }
        .stepper-time {
            font-size: 0.65rem;
        }
        .order-detail-thumb {
            width: 56px;
            height: 56px;
        }
    }
</style>

@section Scripts {
    <script>
        const orderId = @orderId;
        const orderDetailMessage = document.getElementById("orderDetailMessage");
        const orderDetailContent = document.getElementById("orderDetailContent");

        document.addEventListener("DOMContentLoaded", function () {
            loadOrderDetail();
        });

        async function loadOrderDetail() {
            try {
                const response = await fetch(`/api/orders/${orderId}`, {
                    method: "GET",
                    credentials: "include"
                });

                if (response.status === 401) {
                    window.location.href = `/account/login?returnUrl=/orders/detail/${orderId}`;
                    return;
                }

                if (response.status === 404) {
                    orderDetailContent.innerHTML = `
                        <div class="alert alert-warning border-0 shadow-sm rounded-3">
                            Không tìm thấy đơn hàng #${orderId}.
                        </div>
                    `;
                    return;
                }

                if (!response.ok) {
                    orderDetailContent.innerHTML = `
                        <div class="alert alert-danger border-0 shadow-sm rounded-3">
                            Không thể tải chi tiết đơn hàng. Vui lòng thử lại sau.
                        </div>
                    `;
                    return;
                }

                const result = await response.json();
                const order = result.orderDetails || result.OrderDetails || result.data || result;

                if (!order || !order.orderId) {
                    orderDetailContent.innerHTML = `
                        <div class="alert alert-warning border-0 shadow-sm rounded-3">
                            ${result.message || "Không tìm thấy chi tiết đơn hàng."}
                        </div>
                    `;
                    return;
                }

                renderOrderDetail(order);
                await loadCustomerRefundStatus(order.orderId);

                if (window.location.hash === "#cancel" && order.orderStatus === "Pending") {
                    openCancelModal(order.orderId, order.paymentStatus);
                }

            } catch (error) {
                console.error("Lỗi nạp chi tiết đơn hàng:", error);
                orderDetailContent.innerHTML = `
                    <div class="alert alert-danger border-0 shadow-sm rounded-3">
                        Có lỗi xảy ra khi tải chi tiết đơn hàng.
                    </div>
                `;
            }
        }

        // Render giao diện chi tiết theo chuẩn CellphoneS (Ảnh 2)
        function renderOrderDetail(order) {
            const items = order.items || [];
            const statusBadge = renderStatusBadge(order.orderStatus);
            const totalQuantity = items.reduce((sum, it) => sum + (it.quantity || 0), 0);

            orderDetailContent.innerHTML = `
                <!-- 1. CARD TỔNG QUAN & SẢN PHẨM & TIMELINE STEPPER -->
                <div class="card bg-white border rounded-3 p-3 p-md-4 shadow-sm mb-4">
                    
                    <!-- Header Tổng quan -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pb-3 mb-3 border-bottom">
