    async function submitRefundRequest() {
        const reason = document.getElementById("refundReason").value.trim();
        const bankName = document.getElementById("refundBankName").value.trim();
        const accountNumber = document.getElementById("refundAccountNumber").value.trim();
        const accountHolderName = document.getElementById("refundAccountHolderName").value.trim();
        const msgDiv = document.getElementById("refundModalMessage");
        const btn = document.getElementById("btnSubmitRefund");

        if (!reason) {
            msgDiv.innerHTML = `<div class="alert alert-danger py-2">Vui lòng nhập lý do yêu cầu hoàn tiền.</div>`;
            return;
        }

        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang gửi...`;

        try {
            const response = await fetch("/api/refunds", {
                method: "POST",
                credentials: "include",
                headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json"
                },
                body: JSON.stringify({
                    orderId: currentRefundOrderId,
                    reason: reason,
                    bankName: bankName || null,
                    accountNumber: accountNumber || null,
                    accountHolderName: accountHolderName || null
                })
            });

            const result = await response.json();

            if (!response.ok || !result.success) {
                throw new Error(result.message || "Gửi yêu cầu hoàn tiền thất bại.");
            }

            msgDiv.innerHTML = `<div class="alert alert-success py-2">${result.message}</div>`;
            setTimeout(() => {
                const modalEl = document.getElementById("refundModal");
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
                loadOrderDetail();
            }, 1500);

        } catch (err) {
            msgDiv.innerHTML = `<div class="alert alert-danger py-2">${err.message || "Có lỗi xảy ra, vui lòng thử lại."}</div>`;
        } finally {
            btn.disabled = false;
            btn.innerHTML = "Xác nhận gửi yêu cầu";
        }
    }

    // ==========================================
    // UC-20: THEO DÕI & CẬP NHẬT YÊU CẦU HOÀN TIỀN
    // ==========================================
    let currentResubmitOrderId = 0;

    async function loadCustomerRefundStatus(orderId) {
        const container = document.getElementById("customerRefundSection");
        if (!container) return;

        try {
            const res = await fetch(`/api/refunds/order/${orderId}`, { credentials: "include" });
            if (!res.ok) {
                container.innerHTML = "";
                return;
            }

            const refund = await res.json();
            if (!refund) {
                container.innerHTML = "";
                return;
            }

            if (refund.status === "Pending") {
                container.innerHTML = `
                    <div class="alert alert-warning mt-3 mb-0 small shadow-sm border border-warning">
                        <h6 class="alert-heading mb-1 fw-bold text-dark"><i class="fa fa-clock me-1"></i> Yêu cầu hoàn tiền đang chờ xét duyệt</h6>
                        <div class="mb-1">Số tiền yêu cầu: <strong class="text-danger">${formatCurrency(refund.amount)}</strong></div>
                        <div class="mb-1">Tài khoản nhận: <strong>${escapeHtml(refund.bankName || "Chưa có")}</strong> - <code>${escapeHtml(refund.accountNumber || "")}</code> (${escapeHtml(refund.accountHolderName || "")})</div>
                        <div class="text-muted mt-1 small">Yêu cầu hoàn tiền của bạn đang được Ban quản trị xét duyệt.</div>
                    </div>
                `;
            } else if (refund.status === "Approved") {
                container.innerHTML = `
                    <div class="alert alert-success mt-3 mb-0 small shadow-sm border border-success">
                        <h6 class="alert-heading mb-1 fw-bold text-success"><i class="fa fa-check-circle me-1"></i> Đã hoàn tiền thành công</h6>
                        <div class="mb-1">Số tiền đã hoàn: <strong class="text-success">${formatCurrency(refund.amount)}</strong></div>
                        ${refund.adminNote ? `<div class="mb-1">Phản hồi Ban quản trị: <strong>${escapeHtml(refund.adminNote)}</strong></div>` : ''}
                        <div class="text-muted mt-1 small">Đã xử lý lúc: ${formatDate(refund.processedAt)}</div>
                    </div>
                `;
            } else if (refund.status === "Rejected") {
                container.innerHTML = `
                    <div class="alert alert-danger mt-3 mb-0 small shadow-sm border border-danger">
                        <h6 class="alert-heading mb-1 fw-bold text-danger"><i class="fa fa-times-circle me-1"></i> Yêu cầu hoàn tiền đã bị từ chối</h6>
                        <div class="mb-2"><strong>Lý do từ Ban quản trị:</strong> <span class="text-dark">${escapeHtml(refund.adminNote || "Chưa cung cấp lý do cụ thể")}</span></div>
                        <div class="p-2 rounded bg-white text-dark border mb-2 small">
                            Tài khoản đã gửi: ${escapeHtml(refund.bankName || "")} - <code>${escapeHtml(refund.accountNumber || "")}</code> (${escapeHtml(refund.accountHolderName || "")})
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-danger fw-bold w-100 py-1" onclick="openResubmitRefundModal(${refund.orderId}, '${escapeHtml(refund.bankName || "")}', '${escapeHtml(refund.accountNumber || "")}', '${escapeHtml(refund.accountHolderName || "")}')">
                            <i class="fa fa-redo me-1"></i> Cập nhật lại số tài khoản &amp; gửi lại
                        </button>
                    </div>
                `;
            }
        } catch (e) {
            console.error("Lỗi tải thông tin hoàn tiền:", e);
        }
    }

    function openResubmitRefundModal(orderId, bankName, accountNumber, accountHolderName) {
        currentResubmitOrderId = orderId;
        document.getElementById("resubmitRefundModalMessage").innerHTML = "";
        document.getElementById("resubmitBankName").value = bankName || "";
        document.getElementById("resubmitAccountNumber").value = accountNumber || "";
        document.getElementById("resubmitAccountHolderName").value = accountHolderName || "";
        document.getElementById("resubmitReason").value = "";

        const modal = new bootstrap.Modal(document.getElementById("resubmitRefundModal"));
        modal.show();
    }

    async function submitResubmitRefund() {
        const bankName = document.getElementById("resubmitBankName").value.trim();
        const accountNumber = document.getElementById("resubmitAccountNumber").value.trim();
        const accountHolderName = document.getElementById("resubmitAccountHolderName").value.trim();
        const reason = document.getElementById("resubmitReason").value.trim();
        const msgDiv = document.getElementById("resubmitRefundModalMessage");
        const btn = document.getElementById("btnSubmitResubmitRefund");

        if (!bankName || !accountNumber || !accountHolderName) {
            msgDiv.innerHTML = `<div class="alert alert-danger py-2 small">Vui lòng điền đầy đủ tên ngân hàng, số tài khoản và tên chủ tài khoản.</div>`;
            return;
        }

        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang gửi...`;

        try {
            const response = await fetch("/api/refunds/resubmit", {
                method: "POST",
                credentials: "include",
                headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json"
                },
                body: JSON.stringify({
                    orderId: currentResubmitOrderId,
                    bankName: bankName,
                    accountNumber: accountNumber,
                    accountHolderName: accountHolderName,
                    reason: reason || null
                })
            });

            const result = await response.json();

            if (!response.ok || !result.success) {
                throw new Error(result.message || "Gửi lại yêu cầu hoàn tiền thất bại.");
            }

            msgDiv.innerHTML = `<div class="alert alert-success py-2 small">${result.message}</div>`;
            setTimeout(() => {
                const modal = bootstrap.Modal.getInstance(document.getElementById("resubmitRefundModal"));
                if (modal) modal.hide();
                loadOrderDetail();
            }, 1500);

        } catch (err) {
            msgDiv.innerHTML = `<div class="alert alert-danger py-2 small">${err.message || "Có lỗi xảy ra, vui lòng thử lại."}</div>`;
        } finally {
            btn.disabled = false;
            btn.innerHTML = `<i class="fa fa-paper-plane me-1"></i> Gửi lại yêu cầu`;
        }
    }

    // BẢO MẬT: Hàm mã hóa HTML để phòng chống lỗ hổng Cross-Site Scripting (XSS)
    function escapeHtml(str) {
        if (!str) return "";
        return String(str)
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");
    }
</script>