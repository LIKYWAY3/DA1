@{
    ViewData["Title"] = "Chi tiết đơn hàng";
    var orderId = ViewBag.OrderId;
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Chi tiết đơn hàng</h2>

        <a href="/orders/history" class="btn btn-outline-dark">
            Quay lại lịch sử
        </a>
    </div>

    <div id="orderDetailMessage"></div>

    <div id="orderDetailContent">
        <div class="text-center text-muted py-5">
            Đang tải chi tiết đơn hàng...
        </div>
    </div>

    <!-- UC-20: Modal Yêu cầu hoàn tiền -->
    <div class="modal fade" id="refundModal" tabindex="-1" aria-labelledby="refundModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="refundModalLabel">Yêu cầu hoàn tiền đơn hàng</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="refundModalMessage"></div>
                    <form id="refundForm">
                        <div class="mb-3">
                            <label class="form-label">Số tiền hoàn dự kiến</label>
                            <input type="text" id="refundAmountDisplay" class="form-control fw-bold text-danger" readonly />
                        </div>
                        <div class="mb-3">
                            <label for="refundReason" class="form-label">Lý do yêu cầu hoàn tiền <span class="text-danger">*</span></label>
                            <textarea id="refundReason" class="form-control" rows="3" placeholder="Nhập lý do muốn hoàn tiền..." required maxlength="500"></textarea>
                        </div>
                        <h6 class="border-top pt-3 mt-3">Thông tin nhận tiền hoàn</h6>
                        <div class="mb-3">
                            <label for="refundBankName" class="form-label">Tên ngân hàng</label>
                            <input type="text" id="refundBankName" class="form-control" placeholder="VD: Vietcombank, MB, Techcombank..." maxlength="100" />
                        </div>
                        <div class="mb-3">
                            <label for="refundAccountNumber" class="form-label">Số tài khoản</label>
                            <input type="text" id="refundAccountNumber" class="form-control" placeholder="Nhập số tài khoản ngân hàng" maxlength="50" />
                        </div>
                        <div class="mb-3">
                            <label for="refundAccountHolderName" class="form-label">Tên chủ tài khoản</label>
                            <input type="text" id="refundAccountHolderName" class="form-control text-uppercase" placeholder="VD: NGUYEN VAN A" maxlength="100" />
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" id="btnSubmitRefund" class="btn btn-danger" onclick="submitRefundRequest()">Xác nhận gửi yêu cầu</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal Hủy đơn hàng trực tiếp (Pending) -->
    <div class="modal fade" id="cancelOrderModal" tabindex="-1" aria-labelledby="cancelOrderModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-danger text-white py-3">
                    <h5 class="modal-title fw-bold" id="cancelOrderModalLabel"><i class="fa fa-times-circle me-2"></i>Hủy đơn hàng</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="cancelOrderModalMessage"></div>
                    <div class="mb-3">
                        <label for="cancelReasonSelect" class="form-label fw-semibold">Lý do hủy / hoàn hàng <span class="text-danger">*</span></label>
                        <select id="cancelReasonSelect" class="form-select mb-2" style="border: 1px solid #2f2f2f; background-color: #ffffff; color: #121617;">
                            <option value="Đổi ý không muốn mua nữa">Đổi ý không muốn mua nữa</option>
                            <option value="Muốn thay đổi địa chỉ giao hàng / số điện thoại">Muốn thay đổi địa chỉ giao hàng / số điện thoại</option>
                            <option value="Đặt nhầm sản phẩm hoặc số lượng">Đặt nhầm sản phẩm hoặc số lượng</option>
                            <option value="Thời gian giao hàng dự kiến quá lâu">Thời gian giao hàng dự kiến quá lâu</option>
                            <option value="Tìm thấy giá tốt hơn ở nơi khác">Tìm thấy giá tốt hơn ở nơi khác</option>
                            <option value="Lý do khác">Lý do khác...</option>
                        </select>
                        <label for="customCancelReason" class="form-label small text-muted mb-1">Ghi chú chi tiết lý do (tùy chọn hoặc chi tiết lý do khác):</label>
                        <textarea id="customCancelReason" class="form-control" rows="3" placeholder="Nhập lý do cụ thể hoặc ghi chú thêm cho người bán / cửa hàng..." maxlength="400" style="border: 1px solid #2f2f2f; background-color: #ffffff; color: #121617;"></textarea>
                    </div>

                    <div id="cancelRefundFields" class="d-none border-top pt-3 mt-3">
                        <div class="alert alert-warning py-2 small mb-3">
                            <i class="fa fa-info-circle me-1"></i> Đơn hàng này đã thanh toán online. Sau khi hủy, hệ thống sẽ gửi yêu cầu hoàn tiền tới Ban quản trị để chuyển trả tiền cho bạn.
                        </div>
                        <h6 class="fw-bold mb-2 small text-uppercase">Tài khoản nhận tiền hoàn</h6>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Tên ngân hàng <span class="text-danger">*</span></label>
                            <input type="text" id="cancelBankName" class="form-control form-control-sm" placeholder="VD: Vietcombank, MB, Techcombank..." maxlength="100" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Số tài khoản <span class="text-danger">*</span></label>
                            <input type="text" id="cancelAccountNumber" class="form-control form-control-sm" placeholder="Nhập số tài khoản ngân hàng" maxlength="50" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label small fw-semibold">Tên chủ tài khoản <span class="text-danger">*</span></label>
                            <input type="text" id="cancelAccountHolderName" class="form-control form-control-sm text-uppercase" placeholder="VD: NGUYEN VAN A" maxlength="100" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" id="btnSubmitCancel" class="btn btn-danger fw-bold" onclick="submitCancelOrder()">
                        <i class="fa fa-times-circle me-1"></i> Xác nhận hủy đơn
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Gửi yêu cầu hủy đơn (Confirmed) -->
    <div class="modal fade" id="requestCancelModal" tabindex="-1" aria-labelledby="requestCancelModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title fw-bold" id="requestCancelModalLabel"><i class="fa fa-ban me-2"></i>Yêu cầu hủy đơn hàng</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="requestCancelModalMessage"></div>
                    <div class="alert alert-secondary py-2 small mb-3">
                        <i class="fa fa-info-circle me-1"></i> Đơn hàng đã được xác nhận đóng gói. Yêu cầu của bạn sẽ được gửi tới Ban quản trị để phê duyệt trước khi hủy.
                    </div>
                    <div class="mb-3">
                        <label for="requestCancelReason" class="form-label fw-semibold">Lý do yêu cầu hủy <span class="text-danger">*</span></label>
                        <textarea id="requestCancelReason" class="form-control" rows="3" placeholder="Nhập lý do bạn muốn hủy đơn..." required maxlength="400"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" id="btnSubmitRequestCancel" class="btn btn-dark fw-bold" onclick="submitRequestCancel()">
                        <i class="fa fa-paper-plane me-1"></i> Gửi yêu cầu
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal Gửi lại thông tin tài khoản hoàn tiền khi bị từ chối -->
    <div class="modal fade" id="resubmitRefundModal" tabindex="-1" aria-labelledby="resubmitRefundModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title fw-bold" id="resubmitRefundModalLabel">
                        <i class="fa fa-redo me-2"></i>Cập nhật thông tin nhận hoàn tiền
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div id="resubmitRefundModalMessage"></div>
                    <div class="alert alert-secondary py-2 small mb-3">
                        <i class="fa fa-info-circle me-1"></i> Vui lòng kiểm tra kỹ số tài khoản và ngân hàng chính xác để Ban quản trị xử lý hoàn tiền chuyển khoản nhanh nhất.
                    </div>
                    <div class="mb-3">
                        <label for="resubmitBankName" class="form-label small fw-semibold">Tên ngân hàng <span class="text-danger">*</span></label>
                        <input type="text" id="resubmitBankName" class="form-control" placeholder="VD: Vietcombank, Techcombank, MB..." required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label for="resubmitAccountNumber" class="form-label small fw-semibold">Số tài khoản nhận tiền <span class="text-danger">*</span></label>
                        <input type="text" id="resubmitAccountNumber" class="form-control" placeholder="Nhập số tài khoản ngân hàng" required maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label for="resubmitAccountHolderName" class="form-label small fw-semibold">Tên chủ tài khoản <span class="text-danger">*</span></label>
                        <input type="text" id="resubmitAccountHolderName" class="form-control text-uppercase" placeholder="VD: NGUYEN VAN A" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label for="resubmitReason" class="form-label small fw-semibold">Ghi chú bổ sung (tùy chọn)</label>
                        <textarea id="resubmitReason" class="form-control" rows="2" placeholder="Ghi chú thêm cho Ban quản trị..." maxlength="500"></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" id="btnSubmitResubmitRefund" class="btn btn-danger fw-bold" onclick="submitResubmitRefund()">
                        <i class="fa fa-paper-plane me-1"></i> Gửi lại yêu cầu
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const orderId = @orderId;
    const orderDetailMessage = document.getElementById("orderDetailMessage");
    const orderDetailContent = document.getElementById("orderDetailContent");

    document.addEventListener("DOMContentLoaded", function() {
        loadOrderDetail();
    });

    async function loadOrderDetail() {
        try {
            const response = await fetch(`/api/orders/${orderId}`, {
                method: "GET",
                credentials: "include"
            });

            if (response.status === 401) {
                window.location.href = "/account/login";
                return;
            }

            if (response.status === 404) {
                orderDetailContent.innerHTML = `
                        <div class="alert alert-warning">
                            Không tìm thấy đơn hàng.
                        </div>
                    `;
                return;
            }

            if (!response.ok) {
                orderDetailContent.innerHTML = `
                        <div class="alert alert-danger">
                            Không thể tải chi tiết đơn hàng.
                        </div>
                    `;
                return;
            }

            const result = await response.json();
            const order = result.orderDetails || result.OrderDetails || result.data || result;

            if (!order || !order.orderId) {
                orderDetailContent.innerHTML = `
                        <div class="alert alert-warning">
                            ${result.message || "Không tìm thấy chi tiết đơn hàng."}
                        </div>
                    `;
                return;
            }

            renderOrderDetail(order);
            await loadCustomerRefundStatus(order.orderId);

            if (window.location.hash === "#cancel" && order.orderStatus === "Pending") {
                openCancelModal(order.orderId, order.paymentStatus);
            }

        } catch (error) {
            console.error(error);

            orderDetailContent.innerHTML = `
                    <div class="alert alert-danger">
                        Có lỗi xảy ra khi tải chi tiết đơn hàng.
                    </div>
                `;
        }
    }

    function renderOrderDetail(order) {
        const items = order.items || [];

        orderDetailContent.innerHTML = `
                <div class="row">
                    <div class="col-lg-7">
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-header bg-dark text-white">
                                <h5 class="mb-0">Thông tin đơn hàng</h5>
                            </div>

                            <div class="card-body">
                                <p>
                                    <strong>Mã đơn:</strong>
                                    ${order.orderCode || ""}
                                </p>

                                <p>
                                    <strong>Ngày đặt:</strong>
                                    ${formatDate(order.createdAt)}
                                </p>

                                <p>
                                    <strong>Trạng thái đơn:</strong>
                                    ${renderOrderStatus(order.orderStatus)}
                                </p>

                                <p>
                                    <strong>Trạng thái thanh toán:</strong>
                                    ${renderPaymentStatus(order.paymentStatus)}
                                </p>

                                <p>
                                    <strong>Phương thức thanh toán:</strong>
                                    ${order.paymentMethod || "COD"}
                                </p>
                            </div>
                        </div>

                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Sản phẩm trong đơn</h5>
                            </div>

                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table align-middle">
                                        <thead>
                                            <tr>
                                                <th>Sản phẩm</th>
                                                <th class="text-center">SL</th>
                                                <th class="text-end">Đơn giá</th>
                                                <th class="text-end">Thành tiền</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            ${renderOrderItems(items)}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-5">
                        <div class="card shadow-sm border-0 mb-4">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Thông tin nhận hàng</h5>
                            </div>

                            <div class="card-body">
                                <p>
                                    <strong>Người nhận:</strong>
                                    ${escapeHtml(order.receiverName)}
                                </p>

                                <p>
                                    <strong>Số điện thoại:</strong>
                                    ${escapeHtml(order.receiverPhone)}
                                </p>

                                <p>
                                    <strong>Địa chỉ:</strong>
                                    ${escapeHtml(order.shippingAddress)}
                                </p>

                                <p>
                                    <strong>Ghi chú:</strong>
                                    ${escapeHtml(order.note || "Không có")}
                                </p>
                            </div>
                        </div>

                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-light">
                                <h5 class="mb-0">Tổng kết thanh toán</h5>
                            </div>

                            <div class="card-body">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>Tạm tính</span>
                                    <strong>${formatCurrency(order.totalAmount)}</strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Giảm giá</span>
                                    <strong>${formatCurrency(order.discountAmount)}</strong>
                                </div>

                                <div class="d-flex justify-content-between mb-2">
                                    <span>Phí vận chuyển</span>
                                    <strong>${formatCurrency(order.shippingFee)}</strong>
                                </div>

                                <hr />

                                <div class="d-flex justify-content-between fs-5">
                                    <span>Tổng thanh toán</span>
                                    <strong>${formatCurrency(order.finalAmount)}</strong>
                                </div>

                                ${renderOrderActions(order)}
                                <div id="customerRefundSection"></div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
    }

    function renderOrderItems(items) {
        if (!items || items.length === 0) {
            return `
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">
                            Không có sản phẩm trong đơn.
                        </td>
                    </tr>
                `;
        }

        return items.map(item => `
                <tr>
                    <td>
                        <div class="d-flex align-items-center gap-3">
                            ${item.imageUrl ? `<img src="${item.imageUrl}" alt="${escapeHtml(item.productNameSnapshot)}" style="width: 48px; height: 48px; object-fit: cover; border-radius: 4px; border: 1px solid #dee2e6;" />` : `<div style="width: 48px; height: 48px; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px; display: flex; align-items: center; justify-content: center;"><i class="fa fa-box text-muted"></i></div>`}
                            <div>
                                <span class="fw-bold">${escapeHtml(item.productNameSnapshot || "")}</span>
                            </div>
                        </div>
                    </td>

                    <td class="text-center">
                        ${item.quantity || 0}
                    </td>

                    <td class="text-end">
                        ${formatCurrency(item.unitPrice)}
                    </td>

                    <td class="text-end">
                        <strong>${formatCurrency(item.lineTotal)}</strong>
                    </td>
                </tr>
            `).join("");
    }

    function formatCurrency(value) {
        return new Intl.NumberFormat("vi-VN", {
            style: "currency",
            currency: "VND"
        }).format(value || 0);
    }

    function formatDate(value) {
        if (!value) return "";

        const date = new Date(value);

        return date.toLocaleDateString("vi-VN") + " " + date.toLocaleTimeString("vi-VN", {
            hour: "2-digit",
            minute: "2-digit"
        });
    }

    function renderOrderStatus(status) {
        const value = status || "Pending";

        let badgeClass = "bg-secondary";

        if (value === "Pending") badgeClass = "bg-warning text-dark";
        if (value === "Confirmed") badgeClass = "bg-primary";
        if (value === "Shipped") badgeClass = "bg-info text-dark";
        if (value === "Completed") badgeClass = "bg-success";
        if (value === "Cancelled") badgeClass = "bg-danger";

        return `<span class="badge ${badgeClass}">${value}</span>`;
    }

    function renderPaymentStatus(status) {
        const value = status || "Unpaid";

        let badgeClass = "bg-secondary";
        let text = value;

        if (value === "Unpaid") { badgeClass = "bg-warning text-dark"; text = "Chưa thanh toán"; }
        if (value === "Pending") { badgeClass = "bg-warning text-dark"; text = "Chờ TT Online"; }
        if (value === "Paid") { badgeClass = "bg-success"; text = "Đã thanh toán"; }
        if (value === "Failed") { badgeClass = "bg-danger"; text = "Thất bại"; }
        if (value === "RefundPending") { badgeClass = "bg-info text-dark"; text = "Chờ hoàn tiền"; }
        if (value === "Refunded") { badgeClass = "bg-dark text-white"; text = "Đã hoàn tiền"; }

        return `<span class="badge ${badgeClass}">${text}</span>`;
    }

    // ==========================================
    // HÀNH ĐỘNG ĐƠN HÀNG & HỦY ĐƠN / HOÀN TIỀN
    // ==========================================
    let currentRefundOrderId = 0;
    let currentCancelOrderId = 0;
    let currentCancelPaymentStatus = "";
    let currentRequestCancelOrderId = 0;

    function renderOrderActions(order) {
        let html = "";

        if (order.orderStatus === "Pending") {
            html += `
                <div class="mt-3 pt-3 border-top">
                    <button type="button" class="btn btn-outline-danger w-100 py-2 fw-bold" onclick="openCancelModal(${order.orderId}, '${order.paymentStatus}')">
                        <i class="fa fa-times-circle me-1"></i> Hủy đơn hàng
                    </button>
                </div>
            `;
        } else if (order.orderStatus === "Confirmed") {
            const hasRequested = order.note && order.note.includes("[Yêu cầu hủy]");
            if (hasRequested) {
                html += `
                    <div class="alert alert-warning mt-3 mb-0 small">
                        <h6 class="alert-heading mb-1 fw-bold"><i class="fa fa-clock me-1"></i> Đang chờ duyệt hủy</h6>
                        Yêu cầu hủy đơn hàng của bạn đang được Ban quản trị xem xét.
                    </div>
                `;
            } else {
                html += `
                    <div class="mt-3 pt-3 border-top">
                        <button type="button" class="btn btn-outline-warning text-dark w-100 py-2 fw-bold" onclick="openRequestCancelModal(${order.orderId})">
                            <i class="fa fa-ban me-1"></i> Yêu cầu hủy đơn hàng
                        </button>
                    </div>
                `;
            }
        }

        if (order.paymentStatus === "Paid" && order.orderStatus === "Completed") {
            html += `
                <div class="mt-3 pt-3 border-top">
                    <button type="button" class="btn btn-outline-danger w-100 py-2 fw-bold" onclick="openRefundModal(${order.orderId}, ${order.finalAmount})">
                        <i class="fa fa-undo me-1"></i> Yêu cầu hoàn tiền
                    </button>
                </div>
            `;
        }

        return html;
    }

    function openCancelModal(orderId, paymentStatus) {
        currentCancelOrderId = orderId;
        currentCancelPaymentStatus = paymentStatus;
        document.getElementById("cancelOrderModalMessage").innerHTML = "";
        document.getElementById("cancelReasonSelect").value = "Đổi ý không muốn mua nữa";
        document.getElementById("customCancelReason").value = "";
        document.getElementById("customCancelReason").classList.add("d-none");

        const refundFields = document.getElementById("cancelRefundFields");
        if (paymentStatus === "Paid") {
            refundFields.classList.remove("d-none");
        } else {
            refundFields.classList.add("d-none");
        }

        const modal = new bootstrap.Modal(document.getElementById("cancelOrderModal"));
        modal.show();
    }

    function toggleCustomCancelReason(select) {
        const customText = document.getElementById("customCancelReason");
        if (select.value === "Lý do khác") {
            customText.classList.remove("d-none");
            customText.focus();
        } else {
            customText.classList.add("d-none");
        }
    }

    async function submitCancelOrder() {
        const select = document.getElementById("cancelReasonSelect");
        const custom = document.getElementById("customCancelReason");
        let reason = select.value;
        const customText = custom.value.trim();

        if (select.value === "Lý do khác") {
            if (!customText) {
                document.getElementById("cancelOrderModalMessage").innerHTML = `<div class="alert alert-danger py-2">Vui lòng nhập chi tiết lý do hủy đơn.</div>`;
                custom.focus();
                return;
            }
            reason = customText;
        } else if (customText) {
            reason = `${select.value} (${customText})`;
        }

        const msgDiv = document.getElementById("cancelOrderModalMessage");
        const btn = document.getElementById("btnSubmitCancel");

        let bankName = "";
        let accountNumber = "";
        let accountHolderName = "";

        if (currentCancelPaymentStatus === "Paid") {
            bankName = document.getElementById("cancelBankName").value.trim();
            accountNumber = document.getElementById("cancelAccountNumber").value.trim();
            accountHolderName = document.getElementById("cancelAccountHolderName").value.trim();

            if (!bankName || !accountNumber || !accountHolderName) {
                msgDiv.innerHTML = `<div class="alert alert-danger py-2">Vui lòng nhập đầy đủ thông tin tài khoản ngân hàng để nhận tiền hoàn.</div>`;
                return;
            }
        }

        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Đang xử lý...`;

        try {
            const res = await fetch(`/api/orders/cancel/${currentCancelOrderId}`, {
                method: "POST",
                credentials: "include",
                headers: { "Content-Type": "application/json", "Accept": "application/json" },
                body: JSON.stringify({
                    reason: reason,
                    bankName: bankName || null,
                    accountNumber: accountNumber || null,
                    accountHolderName: accountHolderName || null
                })
            });

            const result = await res.json();
            if (!res.ok || !result.success) {
                throw new Error(result.message || "Hủy đơn hàng thất bại.");
            }

            msgDiv.innerHTML = `<div class="alert alert-success py-2">${result.message}</div>`;
            setTimeout(() => {
                const modal = bootstrap.Modal.getInstance(document.getElementById("cancelOrderModal"));
                if (modal) modal.hide();
                loadOrderDetail();
            }, 1200);
        } catch (e) {
            msgDiv.innerHTML = `<div class="alert alert-danger py-2">${e.message || "Có lỗi xảy ra"}</div>`;
        } finally {
            btn.disabled = false;
            btn.innerHTML = `<i class="fa fa-times-circle me-1"></i> Xác nhận hủy đơn`;
        }
    }

    function openRequestCancelModal(orderId) {
        currentRequestCancelOrderId = orderId;
        document.getElementById("requestCancelReason").value = "";
        document.getElementById("requestCancelModalMessage").innerHTML = "";
        const modal = new bootstrap.Modal(document.getElementById("requestCancelModal"));
