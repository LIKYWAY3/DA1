                        </div>
                    </div>

                    <!-- Danh sách sản phẩm trong đơn (kèm nút Mua lại) -->
                    <div class="d-flex flex-column gap-3 mb-4">
                        ${items.map(item => `
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 p-2 rounded-2 bg-light border">
                                <div class="d-flex align-items-center gap-3">
                                    <img src="${item.imageUrl || '/images/products/product-1.png'}" 
                                         alt="${escapeHtml(item.productNameSnapshot)}" 
                                         class="order-detail-thumb rounded-2 border" 
                                         onerror="this.src='/images/products/product-1.png'" />
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1 fs-6">${escapeHtml(item.productNameSnapshot || '')}</h6>
                                        <div class="text-danger fw-semibold font-monospace small">${formatCurrency(item.unitPrice)}</div>
                                    </div>
                                </div>
                                <div class="d-flex align-items-center justify-content-between justify-content-md-end gap-3 flex-shrink-0">
                                    <span class="text-muted small">Số lượng: <strong class="text-dark">${item.quantity}</strong></span>
                                    <button type="button" class="btn-buy-again" onclick="buyAgain(${item.productId})">
                                        Mua lại
                                    </button>
                                </div>
                            </div>
                        `).join('')}
                    </div>

                    <!-- Thanh tiến trình Stepper Timeline -->
                    <div class="pt-3 border-top">
                        ${renderOrderStepper(order)}
                    </div>
                </div>

                <!-- 2. BỐ CỤC 2 CỘT: THÔNG TIN KHÁCH HÀNG & THÔNG TIN THANH TOÁN -->
                <div class="row g-4">
                    
                    <!-- CỘT TRÁI: THÔNG TIN KHÁCH HÀNG (ĐÃ BỎ BẢO HÀNH & HỖ TRỢ THEO YÊU CẦU) -->
                    <div class="col-12 col-lg-6">
                        <div class="card bg-white border rounded-3 p-4 shadow-sm h-100">
                            <h6 class="fw-bold text-dark pb-2 mb-3 border-bottom fs-6">
                                <i class="fa-solid fa-user me-2 text-secondary"></i>Thông tin khách hàng
                            </h6>

                            <div class="d-flex flex-column gap-2 small">
                                <div class="d-flex justify-content-between py-1 border-bottom border-light">
                                    <span class="text-muted">Họ và tên:</span>
                                    <strong class="text-dark">${escapeHtml(order.receiverName)}</strong>
                                </div>
                                <div class="d-flex justify-content-between py-1 border-bottom border-light">
                                    <span class="text-muted">Số điện thoại:</span>
                                    <strong class="text-dark font-monospace">${escapeHtml(order.receiverPhone)}</strong>
                                </div>
                                <div class="py-1 border-bottom border-light">
                                    <div class="text-muted mb-1">Địa chỉ nhận hàng:</div>
                                    <strong class="text-dark d-block">${escapeHtml(order.shippingAddress)}</strong>
                                </div>
                                <div class="py-1">
                                    <div class="text-muted mb-1">Ghi chú đơn hàng:</div>
                                    <span class="text-dark">${escapeHtml(order.note || '-')}</span>
                                </div>
                            </div>

                            <!-- Hành động đơn hàng (Hủy đơn hàng / Yêu cầu hủy) -->
                            ${renderOrderActions(order)}
                            
                            <!-- Trạng thái hoàn tiền (nếu có) -->
                            <div id="customerRefundSection"></div>
                        </div>
                    </div>

                    <!-- CỘT PHẢI: THÔNG TIN THANH TOÁN -->
                    <div class="col-12 col-lg-6">
                        <div class="card bg-white border rounded-3 p-4 shadow-sm h-100">
                            <h6 class="fw-bold text-dark pb-2 mb-3 border-bottom fs-6">
                                <i class="fa-solid fa-credit-card me-2 text-secondary"></i>Thông tin thanh toán
                            </h6>

                            <!-- Nhóm 1: Sản phẩm -->
                            <div class="mb-3">
                                <div class="fw-semibold text-secondary x-small text-uppercase mb-2">Sản phẩm</div>
                                <div class="d-flex justify-content-between py-1 small">
                                    <span class="text-muted">Số lượng sản phẩm:</span>
                                    <strong class="text-dark">${totalQuantity}</strong>
                                </div>
                                <div class="d-flex justify-content-between py-1 small">
                                    <span class="text-muted">Tổng tiền hàng:</span>
                                    <strong class="text-dark">${formatCurrency(order.totalAmount)}</strong>
                                </div>
                                <div class="d-flex justify-content-between py-1 small">
                                    <span class="text-muted">Giảm giá:</span>
                                    <span class="text-success fw-semibold">-${formatCurrency(order.discountAmount)}</span>
                                </div>
