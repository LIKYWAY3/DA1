        // =========================
        // THÔNG BÁO
        // =========================

        function showCheckoutMessage(
            message,
            type
        ) {
            const checkoutMessage =
                document.getElementById(
                    "checkoutMessage"
                );

            checkoutMessage.innerHTML = "";

            const alert =
                document.createElement("div");

            alert.className =
                `alert alert-${type}`;

            alert.textContent =
                message;

            checkoutMessage.appendChild(alert);
        }

        function showSummaryError(message) {
            document.getElementById(
                "checkout-summary-loading"
            )?.classList.add("d-none");

            const errorElement =
                document.getElementById(
                    "checkout-summary-error"
                );

            errorElement.textContent =
                message;

            errorElement.classList.remove(
                "d-none"
            );
        }

        // =========================
        // HELPERS
        // =========================

        async function readJsonResponse(response) {
            const contentType =
                response.headers.get(
                    "content-type"
                ) ?? "";

            if (
                !contentType.includes(
                    "application/json"
                )
            ) {
                return null;
            }

            try {
                return await response.json();
            }
            catch {
                return null;
            }
        }

        function formatCurrency(value) {
            return new Intl.NumberFormat(
                "vi-VN",
                {
                    style: "currency",
                    currency: "VND"
                }
            ).format(Number(value) || 0);
        }

        // =========================
        // CHECKOUT COUPON
        // =========================
        function autoApplyCouponIfSaved() {
            const savedCoupon = sessionStorage.getItem("appliedCouponCode");
            if (savedCoupon && !appliedCheckoutCouponCode) {
                const couponInput = document.getElementById("checkout-coupon-code");
                if (couponInput) {
                    couponInput.value = savedCoupon;
                    applyCheckoutCoupon();
                }
            }
        }

        async function applyCheckoutCoupon() {
            const input = document.getElementById("checkout-coupon-code");
            const btn = document.getElementById("btn-apply-checkout-coupon");
            const code = input ? input.value.trim().toUpperCase() : "";

            if (!code) {
                showCheckoutCouponMessage("Vui lòng nhập mã giảm giá", "warning");
                if (input) input.focus();
                return;
            }

            if (currentCheckoutSubtotal <= 0 && selectedCheckoutItems && selectedCheckoutItems.length > 0) {
                currentCheckoutSubtotal = selectedCheckoutItems.reduce((acc, item) => acc + (Number(item.unitPrice) || 0) * (Number(item.quantity) || 1), 0);
            }

            if (currentCheckoutSubtotal <= 0) {
                showCheckoutCouponMessage("Không có sản phẩm nào để tính giảm giá", "warning");
                return;
            }

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Đang xử lý...';
            }

            try {
                const response = await fetch("/api/coupons/apply", {
                    method: "POST",
                    credentials: "include",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify({
                        couponCode: code,
                        subtotal: currentCheckoutSubtotal,
                        cartItemIds: selectedCartItemIds
                    })
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    showCheckoutCouponMessage(data.message || "Mã giảm giá không hợp lệ", "danger");
                    removeCheckoutCoupon(false);
                    return;
                }

                appliedCheckoutCouponCode = data.couponCode;
                appliedCheckoutDiscount = Number(data.discountAmount) || 0;
                sessionStorage.setItem("appliedCouponCode", data.couponCode);

                // Cập nhật dòng chiết khấu
                const discountRow = document.getElementById("checkout-discount-row");
                const discountAmountEl = document.getElementById("checkout-discount-amount");
                if (discountRow && discountAmountEl) {
                    discountAmountEl.textContent = `- ${formatCurrency(appliedCheckoutDiscount)}`;
                    discountRow.classList.remove("d-none");
                }

                // Cập nhật tổng thanh toán
                const grandTotalEl = document.getElementById("checkout-grand-total");
                if (grandTotalEl) {
                    grandTotalEl.textContent = formatCurrency(Math.max(currentCheckoutSubtotal - appliedCheckoutDiscount, 0));
                }

                showCheckoutCouponMessage(`
                    <div class="d-flex justify-content-between align-items-center text-success">
                        <span><i class="fa fa-check-circle text-success me-1"></i> Đã áp dụng <strong>${data.couponCode}</strong> (-${formatCurrency(appliedCheckoutDiscount)})</span>
                        <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" onclick="removeCheckoutCoupon(true)">Xóa</button>
                    </div>
                `, "success");

            } catch (err) {
                showCheckoutCouponMessage("Lỗi mạng khi kiểm tra mã giảm giá", "danger");
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = "Áp dụng";
                }
            }
        }
        window.applyCheckoutCoupon = applyCheckoutCoupon;

        function removeCheckoutCoupon(clearInput = true) {
            appliedCheckoutCouponCode = "";
            appliedCheckoutDiscount = 0;
            sessionStorage.removeItem("appliedCouponCode");

            const discountRow = document.getElementById("checkout-discount-row");
            if (discountRow) {
                discountRow.classList.add("d-none");
            }

            const grandTotalEl = document.getElementById("checkout-grand-total");
            if (grandTotalEl) {
                grandTotalEl.textContent = formatCurrency(currentCheckoutSubtotal);
            }

            if (clearInput) {
                const input = document.getElementById("checkout-coupon-code");
                if (input) input.value = "";
                const msgBox = document.getElementById("checkout-coupon-message");
                if (msgBox) msgBox.innerHTML = "";
            }
        }
        window.removeCheckoutCoupon = removeCheckoutCoupon;

        function showCheckoutCouponMessage(msg, type = "info") {
            const msgBox = document.getElementById("checkout-coupon-message");
            if (!msgBox) return;
            msgBox.innerHTML = `<div class="alert alert-${type} py-1 px-2 mb-0 small">${msg}</div>`;
        }
    </script>
}