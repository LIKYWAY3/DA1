        function clearModalCouponInput() {
            const input = document.getElementById("modal-coupon-input");
            if (input) {
                input.value = "";
                handleCouponInput("");
                input.focus();
            }
        }

        async function applyManualCoupon() {
            const input = document.getElementById("modal-coupon-input");
            const code = (input?.value || "").trim().toUpperCase();
            if (!code) {
                showModalAlert("Vui lòng nhập mã khuyến mãi.", "warning");
                return;
            }
            await executeApplyCoupon(code, false);
        }

        async function loadAvailableCoupons() {
            const listContainer = document.getElementById("coupon-cards-list");
            if (!listContainer) return;

            listContainer.innerHTML = '<div class="text-center py-4 text-muted small"><span class="spinner-border spinner-border-sm me-2"></span> Đang tải danh sách ưu đãi...</div>';

            try {
                const res = await fetch("/api/coupons/available", { credentials: "include" });
                if (!res.ok) throw new Error("Không tải được danh sách mã.");

                availableCoupons = await res.json();
                renderCouponCards(listContainer, availableCoupons, currentCheckoutSubtotal);
            } catch (err) {
                listContainer.innerHTML = `
                    <div class="text-center py-4 text-muted small">
                        Hiện chưa có danh sách mã công khai. Bạn có thể nhập mã trực tiếp ở ô trên.
                    </div>
                `;
            }
        }

        function renderCouponCards(container, coupons, subtotal) {
            if (!Array.isArray(coupons) || coupons.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-4 text-muted small">
                        Hiện chưa có mã khuyến mãi công khai. Vui lòng nhập mã ở ô trên.
                    </div>
                `;
                return;
            }

            const currentCode = sessionStorage.getItem("appliedCouponCode");
            currentlySelectedCouponCode = currentCode;

            let html = "";
            coupons.forEach((c, index) => {
                const isEligible = subtotal >= c.minOrderAmount;
                const isSelected = currentlySelectedCouponCode === c.code;

                let discountText = "";
                let calcDiscount = 0;
                if (c.discountType === "Percentage" || c.discountType === "Percent") {
                    calcDiscount = subtotal * (c.discountValue / 100);
                    if (c.maxDiscountAmount && calcDiscount > c.maxDiscountAmount) calcDiscount = c.maxDiscountAmount;
                    discountText = `Giảm ${c.discountValue}%${c.maxDiscountAmount ? ' tối đa ' + formatCurrency(c.maxDiscountAmount) : ''}`;
                } else {
                    calcDiscount = c.discountValue;
                    discountText = `Giảm ${formatCurrency(c.discountValue)}`;
                }

                if (isSelected) {
                    currentlySelectedDiscountAmount = calcDiscount;
                }

                const expiryFormatted = c.endDate ? new Date(c.endDate).toLocaleDateString('vi-VN') : 'Vô thời hạn';
                const disabledClass = isEligible ? "" : "disabled";
                const selectedClass = isSelected ? "selected" : "";
                const isBestChoice = index === 0 && isEligible;

                html += `
                    <div class="coupon-ticket-card ${disabledClass} ${selectedClass}" 
                         data-coupon-code="${escapeAttribute(c.code)}" 
                         data-discount-amount="${calcDiscount}"
                         data-eligible="${isEligible}" 
                         onclick="selectCouponCard('${escapeAttribute(c.code)}', ${calcDiscount}, ${isEligible})">
                        ${isBestChoice ? `<span class="badge-best-choice">Lựa chọn tốt nhất</span>` : ''}
                        
                        <div class="coupon-badge-square">
                            <i class="fa fa-gift"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="fw-bold text-dark" style="font-size: 0.95rem;">${escapeHtml(c.code)}</span>
                                <input type="radio" name="couponRadio" class="form-check-input custom-checkbox" ${isSelected ? 'checked' : ''} ${isEligible ? '' : 'disabled'}>
                            </div>
                            <div>
                                <span class="coupon-discount-tag">${discountText}</span>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mt-1" style="font-size: 0.78rem;">
                                <a href="javascript:void(0)" class="text-decoration-none fw-semibold" style="color: #253f36;">Xem thể lệ</a>
                                <span class="text-muted">HSD: ${expiryFormatted}</span>
                            </div>
                            ${!isEligible ? `<div class="text-muted mt-1 small" style="font-size: 0.75rem;">Sản phẩm bạn chọn chưa đủ điều kiện áp dụng (${formatCurrency(c.minOrderAmount)}).</div>` : ''}
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
            updateModalSummaryText();
        }

        function selectCouponCard(code, discountAmount, isEligible) {
            if (!isEligible) return;

            currentlySelectedCouponCode = code;
            currentlySelectedDiscountAmount = discountAmount || 0;

            document.querySelectorAll(".coupon-ticket-card").forEach(card => {
                if (card.dataset.couponCode === code) {
                    card.classList.add("selected");
                    const radio = card.querySelector("input[type='radio']");
                    if (radio) radio.checked = true;
                } else {
                    card.classList.remove("selected");
                    const radio = card.querySelector("input[type='radio']");
                    if (radio) radio.checked = false;
                }
            });

            updateModalSummaryText();
        }

        function updateModalSummaryText() {
            const line1 = document.getElementById("summary-line-1");
            const line2 = document.getElementById("summary-line-2");

            if (currentlySelectedCouponCode) {
                if (line1) line1.innerHTML = `Đã chọn: <strong style="color: #253f36;">${escapeHtml(currentlySelectedCouponCode)}</strong>`;
                if (line2) {
                    line2.style.display = "block";
                    line2.innerHTML = `Bạn tiết kiệm được <strong>${formatCurrency(currentlySelectedDiscountAmount)}</strong>`;
                }
            } else {
                if (line1) line1.textContent = "Chưa chọn ưu đãi nào.";
                if (line2) line2.style.display = "none";
            }
        }

        async function confirmSelectedCoupon() {
            if (!currentlySelectedCouponCode) {
                // Hủy chọn mã
                appliedCouponCode = "";
                appliedCheckoutDiscount = 0;
                sessionStorage.removeItem("appliedCouponCode");
                updateCouponSummaryUI();
                recalculateTotals();

                const modalEl = document.getElementById("couponModal");
                if (modalEl && window.bootstrap) {
                    bootstrap.Modal.getInstance(modalEl)?.hide();
                }
                return;
            }

            await executeApplyCoupon(currentlySelectedCouponCode, false);
        }

        async function executeApplyCoupon(code, isSilent = false) {
            const confirmBtn = document.getElementById("modal-confirm-coupon-btn");
            if (confirmBtn && !isSilent) {
                confirmBtn.disabled = true;
                confirmBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xử lý...';
            }

            try {
                const res = await fetch("/api/coupons/apply", {
                    method: "POST",
                    credentials: "include",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify({
                        couponCode: code,
                        subtotal: currentCheckoutSubtotal,
                        cartItemIds: selectedCartItemIds
                    })
                });

                const data = await res.json();

                if (!res.ok || !data.success) {
                    if (!isSilent) {
                        showModalAlert(data.message || "Mã giảm giá không hợp lệ.", "danger");
                    }
                    return;
                }

                // Lưu mã và cập nhật UI Checkout
                sessionStorage.setItem("appliedCouponCode", data.couponCode);
                appliedCouponCode = data.couponCode;
                appliedCheckoutDiscount = data.discountAmount;
                currentlySelectedDiscountAmount = data.discountAmount;

                updateCouponSummaryUI();
                recalculateTotals();

                // Đóng modal
                if (!isSilent) {
                    const modalEl = document.getElementById("couponModal");
                    if (modalEl && window.bootstrap) {
                        bootstrap.Modal.getInstance(modalEl)?.hide();
                    }
                }

            } catch (err) {
                if (!isSilent) {
                    showModalAlert("Lỗi kết nối khi kiểm tra mã.", "danger");
                }
            } finally {
                if (confirmBtn && !isSilent) {
                    confirmBtn.disabled = false;
                    confirmBtn.textContent = "Xác nhận";
                }
            }
        }

        function restoreSavedCouponUI() {
            updateCouponSummaryUI();
        }

        function updateCouponSummaryUI() {
            const textEl = document.getElementById("summary-coupon-text");
            const btnEl = document.getElementById("summary-coupon-btn");

            if (appliedCouponCode && textEl && btnEl) {
                textEl.innerHTML = `Mã: <strong style="color: #253f36;">${escapeHtml(appliedCouponCode)}</strong> (Đã áp dụng)`;
                btnEl.textContent = "Đổi mã";
            } else if (textEl && btnEl) {
                textEl.textContent = "Áp dụng mã giảm giá";
                btnEl.textContent = "Chọn";
            }
        }

        function showModalAlert(msg, type = "info") {
            const alertBox = document.getElementById("modal-coupon-alert");
            if (!alertBox) return;
            alertBox.innerHTML = `
                <div class="alert alert-${type} py-2 mb-3 small" role="alert">
                    ${msg}
                </div>
            `;
        }

        // ==========================================
        // 6. XÁC NHẬN ĐẶT HÀNG & GỬI FORM CHECKOUT
        // ==========================================
        async function processCheckoutSubmit() {
            clearCheckoutAlert();

            if (isNewAddressMode) {
                syncNewAddressToHidden();
            } else {
                syncReceiverInputs();
            }

            const receiverName = (document.getElementById("receiverName")?.value || "").trim();
            const receiverPhone = (document.getElementById("receiverPhone")?.value || "").trim();
            const shippingAddress = (document.getElementById("shippingAddress")?.value || "").trim();
            const paymentMethod = document.getElementById("paymentMethod")?.value || "COD";
            const note = (document.getElementById("orderNote")?.value || "").trim();

            if (!receiverName) {
                showCheckoutAlert("Vui lòng nhập tên người nhận hàng.", "danger");
                document.getElementById("inputReceiverName")?.focus();
                return;
            }

            if (!receiverPhone) {
                showCheckoutAlert("Vui lòng nhập số điện thoại người nhận hàng.", "danger");
                document.getElementById("inputReceiverPhone")?.focus();
                return;
            }

            if (!shippingAddress) {
                showCheckoutAlert("Vui lòng cung cấp đầy đủ thông tin địa chỉ nhận hàng.", "danger");
                return;
            }

            const submitBtn = document.getElementById("btnSubmitOrder");
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span> ĐANG XỬ LÝ...';

            // Nếu người dùng chọn lưu địa chỉ mới vào profile cho lần mua tiếp theo
            const shouldSaveAddr = isNewAddressMode && document.getElementById("checkSaveAddressForNextTime")?.checked;
            if (shouldSaveAddr) {
                saveNewAddressToProfile(receiverName, receiverPhone, shippingAddress);
            }

            const payload = {
                receiverName: receiverName,
                receiverPhone: receiverPhone,
                shippingAddress: shippingAddress,
                note: note,
                paymentMethod: paymentMethod,
                couponCode: appliedCouponCode || null,
                cartItemIds: selectedCartItemIds
            };

            try {
                const response = await fetch("/api/orders/checkout", {
                    method: "POST",
                    credentials: "include",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify(payload)
                });

                if (response.status === 401) {
                    window.location.href = `/account/login?returnUrl=${encodeURIComponent(window.location.pathname)}`;
                    return;
                }

                const result = await response.json();

                if (!response.ok || result?.success === false) {
                    throw new Error(result?.message || result?.error || "Đặt hàng thất bại. Vui lòng thử lại.");
                }

                // Xóa session storage
                sessionStorage.removeItem(selectedCartItemsStorageKey);
                sessionStorage.removeItem("appliedCouponCode");

                // Nếu có cổng thanh toán online cần redirect
                if (result?.requiresRedirect && result?.paymentUrl) {
                    window.location.href = result.paymentUrl;
                    return;
                }

                // Chuyển sang trang Success
                const orderCode = result?.orderCode || "";
                window.location.href = `/checkout/success?orderCode=${encodeURIComponent(orderCode)}`;
            } catch (err) {
                console.error("Lỗi đặt hàng:", err);
                showCheckoutAlert(err?.message || "Có lỗi xảy ra khi tạo đơn hàng. Vui lòng thử lại.", "danger");
                submitBtn.disabled = false;
                submitBtn.textContent = "THANH TOÁN";
            }
        }

        async function saveNewAddressToProfile(name, phone, address) {
            try {
                await fetch("/api/user/addresses", {
                    method: "POST",
                    credentials: "include",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        fullName: name,
                        phoneNumber: phone,
                        specificAddress: address,
                        isDefault: false
                    })
                });
            } catch (e) {
                console.warn("Lưu địa chỉ nền không thành công:", e);
            }
        }

        // ==========================================
        // 7. TIỆN ÍCH INPUT & THÔNG BÁO
        // ==========================================
        function handleClearableInput(input) {
            const btn = input.parentElement.querySelector(".btn-clear-field");
            if (btn) {
                btn.style.display = (input.value || "").length > 0 ? "flex" : "none";
            }
        }

        function clearInput(inputId) {
            const input = document.getElementById(inputId);
            if (input) {
                input.value = "";
                handleClearableInput(input);
                input.focus();
            }
        }

        function showCheckoutAlert(msg, type = "danger") {
            const box = document.getElementById("checkoutAlertBox");
            if (!box) return;
            box.innerHTML = `
                <div class="alert alert-${type} py-2 mb-3 small" role="alert">
                    <i class="fa fa-circle-exclamation me-1"></i> ${escapeHtml(msg)}
                </div>
            `;
        }

        function clearCheckoutAlert() {
            const box = document.getElementById("checkoutAlertBox");
            if (box) box.innerHTML = "";
        }

        function formatCurrency(amount) {
            return new Intl.NumberFormat("vi-VN").format(Number(amount) || 0) + "<sup><u>đ</u></sup>";
        }

        function escapeHtml(val) {
            return String(val ?? "")
                .replaceAll("&", "&amp;")
                .replaceAll("<", "&lt;")
                .replaceAll(">", "&gt;")
                .replaceAll('"', "&quot;")
                .replaceAll("'", "&#039;");
        }

        function escapeAttribute(val) {
            return escapeHtml(val);
        }
    </script>
}
