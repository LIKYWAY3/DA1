@section Scripts {
    <script>
        const selectedCartItemsStorageKey = "selectedCartItemIds";

        let selectedCartItemIds = [];
        let selectedCheckoutItems = [];
        let currentCheckoutSubtotal = 0;
        let appliedCheckoutDiscount = 0;
        let appliedCouponCode = "";

        let userSavedAddresses = [];
        let currentSelectedAddress = null;
        let isNewAddressMode = false;
        let userProfileData = null;

        // Quản lý Modal Coupon (Chuẩn logic Cart)
        let availableCoupons = [];
        let currentlySelectedCouponCode = null;
        let currentlySelectedDiscountAmount = 0;

        document.addEventListener("DOMContentLoaded", async function() {
            // 1. Kiểm tra giỏ hàng có sản phẩm được chọn không
            const hasItems = loadSelectedCartItemIds();
            if (!hasItems) return;

            // 2. Tải song song danh sách sản phẩm và thông tin người dùng / địa chỉ
            await Promise.all([
                loadCheckoutProducts(),
                initUserProfileAndAddresses()
            ]);

            // 3. Khôi phục mã giảm giá từ sessionStorage (nếu đã chọn ở trang giỏ hàng)
            initSavedCoupon();
        });

        // ==========================================
        // 1. ĐỌC VÀ HIỂN THỊ SẢN PHẨM THANH TOÁN
        // ==========================================
        function loadSelectedCartItemIds() {
            try {
                const stored = sessionStorage.getItem(selectedCartItemsStorageKey);
                const parsed = JSON.parse(stored ?? "[]");

                if (!Array.isArray(parsed) || parsed.length === 0) {
                    showCheckoutAlert("Bạn chưa chọn sản phẩm nào để thanh toán. Đang chuyển hướng...", "warning");
                    setTimeout(() => window.location.href = "/cart", 1500);
                    return false;
                }

                selectedCartItemIds = [...new Set(parsed.map(Number).filter(n => Number.isInteger(n) && n > 0))];
                return true;
            } catch (err) {
                console.error("Lỗi đọc sản phẩm đã chọn:", err);
                window.location.href = "/cart";
                return false;
            }
        }

        async function loadCheckoutProducts() {
            const container = document.getElementById("checkout-products-list");
            const countEl = document.getElementById("checkout-product-count");

            try {
                const res = await fetch("/api/cart", {
                    method: "GET",
                    credentials: "include",
                    headers: { "Accept": "application/json" }
                });

                if (res.status === 401) {
                    window.location.href = `/account/login?returnUrl=${encodeURIComponent(window.location.pathname)}`;
                    return;
                }

                const data = await res.json();
                const cartItems = Array.isArray(data?.items) ? data.items : (Array.isArray(data?.data?.items) ? data.data.items : []);

                selectedCheckoutItems = cartItems.filter(item => selectedCartItemIds.includes(Number(item.cartItemId)));

                if (selectedCheckoutItems.length === 0) {
                    showCheckoutAlert("Các sản phẩm đã chọn không còn trong giỏ hàng. Đang quay lại...", "warning");
                    setTimeout(() => window.location.href = "/cart", 1500);
                    return;
                }

                renderCheckoutProducts(selectedCheckoutItems);
            } catch (err) {
                console.error("Lỗi tải sản phẩm thanh toán:", err);
                if (container) {
                    container.innerHTML = '<div class="alert alert-danger py-2 small mb-0">Không thể tải danh sách sản phẩm. Vui lòng thử lại.</div>';
                }
            }
        }

        function renderCheckoutProducts(items) {
            const container = document.getElementById("checkout-products-list");
            const countEl = document.getElementById("checkout-product-count");
            if (!container) return;

            let totalQty = 0;
            let subtotal = 0;
            let html = "";

            items.forEach(item => {
                const name = item.productName || "Sản phẩm FuuFishing";
                const img = item.thumbnailUrl || item.imageUrl || "/images/no-image.png";
                const unitPrice = Number(item.unitPrice) || 0;
                const originalPrice = Number(item.originalPrice) || 0;
                const qty = Number(item.quantity) || 1;
                const lineTotal = unitPrice * qty;

                totalQty += qty;
                subtotal += lineTotal;

                html += `
                    <div class="checkout-product-item">
                        <img src="${escapeHtml(img)}" alt="${escapeHtml(name)}" class="checkout-product-thumb" onerror="this.onerror=null;this.src='/images/no-image.png'">
                        <div class="checkout-product-info">
                            <div class="checkout-product-name" title="${escapeHtml(name)}">${escapeHtml(name)}</div>
                            <div class="checkout-product-qty">Số lượng: <strong>${qty}</strong></div>
                        </div>
                        <div class="checkout-product-prices">
                            <span class="checkout-price-current">${formatCurrency(lineTotal)}</span>
                            ${originalPrice > unitPrice ? `<span class="checkout-price-old">${formatCurrency(originalPrice * qty)}</span>` : ''}
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
            if (countEl) countEl.textContent = `${items.length} sản phẩm`;

            currentCheckoutSubtotal = subtotal;
            recalculateTotals(totalQty, subtotal);
        }

        function recalculateTotals(totalQty, subtotal) {
            if (totalQty === undefined) {
                totalQty = selectedCheckoutItems.reduce((acc, it) => acc + (Number(it.quantity) || 1), 0);
            }
            if (subtotal === undefined) {
                subtotal = currentCheckoutSubtotal;
            }

            // Phí vận chuyển: miễn phí với đơn >= 300.000đ, ngược lại 30.000đ
            const shippingFee = subtotal >= 300000 || subtotal === 0 ? 0 : 30000;
            const finalAmount = Math.max(subtotal - appliedCheckoutDiscount + shippingFee, 0);

            const totalQtyEl = document.getElementById("summary-total-qty");
            const subtotalEl = document.getElementById("summary-subtotal");
            const shippingEl = document.getElementById("summary-shipping-fee");
            const grandTotalEl = document.getElementById("summary-grand-total");
            const couponRow = document.getElementById("summary-coupon-discount-row");
            const couponDiscountEl = document.getElementById("summary-coupon-discount");
            const savedContainer = document.getElementById("summary-saved-container");
            const savedAmountEl = document.getElementById("summary-saved-amount");

            if (totalQtyEl) totalQtyEl.textContent = totalQty;
            if (subtotalEl) subtotalEl.innerHTML = formatCurrency(subtotal);

            if (shippingEl) {
                if (shippingFee === 0) {
                    shippingEl.innerHTML = '<span class="text-success fw-bold">Miễn phí</span>';
                } else {
                    shippingEl.innerHTML = formatCurrency(shippingFee);
                }
            }

            if (appliedCheckoutDiscount > 0) {
                if (couponRow) couponRow.style.display = "flex";
                if (couponDiscountEl) couponDiscountEl.innerHTML = `-${formatCurrency(appliedCheckoutDiscount)}`;
                if (savedContainer) savedContainer.style.display = "block";
                if (savedAmountEl) savedAmountEl.innerHTML = formatCurrency(appliedCheckoutDiscount);
            } else {
                if (couponRow) couponRow.style.display = "none";
                if (savedContainer) savedContainer.style.display = "none";
            }

            if (grandTotalEl) grandTotalEl.innerHTML = formatCurrency(finalAmount);
        }

        // ==========================================
        // 2. PROFILE & SỔ ĐỊA CHỈ (CHẾ ĐỘ SỔ & MỚI)
        // ==========================================
        async function initUserProfileAndAddresses() {
            try {
                // Tải thông tin tài khoản
                const profileRes = await fetch("/api/user/profile-info", { credentials: "include" });
                if (profileRes.ok) {
                    userProfileData = await profileRes.json();
                    renderCustomerInfo(userProfileData);
                }

                // Tải sổ địa chỉ
                const addrRes = await fetch("/api/user/addresses", { credentials: "include" });
                if (addrRes.ok) {
                    userSavedAddresses = await addrRes.json();
                }

                if (Array.isArray(userSavedAddresses) && userSavedAddresses.length > 0) {
                    // Có địa chỉ lưu -> Chọn địa chỉ mặc định
                    const defaultAddr = userSavedAddresses.find(a => a.isDefault) || userSavedAddresses[0];
                    selectSavedAddress(defaultAddr);
                    renderSavedAddressesDropdown();
                } else {
                    // Chưa có địa chỉ -> Chuyển sang chế độ nhập địa chỉ mới
                    switchToNewAddressMode();
                }
            } catch (err) {
                console.warn("Lỗi khởi tạo profile / địa chỉ:", err);
                switchToNewAddressMode();
            }
        }

        function renderCustomerInfo(profile) {
            const nameEl = document.getElementById("displayCustomerName");
            const phoneEl = document.getElementById("displayCustomerPhone");
            const emailInput = document.getElementById("customerEmail");

            if (nameEl) nameEl.textContent = profile.fullName || "Khách hàng FuuFishing";
            if (phoneEl) phoneEl.textContent = profile.phoneNumber ? `(+84) ${profile.phoneNumber}` : "Chưa cập nhật số điện thoại";
            if (emailInput && profile.email) {
                emailInput.value = profile.email;
                handleClearableInput(emailInput);
            }
        }

        function selectSavedAddress(addr) {
            if (!addr) return;
            currentSelectedAddress = addr;

            // Hiển thị ở Dropdown Button
            const displayBox = document.getElementById("selectedAddressDisplay");
            if (displayBox) {
                displayBox.innerHTML = `
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="fw-bold text-dark">${escapeHtml(addr.specificAddress.split(',')[0] || addr.specificAddress)}</span>
                        ${addr.isDefault ? '<span class="badge-default-addr">Mặc định</span>' : ''}
                    </div>
                    <div class="small text-secondary" style="line-height: 1.35;">${escapeHtml(addr.specificAddress)}</div>
                `;
            }

            // Điền tự động vào người nhận & SĐT nếu chưa có
            const nameInput = document.getElementById("inputReceiverName");
            const phoneInput = document.getElementById("inputReceiverPhone");

            if (nameInput) {
                nameInput.value = addr.fullName || userProfileData?.fullName || "";
                handleClearableInput(nameInput);
            }
            if (phoneInput) {
                phoneInput.value = addr.phoneNumber || userProfileData?.phoneNumber || "";
                handleClearableInput(phoneInput);
            }

            // Đồng bộ sang hidden fields
            document.getElementById("receiverName").value = addr.fullName || userProfileData?.fullName || "";
            document.getElementById("receiverPhone").value = addr.phoneNumber || userProfileData?.phoneNumber || "";
            document.getElementById("shippingAddress").value = addr.specificAddress || "";

            // Đóng popup
            const popup = document.getElementById("savedAddressPopupList");
            const caret = document.getElementById("addressDropdownCaret");
            const btn = document.getElementById("savedAddressDropdownBtn");
            if (popup) popup.style.display = "none";
            if (caret) caret.className = "fa fa-chevron-down text-secondary small";
            if (btn) btn.classList.remove("active");
        }

        function renderSavedAddressesDropdown() {
            const popup = document.getElementById("savedAddressPopupList");
            if (!popup) return;

            if (!Array.isArray(userSavedAddresses) || userSavedAddresses.length === 0) {
                popup.innerHTML = '<div class="text-muted small p-2">Bạn chưa có địa chỉ nào được lưu.</div>';
                return;
            }

            let html = "";
            userSavedAddresses.forEach(a => {
                const isSelected = currentSelectedAddress && currentSelectedAddress.id === a.id;
                html += `
                    <div class="saved-address-item-row ${isSelected ? 'is-selected' : ''}" onclick="onSavedAddressClicked(${a.id})">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="fw-bold text-dark">${escapeHtml(a.fullName || "Người nhận")}</span>
                            <span class="text-secondary small">| ${escapeHtml(a.phoneNumber || "")}</span>
                            ${a.isDefault ? '<span class="badge-default-addr">Mặc định</span>' : ''}
                        </div>
                        <div class="small text-secondary">${escapeHtml(a.specificAddress)}</div>
                    </div>
                `;
            });

            popup.innerHTML = html;
        }

        function onSavedAddressClicked(addrId) {
            const target = userSavedAddresses.find(a => a.id === addrId);
            if (target) {
                selectSavedAddress(target);
                renderSavedAddressesDropdown();
            }
        }

        function toggleAddressDropdown() {
            const popup = document.getElementById("savedAddressPopupList");
            const caret = document.getElementById("addressDropdownCaret");
            const btn = document.getElementById("savedAddressDropdownBtn");
            if (!popup) return;

            const isShown = popup.style.display === "block";
            if (isShown) {
                popup.style.display = "none";
                if (caret) caret.className = "fa fa-chevron-down text-secondary small";
                if (btn) btn.classList.remove("active");
            } else {
                renderSavedAddressesDropdown();
                popup.style.display = "block";
                if (caret) caret.className = "fa fa-chevron-up text-secondary small";
                if (btn) btn.classList.add("active");
            }
        }

        // Đóng dropdown khi click bên ngoài
        document.addEventListener("click", function(e) {
            const btn = document.getElementById("savedAddressDropdownBtn");
            const popup = document.getElementById("savedAddressPopupList");
            if (btn && popup && !btn.contains(e.target) && !popup.contains(e.target)) {
                popup.style.display = "none";
                const caret = document.getElementById("addressDropdownCaret");
                if (caret) caret.className = "fa fa-chevron-down text-secondary small";
                if (btn) btn.classList.remove("active");
            }
        });

        // Chuyển đổi giữa Chế độ Sổ địa chỉ và Nhập địa chỉ mới
        function toggleAddressMode() {
            if (isNewAddressMode) {
                switchToSavedAddressMode();
            } else {
                switchToNewAddressMode();
            }
        }

        function switchToNewAddressMode() {
            isNewAddressMode = true;
            document.getElementById("savedAddressModeContainer").classList.add("d-none");
            document.getElementById("newAddressModeContainer").classList.remove("d-none");

            const toggleText = document.getElementById("toggleAddressModeText");
            if (toggleText) toggleText.textContent = "Chọn từ sổ địa chỉ";

            loadLocationProvinces();
            syncNewAddressToHidden();
        }

        function switchToSavedAddressMode() {
            if (!userSavedAddresses || userSavedAddresses.length === 0) {
                showCheckoutAlert("Bạn chưa lưu địa chỉ nào trong Sổ địa chỉ profile.", "info");
                return;
            }

            isNewAddressMode = false;
            document.getElementById("savedAddressModeContainer").classList.remove("d-none");
            document.getElementById("newAddressModeContainer").classList.add("d-none");

            const toggleText = document.getElementById("toggleAddressModeText");
            if (toggleText) toggleText.textContent = "Nhập địa chỉ mới";

            if (currentSelectedAddress) {
                selectSavedAddress(currentSelectedAddress);
            }
        }

        function syncReceiverInputs() {
            const name = (document.getElementById("inputReceiverName")?.value || "").trim();
            const phone = (document.getElementById("inputReceiverPhone")?.value || "").trim();
            document.getElementById("receiverName").value = name;
            document.getElementById("receiverPhone").value = phone;
        }

        function syncNewAddressToHidden() {
            syncReceiverInputs();

            const p = document.getElementById("selectProvince");
            const d = document.getElementById("selectDistrict");
            const w = document.getElementById("selectWard");
            const street = (document.getElementById("inputStreetAddress")?.value || "").trim();

            const pName = p && p.selectedIndex > 0 ? p.options[p.selectedIndex]?.dataset.name || "" : "";
            const dName = d && d.selectedIndex > 0 ? d.options[d.selectedIndex]?.dataset.name || "" : "";
            const wName = w && w.selectedIndex > 0 ? w.options[w.selectedIndex]?.dataset.name || "" : "";

            const parts = [street, wName, dName, pName].filter(Boolean);
            document.getElementById("shippingAddress").value = parts.join(", ");
        }

        // ==========================================
        // 3. API LOCATION (TỈNH, HUYỆN, XÃ)
        // ==========================================
        async function loadLocationProvinces() {
            const select = document.getElementById("selectProvince");
            if (!select || select.options.length > 1) return;

            try {
                const res = await fetch("/api/location/provinces");
                if (!res.ok) return;
                const provinces = await res.json();

                select.innerHTML = '<option value="">-- Chọn Tỉnh/TP --</option>';
                provinces.forEach(p => {
                    const opt = document.createElement("option");
                    opt.value = p.code;
                    opt.dataset.name = p.name;
                    opt.textContent = p.name;
                    select.appendChild(opt);
                });
            } catch (err) {
                console.error("Lỗi tải Tỉnh/TP:", err);
            }
        }

        async function onProvinceSelected(selectEl) {
            const distSelect = document.getElementById("selectDistrict");
            const wardSelect = document.getElementById("selectWard");
            distSelect.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
            wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
            wardSelect.disabled = true;

            const provCode = selectEl.value;
            if (!provCode) {
                distSelect.disabled = true;
                syncNewAddressToHidden();
                return;
            }

            try {
                const res = await fetch(`/api/location/districts/${provCode}`);
                if (!res.ok) return;
                const districts = await res.json();

                distSelect.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
                districts.forEach(d => {
                    const opt = document.createElement("option");
                    opt.value = d.code;
                    opt.dataset.name = d.name;
                    opt.textContent = d.name;
                    distSelect.appendChild(opt);
                });
                distSelect.disabled = false;
            } catch (err) {
                console.error("Lỗi tải Quận/Huyện:", err);
            }
            syncNewAddressToHidden();
        }

        async function onDistrictSelected(selectEl) {
            const wardSelect = document.getElementById("selectWard");
            wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';

            const distCode = selectEl.value;
            if (!distCode) {
                wardSelect.disabled = true;
                syncNewAddressToHidden();
                return;
            }

            try {
                const res = await fetch(`/api/location/wards/${distCode}`);
                if (!res.ok) return;
                const wards = await res.json();

                wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                wards.forEach(w => {
                    const opt = document.createElement("option");
                    opt.value = w.code;
                    opt.dataset.name = w.name;
                    opt.textContent = w.name;
                    wardSelect.appendChild(opt);
                });
                wardSelect.disabled = false;
            } catch (err) {
                console.error("Lỗi tải Phường/Xã:", err);
            }
            syncNewAddressToHidden();
        }

