@{
    Layout = "_LayoutCustomer";
    ViewData["Title"] = "Thông tin thanh toán - FuuFishing";
}

<style>
    /* Ẩn hình ảnh trang trí footer nếu có */
    .footer-section .sofa-img {
        display: none !important;
    }

    .checkout-page-wrapper {
        background-color: #f8fafc;
        min-height: calc(100vh - 400px);
        padding: 24px 0 60px 0;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }

    /* Top Breadcrumb Nav */
    .checkout-top-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

    .btn-back-cart {
        color: #121617;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: color 0.15s ease;
    }

    .btn-back-cart:hover {
        color: #253f36;
    }

    .shipping-promo-badge {
        background-color: #e8f2fe;
        color: #1a73e8;
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 20px;
        padding: 6px 14px;
        display: inline-flex;
        align-items: center;
    }

    /* Cards Chung */
    .checkout-section-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 18px;
    }

    .checkout-card-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #121617;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* 1. Danh sách sản phẩm */
    .checkout-product-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 12px 0;
        border-bottom: 1px solid #f1f5f9;
    }

    .checkout-product-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .checkout-product-thumb {
        width: 64px;
        height: 64px;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        background-color: #ffffff;
        object-fit: contain;
        flex-shrink: 0;
        padding: 4px;
    }

    .checkout-product-info {
        flex: 1;
        min-width: 0;
    }

    .checkout-product-name {
        font-weight: 600;
        font-size: 0.95rem;
        color: #121617;
        margin-bottom: 4px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .checkout-product-qty {
        font-size: 0.85rem;
        color: #64748b;
    }

    .checkout-product-prices {
        text-align: right;
        flex-shrink: 0;
    }

    .checkout-price-current {
        font-weight: 700;
        font-size: 1rem;
        color: #dc2626;
        display: block;
    }

    .checkout-price-old {
        font-size: 0.825rem;
        color: #94a3b8;
        text-decoration: line-through;
        display: block;
    }

    /* 2. Thông tin khách hàng (Đã bỏ badge FuuFishing Member) */
    .user-info-grid {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 20px;
        align-items: start;
    }

    @@media (max-width: 768px) {
        .user-info-grid {
            grid-template-columns: 1fr;
            gap: 14px;
        }
    }

    .user-profile-left {
        padding-right: 12px;
    }

    .user-profile-name {
        font-size: 1.05rem;
        font-weight: 700;
        color: #121617;
        margin-bottom: 4px;
    }

    .user-profile-phone {
        font-size: 0.95rem;
        color: #475569;
        margin-bottom: 0;
    }

    /* Inputs có nút Clear 'X' */
    .input-clearable-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .form-control-sharp {
        border: 1px solid #2f2f2f !important;
        border-radius: 8px !important;
        background-color: #ffffff !important;
        color: #121617 !important;
        padding: 10px 36px 10px 14px !important;
        font-size: 0.95rem !important;
        width: 100%;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .form-control-sharp:focus {
        border-color: #253f36 !important;
        box-shadow: 0 0 0 1px #253f36 !important;
        outline: none !important;
    }

    .btn-clear-field {
        position: absolute;
        right: 10px;
        border: none;
        background: transparent;
        color: #94a3b8;
        font-size: 0.9rem;
        cursor: pointer;
        padding: 4px;
        display: none;
        align-items: center;
        justify-content: center;
        transition: color 0.15s ease;
    }

    .btn-clear-field:hover {
        color: #1e293b;
    }

    .custom-check-box {
        accent-color: #253f36;
        width: 17px;
        height: 17px;
        cursor: pointer;
    }

    /* 3. Chọn hình thức nhận hàng */
    .delivery-type-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 16px;
        border-radius: 20px;
        border: 1.5px solid #253f36;
        color: #253f36;
        background-color: #f2f7f4;
        font-weight: 600;
        font-size: 0.875rem;
    }

    .btn-toggle-address-mode {
        border: none;
        background: transparent;
        color: #253f36;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 2px 6px;
        transition: opacity 0.15s ease;
    }

    .btn-toggle-address-mode:hover {
        text-decoration: underline;
        opacity: 0.85;
    }

    /* Dropdown Sổ địa chỉ */
    .saved-address-dropdown-btn {
        width: 100%;
        border: 1px solid #2f2f2f;
        border-radius: 8px;
        padding: 12px 14px;
        background: #ffffff;
        text-align: left;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }

    .saved-address-dropdown-btn:hover {
        border-color: #253f36;
    }

    .saved-address-dropdown-btn.active {
        border-color: #253f36;
        box-shadow: 0 0 0 1px #253f36;
    }

    .saved-address-list-popup {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #ffffff;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
        margin-top: 6px;
        padding: 8px;
        display: none;
        max-height: 280px;
        overflow-y: auto;
    }

    .saved-address-item-row {
        padding: 10px 12px;
        border-radius: 6px;
        border: 1px solid transparent;
        cursor: pointer;
        margin-bottom: 6px;
        transition: background-color 0.15s ease, border-color 0.15s ease;
    }

    .saved-address-item-row:hover {
        background-color: #f8fafc;
        border-color: #e2e8f0;
    }

    .saved-address-item-row.is-selected {
        background-color: #f2f7f4;
        border-color: #253f36;
    }

    .badge-default-addr {
        background-color: #e6ece9;
        color: #253f36;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 4px;
    }

    /* Mẹo sổ địa chỉ */
    .address-tip-text {
        font-size: 0.825rem;
        color: #64748b;
        margin-top: 8px;
    }

    .address-tip-text a {
        color: #121617;
        font-weight: 600;
        text-decoration: none;
    }

    .address-tip-text a:hover {
        text-decoration: underline;
    }

    /* Khối hóa đơn VAT công ty */
    .vat-company-box {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 10px;
    }

    .vat-radio-group {
        display: flex;
        gap: 16px;
        align-items: center;
    }

    .vat-radio-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: #121617;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* 4. Cột phải: Thông tin đơn hàng (NẰM YÊN TRONG DÒNG CHẢY, KHÔNG STICKY ĐÈ LÊN THẺ KHÁC) */
    .order-summary-box {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 20px;
        position: static; /* Nằm yên, không float/sticky */
    }

    /* Khối chọn mã giảm giá (giống hệt cart) */
    .coupon-select-box {
        background-color: #fafbfc;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 10px 14px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: border-color 0.2s ease;
    }

    .coupon-select-box:hover {
        border-color: #253f36;
    }

    .coupon-ticket-icon {
        width: 26px;
        height: 26px;
        border-radius: 6px;
        background: #e6ece9;
        color: #253f36;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
    }

    .btn-coupon-choose {
        background: #e6ece9;
        color: #253f36;
        border: none;
        border-radius: 6px;
        font-size: 0.825rem;
        font-weight: 700;
        padding: 5px 12px;
        cursor: pointer;
        transition: background-color 0.15s ease;
    }

    .btn-coupon-choose:hover {
        background: #d4deda;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.925rem;
        color: #475569;
        margin-bottom: 12px;
    }

    .summary-row strong {
        color: #121617;
    }

    .summary-divider {
        height: 1px;
        background-color: #e5e7eb;
        margin: 16px 0;
    }

    .summary-grand-total {
        font-size: 1.35rem;
        font-weight: 800;
        color: #dc2626;
    }

    .summary-saved-text {
        font-size: 0.85rem;
        color: #16a34a;
        font-weight: 600;
        text-align: right;
        margin-top: 4px;
    }

    /* 5. Chọn phương thức thanh toán */
    .payment-method-item {
        border: 1.5px solid #e5e7eb;
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        transition: border-color 0.15s ease, background-color 0.15s ease;
    }

    .payment-method-item:hover {
        border-color: #253f36;
        background-color: #fbfdfc;
    }

    .payment-method-item.active {
        border-color: #253f36;
        background-color: #f2f7f4;
    }

    .payment-method-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .payment-method-icon-box {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #253f36;
        font-size: 1.15rem;
        flex-shrink: 0;
    }

    .payment-method-title {
        font-weight: 700;
        font-size: 0.925rem;
        color: #121617;
        margin-bottom: 2px;
    }

    .payment-method-desc {
        font-size: 0.775rem;
        color: #64748b;
        max-width: 320px;
        line-height: 1.3;
    }

    /* Nút Thanh Toán To */
    .btn-checkout-submit {
        background-color: #253f36;
        color: #ffffff;
        border: none;
        border-radius: 8px;
        font-weight: 700;
        font-size: 1.05rem;
        width: 100%;
        padding: 14px 16px;
        text-align: center;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 16px;
        cursor: pointer;
        transition: background-color 0.2s ease, opacity 0.2s ease;
    }

    .btn-checkout-submit:hover:not(:disabled) {
        background-color: #192b25;
        color: #ffffff;
    }

    .btn-checkout-submit:disabled {
        background-color: #94a3b8;
        cursor: not-allowed;
        opacity: 0.7;
    }

    .checkout-policy-notice {
        font-size: 0.775rem;
        color: #64748b;
        margin-top: 14px;
        text-align: center;
        line-height: 1.4;
    }

    .checkout-policy-notice a {
        color: #253f36;
        font-weight: 600;
        text-decoration: underline;
    }

    /* =======================================================
       MODAL COUPON - GIỐNG HỆT GIAO DIỆN NGOÀI CART (FUUFISHING)
       ======================================================= */
    .coupon-search-box {
        border: 1px solid #d1d5db;
        border-radius: 8px;
        padding: 8px 14px;
        background: #ffffff;
        display: flex;
        align-items: center;
        transition: border-color 0.2s ease;
    }

    .coupon-search-box:focus-within {
        border-color: #253f36;
    }

    .coupon-input-field {
        border: none !important;
        outline: none !important;
        font-size: 0.95rem;
        color: #121617;
        background: transparent;
        padding: 0;
    }

    .coupon-input-field::placeholder {
        color: #9ca3af;
        font-size: 0.925rem;
    }

    .btn-clear-coupon {
        border: none;
        background: transparent;
        color: #9ca3af;
        padding: 2px 6px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.95rem;
    }

    .btn-clear-coupon:hover {
        color: #374151;
    }

    .coupon-divider {
        width: 1px;
        height: 18px;
        background-color: #d1d5db;
        margin: 0 10px;
    }

    .btn-apply-coupon-text {
        border: none;
        background: transparent;
        padding: 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: #9ca3af;
        cursor: not-allowed;
        white-space: nowrap;
        transition: color 0.15s ease;
    }

    .btn-apply-coupon-text.active {
        color: #253f36 !important;
        font-weight: 700;
        cursor: pointer !important;
    }

    /* Coupon Ticket Card */
    .coupon-ticket-card {
        background: #ffffff;
        border: 1px dashed #cbd5e1;
        border-radius: 8px;
        padding: 14px 16px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 14px;
        transition: all 0.2s ease;
        position: relative;
        cursor: pointer;
    }

    .coupon-ticket-card:hover:not(.disabled) {
        border-color: #253f36;
        background-color: #fbfdfc;
    }

    .coupon-ticket-card.selected {
        border-color: #253f36;
        border-style: solid;
        background-color: #f2f7f4;
    }

    .coupon-ticket-card.disabled {
        opacity: 0.6;
        background-color: #f8fafc;
        cursor: not-allowed;
    }

    .badge-best-choice {
        position: absolute;
        top: -9px;
        left: 200px;
        background: #253f36;
        color: #ffffff;
        font-size: 0.68rem;
        font-weight: 700;
        border-radius: 4px;
        padding: 2px 8px;
        z-index: 2;
    }

    .coupon-badge-square {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        background: #e6ece9;
        color: #253f36;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .coupon-discount-tag {
        color: #253f36;
        background: #e6ece9;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.825rem;
        font-weight: 600;
        display: inline-block;
        margin-bottom: 4px;
    }

    .btn-modal-confirm {
        background-color: #253f36;
        color: #ffffff;
        font-weight: 700;
        font-size: 0.95rem;
        border-radius: 8px;
        padding: 10px 32px;
        border: none;
        transition: background-color 0.2s ease;
    }

    .btn-modal-confirm:hover {
        background-color: #192b25;
        color: #ffffff;
    }

    @@media (max-width: 576px) {
        .checkout-page-wrapper {
            padding: 16px 0 40px 0;
        }
        .checkout-section-card {
            padding: 14px;
        }
        .order-summary-box {
            padding: 14px;
        }
        .checkout-product-thumb {
            width: 50px;
            height: 50px;
        }
        .checkout-product-title {
            font-size: 0.85rem;
        }
        .summary-grand-total {
            font-size: 1.15rem;
        }
    }
</style>

<div class="checkout-page-wrapper">
    <div class="container">

        <!-- Top Breadcrumbs & Promo Banner -->
        <div class="checkout-top-nav">
            <a href="/cart" class="btn-back-cart">
                <i class="fa fa-angle-left"></i>
                <span>Quay lại giỏ hàng / Thông tin thanh toán</span>
            </a>
            <div class="shipping-promo-badge">
                Miễn phí vận chuyển với đơn hàng từ 300.000₫
            </div>
        </div>

        <form id="checkoutForm" onsubmit="return false;">
            <!-- Hidden inputs nạp data cho backend -->
            <input type="hidden" id="receiverName" name="receiverName" value="" />
            <input type="hidden" id="receiverPhone" name="receiverPhone" value="" />
            <input type="hidden" id="shippingAddress" name="shippingAddress" value="" />
            <input type="hidden" id="paymentMethod" name="paymentMethod" value="COD" />

            <div class="row g-4">
                <!-- CỘT TRÁI: THÔNG TIN GIAO HÀNG & KHÁCH HÀNG -->
                <div class="col-lg-7">
                    
                    <!-- 1. Danh sách sản phẩm thanh toán -->
                    <div class="checkout-section-card">
                        <div class="checkout-card-title">
                            <span>Danh sách sản phẩm</span>
                            <span id="checkout-product-count" class="badge bg-light text-dark fw-semibold" style="font-size: 0.8rem;">Đang tải...</span>
                        </div>
                        
                        <div id="checkout-products-list">
                            <div class="text-center py-4 text-muted small">
                                <div class="spinner-border spinner-border-sm text-secondary me-2" role="status"></div>
                                Đang tải danh sách sản phẩm...
                            </div>
                        </div>
                    </div>

                    <!-- 2. Thông tin khách hàng (Đã bỏ FuuFishing Member) -->
                    <div class="checkout-section-card">
                        <div class="checkout-card-title">Thông tin khách hàng</div>
                        <div class="user-info-grid">
                            <div class="user-profile-left">
                                <div class="user-profile-name" id="displayCustomerName">Đang tải...</div>
                                <div class="user-profile-phone" id="displayCustomerPhone">---</div>
                            </div>

                            <div>
                                <label class="form-label small fw-semibold text-dark mb-1">Email</label>
                                <div class="input-clearable-wrapper mb-1">
                                    <input type="email"
                                           id="customerEmail"
                                           class="form-control form-control-sharp"
                                           placeholder="Nhập email của bạn"
                                           oninput="handleClearableInput(this)">
                                    <button type="button" class="btn-clear-field" onclick="clearInput('customerEmail')">
                                        <i class="fa fa-times"></i>
                                    </button>
                                </div>
                                <div class="small text-muted" style="font-size: 0.775rem;">
                                    (*) Hóa đơn VAT sẽ được gửi qua email này
                                </div>

                                <div class="form-check mt-3">
                                    <input class="form-check-input custom-check-box" type="checkbox" id="checkOptInEmail" checked>
                                    <label class="form-check-label small text-dark ms-1" for="checkOptInEmail" style="cursor: pointer;">
                                        Nhận email thông báo và ưu đãi từ FuuFishing
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Chọn hình thức nhận hàng (Giao hàng tận nơi) -->
                    <div class="checkout-section-card">
                        <div class="checkout-card-title">
                            <span>Chọn hình thức nhận hàng</span>
                            <span class="delivery-type-pill">
                                <i class="fa fa-truck-fast"></i> Giao hàng tận nơi
                            </span>
                        </div>

                        <!-- Tên & Số điện thoại người nhận -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-dark mb-1">Tên người nhận <span class="text-danger">*</span></label>
                                <div class="input-clearable-wrapper">
                                    <input type="text"
                                           id="inputReceiverName"
                                           class="form-control form-control-sharp"
                                           placeholder="Nhập tên người nhận"
                                           maxlength="100"
                                           oninput="handleClearableInput(this); syncReceiverInputs();">
                                    <button type="button" class="btn-clear-field" onclick="clearInput('inputReceiverName'); syncReceiverInputs();">
                                        <i class="fa fa-times"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-semibold text-dark mb-1">Số điện thoại người nhận <span class="text-danger">*</span></label>
                                <div class="input-clearable-wrapper">
                                    <input type="tel"
                                           id="inputReceiverPhone"
                                           class="form-control form-control-sharp"
                                           placeholder="Nhập số điện thoại"
                                           maxlength="20"
                                           oninput="handleClearableInput(this); syncReceiverInputs();">
                                    <button type="button" class="btn-clear-field" onclick="clearInput('inputReceiverPhone'); syncReceiverInputs();">
                                        <i class="fa fa-times"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Khối Địa chỉ nhận hàng -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
