@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container my-5">
    <div class="row g-4">

        <!-- THÔNG TIN NHẬN HÀNG & PHƯƠNG THỨC -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-dark text-white py-3">
                    <h4 class="mb-0 fs-5 fw-bold">
                        <i class="fa fa-map-marker-alt me-2 text-white"></i>Thông tin nhận hàng
                    </h4>
                </div>

                <div class="card-body p-4">
                    <div id="checkoutMessage"></div>

                    <form id="checkoutForm">
                        <!-- Hidden inputs kết nối trực tiếp với backend checkout API -->
                        <input type="hidden" id="receiverName" name="receiverName" value="" />
                        <input type="hidden" id="receiverPhone" name="receiverPhone" value="" />
                        <input type="hidden" id="shippingAddress" name="shippingAddress" value="" />

                        <!-- 1. ĐỊA CHỈ ĐÃ LƯU / ĐANG CHỌN (Shopee Standard) -->
                        <div id="selectedAddressBox" class="address-card-box mb-4">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="fw-bold text-dark fs-6" id="displayReceiverName">Đang tải...</span>
                                    <span class="text-secondary fw-semibold ms-2" id="displayReceiverPhone"></span>
                                    <span class="badge bg-secondary ms-2 small d-none" id="displayDefaultBadge">Mặc định</span>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-dark" id="btnOpenAddressModal" onclick="openAddressModal()">
                                    <i class="fa fa-map-marker-alt me-1"></i>Thay đổi
                                </button>
                            </div>
                            <div class="text-dark small" id="displayFullAddress">
                                Đang tải địa chỉ nhận hàng...
                            </div>
                            <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center">
                                <span class="small text-muted">
                                    <i class="fa fa-info-circle me-1"></i>Đơn hàng sẽ được chuyển đến địa chỉ này
                                </span>
                                <button type="button" class="btn btn-sm btn-link text-decoration-none text-dark p-0 small fw-semibold" onclick="switchToCustomAddress(true)">
                                    <i class="fa fa-plus me-1"></i>Giao đến địa chỉ khác
                                </button>
                            </div>
                        </div>

                        <!-- 2. NHẬP ĐỊA CHỈ MỚI (Hiện khi chưa có địa chỉ hoặc chọn giao địa chỉ khác) -->
                        <div id="customAddressBox" class="p-3 rounded border mb-4 bg-light d-none">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0 fw-bold text-dark">
                                    <i class="fa fa-edit me-1"></i>Thông tin địa chỉ giao hàng mới
                                </h6>
                                <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="btnBackToSavedAddress" onclick="backToSavedAddress()">
                                    <i class="fa fa-arrow-left me-1"></i>Dùng địa chỉ đã lưu
                                </button>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label for="customReceiverName" class="form-label small fw-semibold text-dark">
                                        Tên người nhận <span class="text-danger">*</span>
                                    </label>
                                    <input type="text"
                                           id="customReceiverName"
                                           class="form-control form-control-sm"
                                           placeholder="Nhập tên người nhận"
                                           maxlength="100"
                                           oninput="syncCustomAddressToHidden()">
                                </div>
                                <div class="col-md-6">
                                    <label for="customReceiverPhone" class="form-label small fw-semibold text-dark">
                                        Số điện thoại <span class="text-danger">*</span>
                                    </label>
                                    <input type="text"
                                           id="customReceiverPhone"
                                           class="form-control form-control-sm"
                                           placeholder="Nhập số điện thoại"
                                           maxlength="20"
                                           oninput="syncCustomAddressToHidden()">
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-md-4">
                                    <label for="checkoutProvince" class="form-label small fw-semibold text-dark">
                                        Tỉnh / Thành phố <span class="text-danger">*</span>
                                    </label>
                                    <select id="checkoutProvince" class="form-select form-select-sm" onchange="onCheckoutProvinceChange(this)">
                                        <option value="">-- Chọn Tỉnh/TP --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label for="checkoutDistrict" class="form-label small fw-semibold text-dark">
                                        Quận / Huyện <span class="text-danger">*</span>
                                    </label>
                                    <select id="checkoutDistrict" class="form-select form-select-sm" disabled onchange="onCheckoutDistrictChange(this)">
                                        <option value="">-- Chọn Quận/Huyện --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label for="checkoutWard" class="form-label small fw-semibold text-dark">
                                        Phường / Xã <span class="text-danger">*</span>
                                    </label>
                                    <select id="checkoutWard" class="form-select form-select-sm" disabled onchange="syncCustomAddressToHidden()">
                                        <option value="">-- Chọn Phường/Xã --</option>
                                    </select>
                                </div>
                            </div>

                            <div>
                                <label for="checkoutStreet" class="form-label small fw-semibold text-dark">
                                    Số nhà, ngõ/ngách, tên đường <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       id="checkoutStreet"
                                       class="form-control form-control-sm"
                                       placeholder="Ví dụ: Số 123 đường Giải Phóng"
                                       oninput="syncCustomAddressToHidden()" />
                            </div>
                        </div>

                        <!-- 3. PHƯƠNG THỨC GIAO HÀNG (TICK CHỌN CÓ ICON) -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark mb-2">
                                <i class="fa fa-truck text-dark me-2"></i>Phương thức giao hàng
                            </label>
                            <div class="row g-2">
                                <div class="col-12 col-md-6">
                                    <label class="selection-card shipping-method-card p-3 d-flex align-items-center gap-3 active" id="shippingMethodCard-STANDARD">
                                        <input type="radio" name="shippingMethodRadio" value="STANDARD" checked onchange="onShippingMethodChange('STANDARD')">
                                        <div class="icon-box">
                                            <i class="fa fa-truck-fast"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="fw-bold text-dark small">Giao hàng tiêu chuẩn</div>
                                            <div class="text-secondary" style="font-size: 0.78rem;">Dự kiến 2 - 4 ngày làm việc</div>
                                        </div>
                                        <div class="text-success fw-bold small">Miễn phí</div>
                                    </label>
                                </div>
                                <div class="col-12 col-md-6">
                                    <label class="selection-card shipping-method-card p-3 d-flex align-items-center gap-3" id="shippingMethodCard-EXPRESS">
                                        <input type="radio" name="shippingMethodRadio" value="EXPRESS" onchange="onShippingMethodChange('EXPRESS')">
                                        <div class="icon-box">
                                            <i class="fa fa-bolt"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="fw-bold text-dark small">Giao hàng hỏa tốc</div>
                                            <div class="text-secondary" style="font-size: 0.78rem;">Nội thành 2 - 4 giờ</div>
                                        </div>
                                        <div class="text-secondary fw-semibold small">Liên hệ</div>
                                    </label>
                                </div>
                            </div>
                        </div>

                        <!-- 4. PHƯƠNG THỨC THANH TOÁN (TICK CHỌN CÓ ICON) -->
                        <div class="mb-4">
                            <label class="form-label fw-bold text-dark mb-2">
                                <i class="fa fa-credit-card text-dark me-2"></i>Phương thức thanh toán
                            </label>
                            <input type="hidden" id="paymentMethod" name="paymentMethod" value="COD" />

                            <div class="d-flex flex-column gap-2">
                                <!-- COD -->
                                <label class="selection-card payment-method-card p-3 d-flex align-items-center gap-3 active" id="paymentMethodCard-COD" onclick="selectPaymentMethod('COD')">
                                    <input type="radio" name="paymentMethodRadio" value="COD" checked onchange="selectPaymentMethod('COD')">
                                    <div class="icon-box">
                                        <i class="fa fa-money-bill-wave"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold text-dark">Thanh toán khi nhận hàng (COD)</div>
                                        <div class="text-secondary small">Nhận hàng rồi thanh toán tiền mặt trực tiếp cho nhân viên giao hàng.</div>
                                    </div>
                                </label>

                                <!-- VNPAY -->
                                <label class="selection-card payment-method-card p-3 d-flex align-items-center gap-3" id="paymentMethodCard-VNPAY" onclick="selectPaymentMethod('VNPAY')">
                                    <input type="radio" name="paymentMethodRadio" value="VNPAY" onchange="selectPaymentMethod('VNPAY')">
                                    <div class="icon-box">
                                        <i class="fa fa-qrcode"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold text-dark">Cổng thanh toán VNPay</div>
                                        <div class="text-secondary small">Hỗ trợ quét mã VNPAY-QR, thẻ ATM nội địa hoặc thẻ quốc tế Visa / MasterCard.</div>
                                    </div>
                                </label>

                                <!-- MOMO -->
                                <label class="selection-card payment-method-card p-3 d-flex align-items-center gap-3" id="paymentMethodCard-MOMO" onclick="selectPaymentMethod('MOMO')">
                                    <input type="radio" name="paymentMethodRadio" value="MOMO" onchange="selectPaymentMethod('MOMO')">
                                    <div class="icon-box">
                                        <i class="fa fa-wallet"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold text-dark">Ví điện tử MoMo</div>
                                        <div class="text-secondary small">Thanh toán tức thì qua ứng dụng ví MoMo trên điện thoại di động.</div>
                                    </div>
                                </label>

                                <!-- ZALOPAY -->
                                <label class="selection-card payment-method-card p-3 d-flex align-items-center gap-3" id="paymentMethodCard-ZALOPAY" onclick="selectPaymentMethod('ZALOPAY')">
                                    <input type="radio" name="paymentMethodRadio" value="ZALOPAY" onchange="selectPaymentMethod('ZALOPAY')">
                                    <div class="icon-box">
                                        <i class="fa fa-shield-alt"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold text-dark">Ví điện tử ZaloPay</div>
                                        <div class="text-secondary small">Thanh toán an toàn, bảo mật qua ví ZaloPay hoặc tài khoản Zalo.</div>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <!-- 5. GHI CHÚ ĐƠN HÀNG -->
                        <div class="mb-4">
                            <label for="note" class="form-label fw-bold text-dark mb-1">
                                <i class="fa fa-pen-alt text-dark me-2"></i>Ghi chú đơn hàng (nếu có)
                            </label>
                            <textarea id="note"
                                      class="form-control"
                                      rows="2"
                                      maxlength="200"
                                      placeholder="Ví dụ: Giao hàng vào giờ hành chính, gọi điện trước khi giao 15 phút..."></textarea>
                        </div>

                        <!-- NÚT ĐẶT HÀNG -->
                        <button type="submit"
                                id="btn-place-order"
                                class="btn btn-dark w-100 py-3 fw-bold fs-6">
                            <i class="fa fa-check-circle me-2"></i>Xác nhận đặt hàng
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- TÓM TẮT ĐƠN HÀNG -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm checkout-summary">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0">Tóm tắt đơn hàng</h4>
                </div>

                <div class="card-body">

                    <!-- Loading -->
                    <div id="checkout-summary-loading"
                         class="text-center py-4">

                        <div class="spinner-border spinner-border-sm text-success"
                             role="status">
                            <span class="visually-hidden">
                                Đang tải...
                            </span>
                        </div>

                        <span class="ms-2">
                            Đang tải sản phẩm...
                        </span>
                    </div>

                    <!-- Thông báo lỗi -->
                    <div id="checkout-summary-error"
                         class="alert alert-danger d-none">
                    </div>

                    <!-- Danh sách sản phẩm -->
                    <div id="checkout-product-list"></div>

                    <!-- Tổng tiền -->
                    <div id="checkout-total-container"
                         class="d-none">

                        <hr>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Tổng tiền hàng</span>

                            <strong id="checkout-subtotal">
                                0 ₫
                            </strong>
                        </div>

                        <!-- Mã giảm giá -->
                        <div class="mb-3 pt-2 border-top">
                            <label class="form-label small fw-bold text-dark">Phiếu giảm giá (Coupon)</label>
                            <div class="input-group">
                                <input type="text"
                                       id="checkout-coupon-code"
                                       class="form-control text-uppercase"
                                       placeholder="Nhập mã giảm giá"
                                       onkeydown="if (event.key === 'Enter') { event.preventDefault(); applyCheckoutCoupon(); }">
                                <button type="button"
                                        id="btn-apply-checkout-coupon"
                                        class="btn btn-dark"
                                        onclick="applyCheckoutCoupon()">
                                    Áp dụng
                                </button>
                            </div>
                            <div id="checkout-coupon-message" class="mt-2 small"></div>
                        </div>

                        <!-- Dòng hiển thị giảm giá khuyến mãi -->
                        <div id="checkout-discount-row" class="d-flex justify-content-between mb-3 d-none">
                            <span class="text-success fw-semibold">Giảm giá khuyến mãi</span>
                            <strong id="checkout-discount-amount" class="text-success">- 0 ₫</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Phí vận chuyển</span>

                            <strong id="checkout-shipping-fee">
                                0 ₫
                            </strong>
                        </div>

                        <div class="d-flex justify-content-between
                            border-top pt-3">

                            <span class="fw-bold fs-5">
                                Tổng thanh toán
                            </span>

                            <strong id="checkout-grand-total"
                                    class="text-danger fs-5">
                                0 ₫
                            </strong>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a href="/cart"
                           class="text-decoration-none">
                            ← Quay lại giỏ hàng
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- MODAL CHỌN ĐỊA CHỈ NHẬN HÀNG -->
<div class="modal fade" id="addressModal" tabindex="-1" aria-labelledby="addressModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white py-3">
                <h5 class="modal-title fs-6 fw-bold mb-0" id="addressModalLabel">
                    <i class="fa fa-map-marker-alt me-2 text-white"></i>Địa chỉ nhận hàng của bạn
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-3">
                <div id="modalAddressList" class="d-flex flex-column gap-2 mb-3">
                    <!-- Danh sách địa chỉ được nạp bằng JS -->
                </div>
                <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                    <a href="/account/address" target="_blank" class="btn btn-sm btn-outline-dark">
                        <i class="fa fa-cog me-1"></i>Quản lý sổ địa chỉ
                    </a>
                    <button type="button" class="btn btn-sm btn-link text-dark text-decoration-none small fw-semibold" onclick="switchToCustomAddressFromModal()">
                        <i class="fa fa-plus me-1"></i>Giao đến địa chỉ mới khác
                    </button>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
                <button type="button" class="btn btn-sm btn-dark" onclick="confirmModalAddressSelection()">
                    <i class="fa fa-check me-1"></i>Xác nhận chọn
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .checkout-summary {
        position: sticky;
        top: 90px;
    }

    .checkout-product-item {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 0;
        border-bottom: 1px solid #e5e5e5;
    }

    .checkout-product-image {
        width: 80px;
        height: 80px;
        flex-shrink: 0;
        object-fit: contain;
        border: 1px solid #eeeeee;
        border-radius: 8px;
        background-color: #ffffff;
    }

    .checkout-product-info {
        flex: 1;
        min-width: 0;
    }

    .checkout-product-name {
        margin-bottom: 6px;
        font-weight: 600;
        color: #2f2f2f;
    }

    .checkout-product-meta {
        font-size: 14px;
        color: #6c757d;
    }

    .checkout-product-line-total {
        margin-top: 5px;
        font-weight: 700;
        color: #dc3545;
    }

    @@media (max-width: 991px) {
        .checkout-summary {
            position: static;
        }
    }

    /* Anti-AI-Slop & High-Contrast Checkout Styles */
    .address-card-box {
        border: 1.5px solid #2f2f2f;
        border-radius: 8px;
        background-color: #ffffff;
        padding: 16px;
        position: relative;
    }

    .address-card-box::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: repeating-linear-gradient(45deg, #253f36, #253f36 15px, #f8f9fa 15px, #f8f9fa 25px, #121617 25px, #121617 40px, #f8f9fa 40px, #f8f9fa 50px);
        border-top-left-radius: 6px;
        border-top-right-radius: 6px;
    }

    .selection-card {
        border: 1px solid #4a5568;
        border-radius: 8px;
        background-color: #ffffff;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
        user-select: none;
    }

    .selection-card:hover {
        border-color: #253f36;
        background-color: #fbfdfc;
    }

    .selection-card.active {
        border: 2px solid #253f36 !important;
        background-color: #f7faf8;
    }

    .selection-card .icon-box {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        border: 1px solid #dee2e6;
        background-color: #ffffff;
        color: #253f36;
        font-size: 1.15rem;
        flex-shrink: 0;
    }

    .selection-card.active .icon-box {
        border-color: #253f36;
        background-color: #253f36;
        color: #ffffff;
    }

    .selection-card input[type="radio"] {
        accent-color: #253f36;
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    .address-item-card {
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 12px 14px;
        cursor: pointer;
        transition: all 0.15s ease-in-out;
    }

    .address-item-card:hover {
        border-color: #253f36;
        background-color: #fbfdfc;
    }

    .address-item-card.selected {
        border: 2px solid #253f36;
        background-color: #f7faf8;
    }

    .form-control, .form-select {
        border: 1px solid #2f2f2f;
        border-radius: 6px;
        background-color: #ffffff;
        color: #121617;
    }

    .form-control:focus, .form-select:focus {
        border-color: #253f36;
        box-shadow: 0 0 0 1px #253f36;
        background-color: #ffffff;
    }

</style>

@section Scripts {
    <script>
        
        let savedAddressesList = [];
        let currentSelectedAddressId = null;
        let currentProfileInfo = null;

        async function initUserAddressAndProfile() {
            try {
                const addrRes = await fetch('/api/user/addresses');
                if (addrRes.ok) {
                    savedAddressesList = await addrRes.json();
                }

                const profileRes = await fetch('/api/user/profile-info');
                if (profileRes.ok) {
                    currentProfileInfo = await profileRes.json();
                }

                if (Array.isArray(savedAddressesList) && savedAddressesList.length > 0) {
                    const defaultAddr = savedAddressesList.find(a => a.isDefault) || savedAddressesList[0];
                    applySelectedAddress(defaultAddr);
                } else {
                    switchToCustomAddress(false);
                    const nameInput = document.getElementById('customReceiverName');
                    const phoneInput = document.getElementById('customReceiverPhone');
                    if (nameInput && currentProfileInfo?.fullName) {
                        nameInput.value = currentProfileInfo.fullName;
                    }
                    if (phoneInput && currentProfileInfo?.phoneNumber) {
                        phoneInput.value = currentProfileInfo.phoneNumber;
                    }
                    syncCustomAddressToHidden();
                }
            } catch (err) {
                console.warn('Lỗi tải thông tin địa chỉ/profile:', err);
            }
        }

        function applySelectedAddress(addr) {
            if (!addr) return;
            currentSelectedAddressId = addr.id;

            const nameEl = document.getElementById('displayReceiverName');
            const phoneEl = document.getElementById('displayReceiverPhone');
            const addrEl = document.getElementById('displayFullAddress');
            const defaultBadge = document.getElementById('displayDefaultBadge');

            if (nameEl) nameEl.textContent = addr.fullName || (currentProfileInfo?.fullName || 'Người nhận');
            if (phoneEl) phoneEl.textContent = addr.phoneNumber ? `(+84) ${addr.phoneNumber}` : (currentProfileInfo?.phoneNumber ? `(+84) ${currentProfileInfo.phoneNumber}` : '');
            if (addrEl) addrEl.textContent = addr.specificAddress || 'Chưa có thông tin địa chỉ cụ thể';

            if (defaultBadge) {
                if (addr.isDefault) {
                    defaultBadge.classList.remove('d-none');
                } else {
                    defaultBadge.classList.add('d-none');
                }
            }

            document.getElementById('receiverName').value = addr.fullName || currentProfileInfo?.fullName || '';
            document.getElementById('receiverPhone').value = addr.phoneNumber || currentProfileInfo?.phoneNumber || '';
            document.getElementById('shippingAddress').value = addr.specificAddress || '';

            document.getElementById('selectedAddressBox').classList.remove('d-none');
            document.getElementById('customAddressBox').classList.add('d-none');
        }

        function openAddressModal() {
            renderModalAddressList();
            const modalEl = document.getElementById('addressModal');
            if (modalEl && window.bootstrap) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        function renderModalAddressList() {
            const container = document.getElementById('modalAddressList');
            if (!container) return;
            container.innerHTML = '';

            if (!Array.isArray(savedAddressesList) || savedAddressesList.length === 0) {
                container.innerHTML = '<div class="text-muted small p-2">Bạn chưa có địa chỉ nào được lưu.</div>';
                return;
            }

            savedAddressesList.forEach(a => {
                const isSelected = a.id === currentSelectedAddressId;
                const item = document.createElement('label');
                item.className = `address-item-card d-flex align-items-start gap-3 ${isSelected ? 'selected' : ''}`;
                item.onclick = function() {
                    container.querySelectorAll('.address-item-card').forEach(c => c.classList.remove('selected'));
                    item.classList.add('selected');
                };

                item.innerHTML = `
                    <input type="radio" name="modalAddressRadio" value="${a.id}" ${isSelected ? 'checked' : ''} class="form-check-input mt-1">
                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="fw-bold text-dark">${escapeHtml(a.fullName)}</span>
                            <span class="text-secondary small">| ${escapeHtml(a.phoneNumber)}</span>
                            ${a.isDefault ? '<span class="badge bg-secondary ms-1 small">Mặc định</span>' : ''}
                        </div>
                        <div class="text-secondary small">${escapeHtml(a.specificAddress)}</div>
                    </div>
                `;
                container.appendChild(item);
            });
        }

        function confirmModalAddressSelection() {
            const selectedRadio = document.querySelector('input[name="modalAddressRadio"]:checked');
            if (selectedRadio) {
                const selectedId = Number(selectedRadio.value);
                const addr = savedAddressesList.find(a => a.id === selectedId);
                if (addr) {
                    applySelectedAddress(addr);
                }
            }
            const modalEl = document.getElementById('addressModal');
            if (modalEl && window.bootstrap) {
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
            }
        }

        function switchToCustomAddress(canGoBack = true) {
            document.getElementById('selectedAddressBox').classList.add('d-none');
            const customBox = document.getElementById('customAddressBox');
            customBox.classList.remove('d-none');

            const btnBack = document.getElementById('btnBackToSavedAddress');
            if (btnBack) {
                if (canGoBack && savedAddressesList.length > 0) {
                    btnBack.classList.remove('d-none');
                } else {
                    btnBack.classList.add('d-none');
                }
            }

            const nameInput = document.getElementById('customReceiverName');
            const phoneInput = document.getElementById('customReceiverPhone');
            if (nameInput && !nameInput.value && currentProfileInfo?.fullName) {
                nameInput.value = currentProfileInfo.fullName;
            }
            if (phoneInput && !phoneInput.value && currentProfileInfo?.phoneNumber) {
                phoneInput.value = currentProfileInfo.phoneNumber;
            }

            loadCheckoutProvinces();
            syncCustomAddressToHidden();
        }

        function switchToCustomAddressFromModal() {
            const modalEl = document.getElementById('addressModal');
            if (modalEl && window.bootstrap) {
                const modal = bootstrap.Modal.getInstance(modalEl);
                if (modal) modal.hide();
            }
            switchToCustomAddress(true);
        }

        function backToSavedAddress() {
            if (savedAddressesList.length > 0) {
                const targetAddr = savedAddressesList.find(a => a.id === currentSelectedAddressId) || savedAddressesList[0];
                applySelectedAddress(targetAddr);
            }
        }

        function syncCustomAddressToHidden() {
            const name = (document.getElementById('customReceiverName')?.value || '').trim();
            const phone = (document.getElementById('customReceiverPhone')?.value || '').trim();
            const street = (document.getElementById('checkoutStreet')?.value || '').trim();

            const p = document.getElementById('checkoutProvince');
            const d = document.getElementById('checkoutDistrict');
            const w = document.getElementById('checkoutWard');

            const pName = p && p.selectedIndex > 0 ? p.options[p.selectedIndex]?.dataset.name || '' : '';
            const dName = d && d.selectedIndex > 0 ? d.options[d.selectedIndex]?.dataset.name || '' : '';
            const wName = w && w.selectedIndex > 0 ? w.options[w.selectedIndex]?.dataset.name || '' : '';

            const recNameEl = document.getElementById('receiverName');
            const recPhoneEl = document.getElementById('receiverPhone');
            const shipAddrEl = document.getElementById('shippingAddress');

            if (recNameEl) recNameEl.value = name;
            if (recPhoneEl) recPhoneEl.value = phone;

            const addrParts = [street, wName, dName, pName].filter(Boolean);
            if (shipAddrEl) {
                shipAddrEl.value = addrParts.join(', ');
            }
        }

        async function loadCheckoutProvinces() {
            const provSelect = document.getElementById('checkoutProvince');
            if (!provSelect || provSelect.options.length > 1) return;

            try {
                const res = await fetch('/api/location/provinces');
                if (!res.ok) return;
                const data = await res.json();
                provSelect.innerHTML = '<option value="">-- Chọn Tỉnh/TP --</option>';
                data.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.code;
                    opt.dataset.name = p.name;
                    opt.textContent = p.name;
                    provSelect.appendChild(opt);
                });
            } catch (e) {
                console.error('Lỗi tải danh mục Tỉnh/TP:', e);
            }
        }

        async function onCheckoutProvinceChange(selectEl) {
            const distSelect = document.getElementById('checkoutDistrict');
            const wardSelect = document.getElementById('checkoutWard');
            distSelect.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
            wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
            wardSelect.disabled = true;

            const code = selectEl.value;
            if (!code) {
                distSelect.disabled = true;
                syncCustomAddressToHidden();
                return;
            }

            try {
                const res = await fetch(`/api/location/districts/${code}`);
                if (!res.ok) return;
                const data = await res.json();
                distSelect.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
                data.forEach(d => {
                    const opt = document.createElement('option');
                    opt.value = d.code;
                    opt.dataset.name = d.name;
                    opt.textContent = d.name;
                    distSelect.appendChild(opt);
                });
                distSelect.disabled = false;
            } catch (e) {
                console.error('Lỗi tải Quận/Huyện:', e);
            }
            syncCustomAddressToHidden();
        }

        async function onCheckoutDistrictChange(selectEl) {
            const wardSelect = document.getElementById('checkoutWard');
            wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';

            const code = selectEl.value;
            if (!code) {
                wardSelect.disabled = true;
                syncCustomAddressToHidden();
                return;
            }

            try {
                const res = await fetch(`/api/location/wards/${code}`);
                if (!res.ok) return;
                const data = await res.json();
                wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                data.forEach(w => {
                    const opt = document.createElement('option');
                    opt.value = w.code;
                    opt.dataset.name = w.name;
                    opt.textContent = w.name;
                    wardSelect.appendChild(opt);
                });
                wardSelect.disabled = false;
            } catch (e) {
                console.error('Lỗi tải Phường/Xã:', e);
            }
            syncCustomAddressToHidden();
        }

        function selectPaymentMethod(method) {
            const hidden = document.getElementById('paymentMethod');
            if (hidden) hidden.value = method;

            const radio = document.querySelector(`input[name="paymentMethodRadio"][value="${method}"]`);
            if (radio) radio.checked = true;

            ['COD', 'VNPAY', 'MOMO', 'ZALOPAY'].forEach(m => {
                const card = document.getElementById(`paymentMethodCard-${m}`);
                if (card) {
                    if (m === method) card.classList.add('active');
                    else card.classList.remove('active');
                }
            });
        }

        function onShippingMethodChange(method) {
            ['STANDARD', 'EXPRESS'].forEach(m => {
                const card = document.getElementById(`shippingMethodCard-${m}`);
                if (card) {
                    if (m === method) card.classList.add('active');
                    else card.classList.remove('active');
                }
            });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        const selectedCartItemsStorageKey =
            "selectedCartItemIds";

        let selectedCartItemIds = [];
        let selectedCheckoutItems = [];
        let currentCheckoutSubtotal = 0;
        let appliedCheckoutCouponCode = "";
        let appliedCheckoutDiscount = 0;

        document.addEventListener(
            "DOMContentLoaded",
            async function() {

                const checkoutForm =
                    document.getElementById("checkoutForm");

                checkoutForm.addEventListener(
                    "submit",
                    submitCheckoutForm
                );

                const btnApplyCoupon =
                    document.getElementById("btn-apply-checkout-coupon");
                if (btnApplyCoupon) {
                    btnApplyCoupon.addEventListener("click", applyCheckoutCoupon);
                }

                const hasSelectedProducts =
                    loadSelectedCartItemIds();

                if (!hasSelectedProducts) {
                    return;
                }

                await loadCheckoutSummary();
                await initUserAddressAndProfile();
            }
        );

        // =========================
        // ĐỌC SẢN PHẨM ĐÃ CHỌN
        // =========================

        function loadSelectedCartItemIds() {
            try {
                const storedValue =
                    sessionStorage.getItem(
                        selectedCartItemsStorageKey
                    );

                const parsedValue =
                    JSON.parse(storedValue ?? "[]");

                if (!Array.isArray(parsedValue)) {
                    throw new Error(
                        "Danh sách sản phẩm không hợp lệ."
                    );
                }

                selectedCartItemIds =
                    parsedValue
                        .map(id => Number(id))
                        .filter(id =>
                            Number.isInteger(id)
                            && id > 0
                        );

                selectedCartItemIds =
                    [...new Set(selectedCartItemIds)];

                if (selectedCartItemIds.length === 0) {
                    showSummaryError(
                        "Bạn chưa chọn sản phẩm để thanh toán."
                    );

                    disableOrderButton();

                    setTimeout(function() {
                        window.location.href = "/cart";
                    }, 1500);

                    return false;
                }

                return true;
            }
            catch (error) {
                console.error(
                    "Lỗi đọc selectedCartItemIds:",
                    error
                );

                showSummaryError(
                    "Danh sách sản phẩm được chọn không hợp lệ."
                );

                disableOrderButton();
                return false;
            }
        }

        // =========================
        // LOAD GIỎ HÀNG
        // =========================

        async function loadCheckoutSummary() {
            try {
                const response = await fetch("/api/cart", {
                    method: "GET",
                    credentials: "include",
                    headers: {
                        "Accept": "application/json"
                    }
                });

                if (response.status === 401) {
                    const returnUrl =
                        encodeURIComponent(
                            window.location.pathname
                            + window.location.search
                        );

                    window.location.href =
                        `/account/login?returnUrl=${returnUrl}`;

                    return;
                }

                const result =
                    await readJsonResponse(response);

                if (!response.ok) {
                    throw new Error(
                        result?.message
                        ?? result?.error
                        ?? "Không thể tải thông tin giỏ hàng."
                    );
                }

                const cartItems =
                    Array.isArray(result?.items)
                        ? result.items
                        : Array.isArray(result?.data?.items)
                            ? result.data.items
                            : [];

                selectedCheckoutItems =
                    cartItems.filter(item =>
                        selectedCartItemIds.includes(
                            Number(item.cartItemId)
                        )
                    );

                if (selectedCheckoutItems.length === 0) {
                    throw new Error(
                        "Sản phẩm được chọn không còn trong giỏ hàng."
                    );
                }

                if (
                    selectedCheckoutItems.length
                    !== selectedCartItemIds.length
                ) {
                    throw new Error(
                        "Một số sản phẩm đã chọn không còn trong giỏ hàng. Vui lòng quay lại giỏ hàng."
                    );
                }

                renderCheckoutSummary(
                    selectedCheckoutItems
                );
            }
            catch (error) {
                console.error(
                    "Load checkout summary error:",
                    error
                );

                showSummaryError(
                    error?.message
                    ?? "Không thể tải tóm tắt đơn hàng."
                );

                disableOrderButton();
            }
        }

        // =========================
        // HIỂN THỊ TÓM TẮT
        // =========================

        function renderCheckoutSummary(items) {
            const productList =
                document.getElementById(
                    "checkout-product-list"
                );

            productList.innerHTML = "";

            let subtotal = 0;

            items.forEach(item => {
                const productName =
                    item.productName
                    ?? "Sản phẩm";

                const thumbnailUrl =
                    item.thumbnailUrl
                    ?? item.imageUrl
                    ?? "/images/no-image.png";

                const unitPrice =
                    Number(item.unitPrice) || 0;

                const quantity =
                    Number(item.quantity) || 1;

                const lineTotal =
                    unitPrice * quantity;

                subtotal += lineTotal;

                const productItem =
                    document.createElement("div");

                productItem.className =
                    "checkout-product-item";

                const image =
                    document.createElement("img");

                image.className =
                    "checkout-product-image";

                image.src = thumbnailUrl;
                image.alt = productName;

                image.onerror = function() {
                    this.onerror = null;
                    this.src = "/images/no-image.png";
                };

                const productInfo =
                    document.createElement("div");

                productInfo.className =
                    "checkout-product-info";

                const nameElement =
                    document.createElement("div");

                nameElement.className =
                    "checkout-product-name";

                nameElement.textContent =
                    productName;

                const metaElement =
                    document.createElement("div");

                metaElement.className =
                    "checkout-product-meta";

                metaElement.textContent =
                    `${formatCurrency(unitPrice)} × ${quantity}`;

                const totalElement =
                    document.createElement("div");

                totalElement.className =
                    "checkout-product-line-total";

                totalElement.textContent =
                    formatCurrency(lineTotal);

                productInfo.appendChild(nameElement);
                productInfo.appendChild(metaElement);
                productInfo.appendChild(totalElement);

                productItem.appendChild(image);
                productItem.appendChild(productInfo);

                productList.appendChild(productItem);
            });

            currentCheckoutSubtotal = subtotal;
            const shippingFee = 0;
            const grandTotal =
                Math.max(subtotal - appliedCheckoutDiscount + shippingFee, 0);

            document.getElementById(
                "checkout-subtotal"
            ).textContent =
                formatCurrency(subtotal);

            document.getElementById(
                "checkout-shipping-fee"
            ).textContent =
                formatCurrency(shippingFee);

            document.getElementById(
                "checkout-grand-total"
            ).textContent =
                formatCurrency(grandTotal);

            document.getElementById(
                "checkout-summary-loading"
            ).classList.add("d-none");

            document.getElementById(
                "checkout-total-container"
            ).classList.remove("d-none");

            autoApplyCouponIfSaved();
        }

        // =========================
        // SUBMIT CHECKOUT
        // =========================

        async function submitCheckoutForm(event) {
            event.preventDefault();

            const checkoutMessage =
                document.getElementById(
                    "checkoutMessage"
                );

            checkoutMessage.innerHTML = "";

            if (
                !Array.isArray(selectedCartItemIds)
                || selectedCartItemIds.length === 0
            ) {
                showCheckoutMessage(
                    "Bạn chưa chọn sản phẩm để thanh toán.",
                    "danger"
                );

                disableOrderButton();
                return;
            }

            const body = {
                receiverName:
                    document.getElementById(
                        "receiverName"
                    ).value.trim(),

                receiverPhone:
                    document.getElementById(
                        "receiverPhone"
                    ).value.trim(),

                shippingAddress:
                    document.getElementById(
                        "shippingAddress"
                    ).value.trim(),

                note:
                    document.getElementById(
                        "note"
                    ).value.trim(),

                paymentMethod:
                    document.getElementById(
                        "paymentMethod"
                    ).value,

                couponCode:
                    appliedCheckoutCouponCode || null,

                cartItemIds:
                    selectedCartItemIds
            };

            if (!document.getElementById("customAddressBox").classList.contains("d-none")) {
                syncCustomAddressToHidden();
                body.receiverName = (document.getElementById("receiverName")?.value || "").trim();
                body.receiverPhone = (document.getElementById("receiverPhone")?.value || "").trim();
                body.shippingAddress = (document.getElementById("shippingAddress")?.value || "").trim();
            }

            if (!body.receiverName) {
                showCheckoutMessage("Vui lòng nhập họ tên người nhận.", "danger");
                return;
            }

            if (!body.receiverPhone) {
                showCheckoutMessage("Vui lòng nhập số điện thoại người nhận.", "danger");
                return;
            }

            if (!body.shippingAddress) {
                showCheckoutMessage("Vui lòng cung cấp đầy đủ địa chỉ nhận hàng.", "danger");
                return;
            }

            setOrderButtonLoading(true);

            try {
                const response =
                    await fetch(
                        "/api/orders/checkout",
                        {
                            method: "POST",
                            credentials: "include",
                            headers: {
                                "Content-Type":
                                    "application/json",

                                "Accept":
                                    "application/json"
                            },
                            body: JSON.stringify(body)
                        }
                    );

                if (response.status === 401) {
                    const returnUrl =
                        encodeURIComponent(
                            window.location.pathname
                            + window.location.search
                        );

                    window.location.href =
                        `/account/login?returnUrl=${returnUrl}`;

                    return;
                }

                const result =
                    await readJsonResponse(response);

                if (
                    !response.ok
                    || result?.success === false
                ) {
                    throw new Error(
                        result?.message
                        ?? result?.error
                        ?? "Đặt hàng thất bại."
                    );
                }

                sessionStorage.removeItem(
                    selectedCartItemsStorageKey
                );
                sessionStorage.removeItem("appliedCouponCode");

                // Nếu là thanh toán Online (VNPay, MoMo, ZaloPay), chuyển hướng người dùng sang cổng thanh toán
                if (result?.requiresRedirect && result?.paymentUrl) {
                    window.location.href = result.paymentUrl;
                    return;
                }

                const orderCode =
                    result?.orderCode ?? "";

                window.location.href =
                    `/checkout/success?orderCode=${encodeURIComponent(orderCode)
                    }`;
            }
            catch (error) {
                console.error(
                    "Checkout error:",
                    error
                );

                showCheckoutMessage(
                    error?.message
                    ?? "Có lỗi xảy ra khi đặt hàng. Vui lòng thử lại.",
                    "danger"
                );

                setOrderButtonLoading(false);
            }
        }

        // =========================
        // BUTTON
        // =========================

        function setOrderButtonLoading(isLoading) {
            const button =
                document.getElementById(
                    "btn-place-order"
                );

            button.disabled = isLoading;

            button.innerHTML = isLoading
                ? `
                            <span class="spinner-border
                                         spinner-border-sm
                                         me-2"
                                  role="status">
                            </span>
                            Đang đặt hàng...
                          `
                : "Đặt hàng";
        }

        function disableOrderButton() {
            const button =
                document.getElementById(
                    "btn-place-order"
                );

