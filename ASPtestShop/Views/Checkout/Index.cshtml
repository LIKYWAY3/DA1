        // =========================================================
        // 5. MÃ GIẢM GIÁ (MODAL & SYNC TỪ CART - CHUẨN XÁC THEO CART)
        // =========================================================
        function initSavedCoupon() {
            const savedCoupon = sessionStorage.getItem("appliedCouponCode");
            if (savedCoupon) {
                appliedCouponCode = savedCoupon;
                executeApplyCoupon(savedCoupon, true);
            } else {
                restoreSavedCouponUI();
            }
        }

        function openCouponModal() {
            loadAvailableCoupons();
            const modalEl = document.getElementById("couponModal");
            if (modalEl && window.bootstrap) {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        function handleCouponInput(val) {
            const btnApply = document.getElementById("btn-modal-apply");
            const btnClear = document.getElementById("btn-clear-coupon");
            const trimmed = (val || "").trim();

            if (trimmed.length > 0) {
                if (btnApply) {
                    btnApply.classList.add("active");
                    btnApply.removeAttribute("disabled");
                }
                if (btnClear) btnClear.style.display = "inline-flex";
            } else {
                if (btnApply) {
                    btnApply.classList.remove("active");
                    btnApply.setAttribute("disabled", "true");
                }
                if (btnClear) btnClear.style.display = "none";
            }
