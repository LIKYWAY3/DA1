@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container my-5">
    <div class="row g-4">

        <!-- THÔNG TIN NHẬN HÀNG -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-dark text-white py-3">
                    <h4 class="mb-0">Thông tin nhận hàng</h4>
                </div>

                <div class="card-body">
                    <div id="checkoutMessage"></div>

                    <!-- 3.1 & 3.2. SỔ ĐỊA CHỈ GIAO HÀNG & CHỌN ĐỊA CHỈ (Shopee style) -->
                    <div class="mb-4 p-3 bg-light rounded-3 border">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0 fw-bold text-dark">
                                <i class="fa fa-map-marker-alt text-danger me-2"></i>Địa chỉ nhận hàng
                            </h6>
                            <a href="/account/address" target="_blank" class="small text-decoration-none text-primary">
                                <i class="fa fa-cog me-1"></i>Quản lý sổ địa chỉ
                            </a>
                        </div>

                        <div id="savedAddressContainer" class="mb-3 d-none">
                            <label class="form-label small text-muted">Chọn từ sổ địa chỉ của bạn:</label>
                            <select id="savedAddressSelect" class="form-select form-select-sm" onchange="onSavedAddressSelected(this)">
                                <option value="">-- Chọn địa chỉ đã lưu --</option>
                            </select>
                        </div>

                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="useCustomAddressToggle" onchange="toggleCustomAddress(this.checked)">
                            <label class="form-check-label small fw-semibold" for="useCustomAddressToggle">
                                Nhập địa chỉ giao hàng mới khác
                            </label>
                        </div>

                        <div id="customAddressSection" class="d-none mt-3 pt-3 border-top">
                            <div class="row g-2 mb-2">
                                <div class="col-md-4">
                                    <label class="form-label small text-muted">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                                    <select id="checkoutProvince" class="form-select form-select-sm" onchange="onCheckoutProvinceChange(this)">
                                        <option value="">-- Chọn Tỉnh/TP --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small text-muted">Quận / Huyện <span class="text-danger">*</span></label>
                                    <select id="checkoutDistrict" class="form-select form-select-sm" disabled onchange="onCheckoutDistrictChange(this)">
                                        <option value="">-- Chọn Quận/Huyện --</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small text-muted">Phường / Xã <span class="text-danger">*</span></label>
                                    <select id="checkoutWard" class="form-select form-select-sm" disabled>
                                        <option value="">-- Chọn Phường/Xã --</option>
                                    </select>
                                </div>
                            </div>
                            <div class="mb-2">
                                <label class="form-label small text-muted">Số nhà, ngõ/ngách, tên đường <span class="text-danger">*</span></label>
                                <input type="text" id="checkoutStreet" class="form-control form-control-sm" placeholder="Ví dụ: Số 123 đường ABC" />
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-success" onclick="applyCustomAddress()">
                                <i class="fa fa-check me-1"></i>Áp dụng địa chỉ này
                            </button>
                        </div>
                    </div>

                    <form id="checkoutForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="receiverName" class="form-label fw-semibold">
                                    Tên người nhận <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       id="receiverName"
                                       class="form-control"
                                       placeholder="Nhập tên người nhận"
                                       maxlength="100"
                                       required>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label for="receiverPhone" class="form-label fw-semibold">
                                    Số điện thoại <span class="text-danger">*</span>
                                </label>
                                <input type="text"
                                       id="receiverPhone"
                                       class="form-control"
                                       placeholder="Nhập số điện thoại"
                                       maxlength="20"
                                       required>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="shippingAddress" class="form-label fw-semibold">
                                Địa chỉ giao hàng chi tiết <span class="text-danger">*</span>
                            </label>
                            <textarea id="shippingAddress"
                                      class="form-control"
                                      rows="3"
                                      maxlength="200"
                                      placeholder="Địa chỉ giao hàng sẽ tự động điền hoặc nhập thủ công"
                                      required></textarea>
                            <div class="form-text small text-muted">Bạn có thể chỉnh sửa địa chỉ này trước khi xác nhận đặt hàng.</div>
                        </div>

                        <div class="mb-3">
                            <label for="note" class="form-label">
                                Ghi chú
                            </label>

                            <textarea id="note"
                                      class="form-control"
                                      rows="3"
                                      maxlength="200"
                                      placeholder="Ghi chú thêm nếu có"></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="paymentMethod" class="form-label">
                                Phương thức thanh toán
                            </label>

                            <select id="paymentMethod" class="form-select">
                                <option value="COD" selected>
                                    Thanh toán khi nhận hàng (COD)
                                </option>
                                <option value="VNPAY">
                                    Cổng thanh toán VNPay (Thẻ ATM / QR / Visa / Master)
                                </option>
                                <option value="MOMO">
                                    Ví điện tử MoMo
                                </option>
                                <option value="ZALOPAY">
                                    Ví điện tử ZaloPay
                                </option>
                            </select>
                        </div>

                        <button type="submit"
                                id="btn-place-order"
                                class="btn btn-dark w-100 py-3">
                            Đặt hàng
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- TÓM TẮT ĐƠN HÀNG -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm checkout-summary">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0">Tóm tắt đơn hàng</h4>
                </div>

                <div class="card-body">

                    <!-- Loading -->
                    <div id="checkout-summary-loading"
                         class="text-center py-4">

                        <div class="spinner-border spinner-border-sm text-success"
                             role="status">
                            <span class="visually-hidden">
                                Đang tải...
                            </span>
                        </div>

                        <span class="ms-2">
                            Đang tải sản phẩm...
                        </span>
                    </div>

                    <!-- Thông báo lỗi -->
                    <div id="checkout-summary-error"
                         class="alert alert-danger d-none">
                    </div>

                    <!-- Danh sách sản phẩm -->
                    <div id="checkout-product-list"></div>

                    <!-- Tổng tiền -->
                    <div id="checkout-total-container"
                         class="d-none">

                        <hr>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Tổng tiền hàng</span>

                            <strong id="checkout-subtotal">
                                0 ₫
                            </strong>
                        </div>

                        <!-- Mã giảm giá -->
                        <div class="mb-3 pt-2 border-top">
                            <label class="form-label small fw-bold text-dark">Phiếu giảm giá (Coupon)</label>
                            <div class="input-group">
                                <input type="text"
                                       id="checkout-coupon-code"
                                       class="form-control text-uppercase"
                                       placeholder="Nhập mã giảm giá"
                                       onkeydown="if (event.key === 'Enter') { event.preventDefault(); applyCheckoutCoupon(); }">
                                <button type="button"
                                        id="btn-apply-checkout-coupon"
                                        class="btn btn-dark"
                                        onclick="applyCheckoutCoupon()">
                                    Áp dụng
                                </button>
                            </div>
                            <div id="checkout-coupon-message" class="mt-2 small"></div>
                        </div>

                        <!-- Dòng hiển thị giảm giá khuyến mãi -->
                        <div id="checkout-discount-row" class="d-flex justify-content-between mb-3 d-none">
                            <span class="text-success fw-semibold">Giảm giá khuyến mãi</span>
                            <strong id="checkout-discount-amount" class="text-success">- 0 ₫</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Phí vận chuyển</span>

                            <strong id="checkout-shipping-fee">
                                0 ₫
                            </strong>
                        </div>

                        <div class="d-flex justify-content-between
                            border-top pt-3">

                            <span class="fw-bold fs-5">
                                Tổng thanh toán
                            </span>

                            <strong id="checkout-grand-total"
                                    class="text-danger fs-5">
                                0 ₫
                            </strong>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a href="/cart"
                           class="text-decoration-none">
                            ← Quay lại giỏ hàng
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .checkout-summary {
        position: sticky;
        top: 90px;
    }

    .checkout-product-item {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 14px 0;
        border-bottom: 1px solid #e5e5e5;
    }

    .checkout-product-image {
        width: 80px;
        height: 80px;
        flex-shrink: 0;
        object-fit: contain;
        border: 1px solid #eeeeee;
        border-radius: 8px;
        background-color: #ffffff;
    }

    .checkout-product-info {
        flex: 1;
        min-width: 0;
    }

    .checkout-product-name {
        margin-bottom: 6px;
        font-weight: 600;
        color: #2f2f2f;
    }

    .checkout-product-meta {
        font-size: 14px;
        color: #6c757d;
    }

    .checkout-product-line-total {
        margin-top: 5px;
        font-weight: 700;
        color: #dc3545;
    }

    @@media (max-width: 991px) {
        .checkout-summary {
            position: static;
        }
    }
</style>

@section Scripts {
    <script>
        
        let savedAddressesList = [];

        async function initUserAddressAndProfile() {
            try {
                const addrRes = await fetch('/api/user/addresses');
                if (addrRes.ok) {
                    savedAddressesList = await addrRes.json();
                }

                const profileRes = await fetch('/api/user/profile-info');
                let userProfile = null;
                if (profileRes.ok) {
                    userProfile = await profileRes.json();
                }

                const receiverNameInput = document.getElementById('receiverName');
                const receiverPhoneInput = document.getElementById('receiverPhone');
                const shippingAddressInput = document.getElementById('shippingAddress');
                const savedContainer = document.getElementById('savedAddressContainer');
                const savedSelect = document.getElementById('savedAddressSelect');

                if (Array.isArray(savedAddressesList) && savedAddressesList.length > 0) {
                    savedContainer.classList.remove('d-none');
                    savedSelect.innerHTML = '<option value="">-- Chọn địa chỉ giao hàng --</option>';

                    let defaultAddr = null;
                    savedAddressesList.forEach(a => {
                        const opt = document.createElement('option');
                        opt.value = a.id;
                        opt.textContent = `${a.fullName} - ${a.phoneNumber} (${a.specificAddress})${a.isDefault ? ' [MẶC ĐỊNH]' : ''}`;
                        savedSelect.appendChild(opt);

                        if (a.isDefault) defaultAddr = a;
                    });

                    const targetAddr = defaultAddr || savedAddressesList[0];
                    if (targetAddr) {
                        savedSelect.value = targetAddr.id;
                        receiverNameInput.value = targetAddr.fullName || '';
                        receiverPhoneInput.value = targetAddr.phoneNumber || '';
                        shippingAddressInput.value = targetAddr.specificAddress || '';
                    }
                } else if (userProfile) {
                    receiverNameInput.value = userProfile.fullName || '';
                    receiverPhoneInput.value = userProfile.phoneNumber || '';
                    document.getElementById('useCustomAddressToggle').checked = true;
                    toggleCustomAddress(true);
                }
            } catch (err) {
                console.warn('Lỗi tải thông tin địa chỉ/profile:', err);
            }
        }

        function onSavedAddressSelected(selectEl) {
            const selectedId = Number(selectEl.value);
            const addr = savedAddressesList.find(a => a.id === selectedId);
            if (addr) {
                document.getElementById('receiverName').value = addr.fullName || '';
                document.getElementById('receiverPhone').value = addr.phoneNumber || '';
                document.getElementById('shippingAddress').value = addr.specificAddress || '';
            }
        }

        function toggleCustomAddress(show) {
            const sec = document.getElementById('customAddressSection');
            if (show) {
                sec.classList.remove('d-none');
                loadCheckoutProvinces();
            } else {
                sec.classList.add('d-none');
            }
        }

        async function loadCheckoutProvinces() {
            const provSelect = document.getElementById('checkoutProvince');
            if (provSelect.options.length > 1) return;

            try {
                const res = await fetch('/api/location/provinces');
                if (!res.ok) return;
                const data = await res.json();
                provSelect.innerHTML = '<option value="">-- Chọn Tỉnh/TP --</option>';
                data.forEach(p => {
                    const opt = document.createElement('option');
                    opt.value = p.code;
                    opt.dataset.name = p.name;
                    opt.textContent = p.name;
                    provSelect.appendChild(opt);
                });
            } catch (e) {
                console.error(e);
            }
        }

        async function onCheckoutProvinceChange(selectEl) {
            const distSelect = document.getElementById('checkoutDistrict');
            const wardSelect = document.getElementById('checkoutWard');
            distSelect.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
            wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
            wardSelect.disabled = true;

            const code = selectEl.value;
            if (!code) {
                distSelect.disabled = true;
                return;
            }

            try {
                const res = await fetch(`/api/location/districts/${code}`);
                if (!res.ok) return;
                const data = await res.json();
                distSelect.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
                data.forEach(d => {
                    const opt = document.createElement('option');
                    opt.value = d.code;
                    opt.dataset.name = d.name;
                    opt.textContent = d.name;
                    distSelect.appendChild(opt);
                });
                distSelect.disabled = false;
            } catch (e) {
                console.error(e);
            }
        }

        async function onCheckoutDistrictChange(selectEl) {
            const wardSelect = document.getElementById('checkoutWard');
            wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';

            const code = selectEl.value;
            if (!code) {
                wardSelect.disabled = true;
                return;
            }

            try {
                const res = await fetch(`/api/location/wards/${code}`);
                if (!res.ok) return;
                const data = await res.json();
                wardSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                data.forEach(w => {
                    const opt = document.createElement('option');
                    opt.value = w.code;
                    opt.dataset.name = w.name;
                    opt.textContent = w.name;
                    wardSelect.appendChild(opt);
                });
                wardSelect.disabled = false;
            } catch (e) {
                console.error(e);
            }
        }

        function applyCustomAddress() {
            const p = document.getElementById('checkoutProvince');
            const d = document.getElementById('checkoutDistrict');
            const w = document.getElementById('checkoutWard');
            const street = document.getElementById('checkoutStreet').value.trim();

            const pName = p.options[p.selectedIndex]?.dataset.name || '';
            const dName = d.options[d.selectedIndex]?.dataset.name || '';
            const wName = w.options[w.selectedIndex]?.dataset.name || '';

            if (!pName || !dName || !wName || !street) {
                alert('Vui lòng chọn đầy đủ Tỉnh/Thành phố, Quận/Huyện, Phường/Xã và Số nhà tên đường.');
                return;
            }

            const fullAddr = `${street}, ${wName}, ${dName}, ${pName}`;
            document.getElementById('shippingAddress').value = fullAddr;
            alert('Đã cập nhật địa chỉ giao hàng thành công!');
        }

        const selectedCartItemsStorageKey =
            "selectedCartItemIds";

        let selectedCartItemIds = [];
        let selectedCheckoutItems = [];
        let currentCheckoutSubtotal = 0;
        let appliedCheckoutCouponCode = "";
        let appliedCheckoutDiscount = 0;

        document.addEventListener(
            "DOMContentLoaded",
            async function() {

                const checkoutForm =
                    document.getElementById("checkoutForm");

                checkoutForm.addEventListener(
                    "submit",
                    submitCheckoutForm
                );

                const btnApplyCoupon =
                    document.getElementById("btn-apply-checkout-coupon");
                if (btnApplyCoupon) {
                    btnApplyCoupon.addEventListener("click", applyCheckoutCoupon);
                }

                const hasSelectedProducts =
                    loadSelectedCartItemIds();

                if (!hasSelectedProducts) {
                    return;
                }

                await loadCheckoutSummary();
                await initUserAddressAndProfile();
            }
        );

        // =========================
        // ĐỌC SẢN PHẨM ĐÃ CHỌN
        // =========================

        function loadSelectedCartItemIds() {
            try {
                const storedValue =
                    sessionStorage.getItem(
                        selectedCartItemsStorageKey
                    );

                const parsedValue =
                    JSON.parse(storedValue ?? "[]");

                if (!Array.isArray(parsedValue)) {
                    throw new Error(
                        "Danh sách sản phẩm không hợp lệ."
                    );
                }

                selectedCartItemIds =
                    parsedValue
                        .map(id => Number(id))
                        .filter(id =>
                            Number.isInteger(id)
                            && id > 0
                        );

                selectedCartItemIds =
                    [...new Set(selectedCartItemIds)];

                if (selectedCartItemIds.length === 0) {
                    showSummaryError(
                        "Bạn chưa chọn sản phẩm để thanh toán."
                    );

                    disableOrderButton();

                    setTimeout(function() {
                        window.location.href = "/cart";
                    }, 1500);

                    return false;
                }

                return true;
            }
            catch (error) {
                console.error(
                    "Lỗi đọc selectedCartItemIds:",
                    error
                );

                showSummaryError(
                    "Danh sách sản phẩm được chọn không hợp lệ."
                );

                disableOrderButton();
                return false;
            }
        }

        // =========================
        // LOAD GIỎ HÀNG
        // =========================

        async function loadCheckoutSummary() {
            try {
                const response = await fetch("/api/cart", {
                    method: "GET",
                    credentials: "include",
                    headers: {
                        "Accept": "application/json"
                    }
                });

                if (response.status === 401) {
                    const returnUrl =
                        encodeURIComponent(
                            window.location.pathname
                            + window.location.search
                        );

                    window.location.href =
                        `/account/login?returnUrl=${returnUrl}`;

                    return;
                }

                const result =
                    await readJsonResponse(response);

                if (!response.ok) {
                    throw new Error(
                        result?.message
                        ?? result?.error
                        ?? "Không thể tải thông tin giỏ hàng."
                    );
                }

                const cartItems =
                    Array.isArray(result?.items)
                        ? result.items
                        : Array.isArray(result?.data?.items)
                            ? result.data.items
                            : [];

                selectedCheckoutItems =
                    cartItems.filter(item =>
                        selectedCartItemIds.includes(
                            Number(item.cartItemId)
                        )
                    );

                if (selectedCheckoutItems.length === 0) {
                    throw new Error(
                        "Sản phẩm được chọn không còn trong giỏ hàng."
                    );
                }

                if (
                    selectedCheckoutItems.length
                    !== selectedCartItemIds.length
                ) {
                    throw new Error(
                        "Một số sản phẩm đã chọn không còn trong giỏ hàng. Vui lòng quay lại giỏ hàng."
                    );
                }

                renderCheckoutSummary(
                    selectedCheckoutItems
                );
            }
            catch (error) {
                console.error(
                    "Load checkout summary error:",
                    error
                );

                showSummaryError(
                    error?.message
                    ?? "Không thể tải tóm tắt đơn hàng."
                );

                disableOrderButton();
            }
        }

        // =========================
        // HIỂN THỊ TÓM TẮT
        // =========================

        function renderCheckoutSummary(items) {
            const productList =
                document.getElementById(
                    "checkout-product-list"
                );

            productList.innerHTML = "";

            let subtotal = 0;

            items.forEach(item => {
                const productName =
                    item.productName
                    ?? "Sản phẩm";

                const thumbnailUrl =
                    item.thumbnailUrl
                    ?? item.imageUrl
                    ?? "/images/no-image.png";

                const unitPrice =
                    Number(item.unitPrice) || 0;

                const quantity =
                    Number(item.quantity) || 1;

                const lineTotal =
                    unitPrice * quantity;

                subtotal += lineTotal;

                const productItem =
                    document.createElement("div");

                productItem.className =
                    "checkout-product-item";

                const image =
                    document.createElement("img");

                image.className =
                    "checkout-product-image";

                image.src = thumbnailUrl;
                image.alt = productName;

                image.onerror = function() {
                    this.onerror = null;
                    this.src = "/images/no-image.png";
                };

                const productInfo =
                    document.createElement("div");

                productInfo.className =
                    "checkout-product-info";

                const nameElement =
                    document.createElement("div");

                nameElement.className =
                    "checkout-product-name";

                nameElement.textContent =
                    productName;

                const metaElement =
                    document.createElement("div");

                metaElement.className =
                    "checkout-product-meta";

                metaElement.textContent =
                    `${formatCurrency(unitPrice)} × ${quantity}`;

                const totalElement =
                    document.createElement("div");

                totalElement.className =
                    "checkout-product-line-total";

                totalElement.textContent =
                    formatCurrency(lineTotal);

                productInfo.appendChild(nameElement);
                productInfo.appendChild(metaElement);
                productInfo.appendChild(totalElement);

                productItem.appendChild(image);
                productItem.appendChild(productInfo);

                productList.appendChild(productItem);
            });

            currentCheckoutSubtotal = subtotal;
            const shippingFee = 0;
            const grandTotal =
                Math.max(subtotal - appliedCheckoutDiscount + shippingFee, 0);

            document.getElementById(
                "checkout-subtotal"
            ).textContent =
                formatCurrency(subtotal);

            document.getElementById(
                "checkout-shipping-fee"
            ).textContent =
                formatCurrency(shippingFee);

            document.getElementById(
                "checkout-grand-total"
            ).textContent =
                formatCurrency(grandTotal);

            document.getElementById(
                "checkout-summary-loading"
            ).classList.add("d-none");

            document.getElementById(
                "checkout-total-container"
            ).classList.remove("d-none");

            autoApplyCouponIfSaved();
        }

        // =========================
        // SUBMIT CHECKOUT
        // =========================

        async function submitCheckoutForm(event) {
            event.preventDefault();

            const checkoutMessage =
                document.getElementById(
                    "checkoutMessage"
                );

            checkoutMessage.innerHTML = "";

            if (
                !Array.isArray(selectedCartItemIds)
                || selectedCartItemIds.length === 0
            ) {
                showCheckoutMessage(
                    "Bạn chưa chọn sản phẩm để thanh toán.",
                    "danger"
                );

                disableOrderButton();
                return;
            }

            const body = {
                receiverName:
                    document.getElementById(
                        "receiverName"
                    ).value.trim(),

                receiverPhone:
                    document.getElementById(
                        "receiverPhone"
                    ).value.trim(),

                shippingAddress:
                    document.getElementById(
                        "shippingAddress"
                    ).value.trim(),

                note:
                    document.getElementById(
                        "note"
                    ).value.trim(),

                paymentMethod:
                    document.getElementById(
                        "paymentMethod"
                    ).value,

                couponCode:
                    appliedCheckoutCouponCode || null,

                cartItemIds:
                    selectedCartItemIds
            };

            if (
                !body.receiverName
                || !body.receiverPhone
                || !body.shippingAddress
            ) {
                showCheckoutMessage(
                    "Vui lòng nhập đầy đủ thông tin nhận hàng.",
                    "danger"
                );

                return;
            }

            setOrderButtonLoading(true);

            try {
                const response =
                    await fetch(
                        "/api/orders/checkout",
                        {
                            method: "POST",
                            credentials: "include",
                            headers: {
                                "Content-Type":
                                    "application/json",

                                "Accept":
                                    "application/json"
                            },
                            body: JSON.stringify(body)
                        }
                    );

                if (response.status === 401) {
                    const returnUrl =
                        encodeURIComponent(
                            window.location.pathname
                            + window.location.search
                        );

                    window.location.href =
                        `/account/login?returnUrl=${returnUrl}`;

                    return;
                }

                const result =
                    await readJsonResponse(response);

                if (
                    !response.ok
                    || result?.success === false
                ) {
                    throw new Error(
                        result?.message
                        ?? result?.error
                        ?? "Đặt hàng thất bại."
                    );
                }

                sessionStorage.removeItem(
                    selectedCartItemsStorageKey
                );
                sessionStorage.removeItem("appliedCouponCode");

                // Nếu là thanh toán Online (VNPay, MoMo, ZaloPay), chuyển hướng người dùng sang cổng thanh toán
                if (result?.requiresRedirect && result?.paymentUrl) {
                    window.location.href = result.paymentUrl;
                    return;
                }

                const orderCode =
                    result?.orderCode ?? "";

                window.location.href =
                    `/checkout/success?orderCode=${encodeURIComponent(orderCode)
                    }`;
            }
            catch (error) {
                console.error(
                    "Checkout error:",
                    error
                );

                showCheckoutMessage(
                    error?.message
                    ?? "Có lỗi xảy ra khi đặt hàng. Vui lòng thử lại.",
                    "danger"
                );

                setOrderButtonLoading(false);
            }
        }

        // =========================
        // BUTTON
        // =========================

        function setOrderButtonLoading(isLoading) {
            const button =
                document.getElementById(
                    "btn-place-order"
                );

            button.disabled = isLoading;

            button.innerHTML = isLoading
                ? `
                            <span class="spinner-border
                                         spinner-border-sm
                                         me-2"
                                  role="status">
                            </span>
                            Đang đặt hàng...
                          `
                : "Đặt hàng";
        }

        function disableOrderButton() {
            const button =
                document.getElementById(
                    "btn-place-order"
                );

            if (button) {
                button.disabled = true;
            }
        }

        // =========================
        // THÔNG BÁO
        // =========================

        function showCheckoutMessage(
            message,
            type
        ) {
            const checkoutMessage =
                document.getElementById(
                    "checkoutMessage"
                );

            checkoutMessage.innerHTML = "";

            const alert =
                document.createElement("div");

            alert.className =
                `alert alert-${type}`;

            alert.textContent =
                message;

            checkoutMessage.appendChild(alert);
        }

        function showSummaryError(message) {
            document.getElementById(
                "checkout-summary-loading"
            )?.classList.add("d-none");

            const errorElement =
                document.getElementById(
                    "checkout-summary-error"
                );

            errorElement.textContent =
                message;

            errorElement.classList.remove(
                "d-none"
            );
        }

        // =========================
        // HELPERS
        // =========================

        async function readJsonResponse(response) {
            const contentType =
                response.headers.get(
                    "content-type"
                ) ?? "";

            if (
                !contentType.includes(
                    "application/json"
                )
            ) {
                return null;
            }

            try {
                return await response.json();
            }
            catch {
                return null;
            }
        }

        function formatCurrency(value) {
            return new Intl.NumberFormat(
                "vi-VN",
                {
                    style: "currency",
                    currency: "VND"
                }
            ).format(Number(value) || 0);
        }

        // =========================
        // CHECKOUT COUPON
        // =========================
        function autoApplyCouponIfSaved() {
            const savedCoupon = sessionStorage.getItem("appliedCouponCode");
            if (savedCoupon && !appliedCheckoutCouponCode) {
                const couponInput = document.getElementById("checkout-coupon-code");
                if (couponInput) {
                    couponInput.value = savedCoupon;
                    applyCheckoutCoupon();
                }
            }
        }

        async function applyCheckoutCoupon() {
            const input = document.getElementById("checkout-coupon-code");
            const btn = document.getElementById("btn-apply-checkout-coupon");
            const code = input ? input.value.trim().toUpperCase() : "";

            if (!code) {
                showCheckoutCouponMessage("Vui lòng nhập mã giảm giá", "warning");
                if (input) input.focus();
                return;
            }

            if (currentCheckoutSubtotal <= 0 && selectedCheckoutItems && selectedCheckoutItems.length > 0) {
                currentCheckoutSubtotal = selectedCheckoutItems.reduce((acc, item) => acc + (Number(item.unitPrice) || 0) * (Number(item.quantity) || 1), 0);
            }

            if (currentCheckoutSubtotal <= 0) {
                showCheckoutCouponMessage("Không có sản phẩm nào để tính giảm giá", "warning");
                return;
            }

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Đang xử lý...';
            }

            try {
                const response = await fetch("/api/coupons/apply", {
                    method: "POST",
                    credentials: "include",
                    headers: {
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    body: JSON.stringify({
                        couponCode: code,
                        subtotal: currentCheckoutSubtotal,
                        cartItemIds: selectedCartItemIds
                    })
                });

                const data = await response.json();

                if (!response.ok || !data.success) {
                    showCheckoutCouponMessage(data.message || "Mã giảm giá không hợp lệ", "danger");
                    removeCheckoutCoupon(false);
                    return;
                }

                appliedCheckoutCouponCode = data.couponCode;
                appliedCheckoutDiscount = Number(data.discountAmount) || 0;
                sessionStorage.setItem("appliedCouponCode", data.couponCode);

                // Cập nhật dòng chiết khấu
                const discountRow = document.getElementById("checkout-discount-row");
                const discountAmountEl = document.getElementById("checkout-discount-amount");
                if (discountRow && discountAmountEl) {
                    discountAmountEl.textContent = `- ${formatCurrency(appliedCheckoutDiscount)}`;
                    discountRow.classList.remove("d-none");
                }

                // Cập nhật tổng thanh toán
                const grandTotalEl = document.getElementById("checkout-grand-total");
                if (grandTotalEl) {
                    grandTotalEl.textContent = formatCurrency(Math.max(currentCheckoutSubtotal - appliedCheckoutDiscount, 0));
                }

                showCheckoutCouponMessage(`
                    <div class="d-flex justify-content-between align-items-center text-success">
                        <span><i class="fa fa-check-circle text-success me-1"></i> Đã áp dụng <strong>${data.couponCode}</strong> (-${formatCurrency(appliedCheckoutDiscount)})</span>
                        <button type="button" class="btn btn-sm btn-link text-danger p-0 text-decoration-none" onclick="removeCheckoutCoupon(true)">Xóa</button>
                    </div>
                `, "success");

            } catch (err) {
                showCheckoutCouponMessage("Lỗi mạng khi kiểm tra mã giảm giá", "danger");
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = "Áp dụng";
                }
            }
        }
        window.applyCheckoutCoupon = applyCheckoutCoupon;

        function removeCheckoutCoupon(clearInput = true) {
            appliedCheckoutCouponCode = "";
            appliedCheckoutDiscount = 0;
            sessionStorage.removeItem("appliedCouponCode");

            const discountRow = document.getElementById("checkout-discount-row");
            if (discountRow) {
                discountRow.classList.add("d-none");
            }

            const grandTotalEl = document.getElementById("checkout-grand-total");
            if (grandTotalEl) {
                grandTotalEl.textContent = formatCurrency(currentCheckoutSubtotal);
            }

            if (clearInput) {
                const input = document.getElementById("checkout-coupon-code");
                if (input) input.value = "";
                const msgBox = document.getElementById("checkout-coupon-message");
                if (msgBox) msgBox.innerHTML = "";
            }
        }
        window.removeCheckoutCoupon = removeCheckoutCoupon;

        function showCheckoutCouponMessage(msg, type = "info") {
            const msgBox = document.getElementById("checkout-coupon-message");
            if (!msgBox) return;
            msgBox.innerHTML = `<div class="alert alert-${type} py-1 px-2 mb-0 small">${msg}</div>`;
        }
    </script>
}