@{
    ViewData["Title"] = "Đặt hàng thành công";
    var isVietQr = ViewBag.VietQrUrl != null;
}

<div class="container my-5">
    <div class="card shadow-sm border" style="border-color: #2f2f2f; border-radius: 8px;">
        <div class="card-body p-4 p-md-5">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-dark text-white rounded-circle mb-3" style="width: 64px; height: 64px;">
                    <i class="fa fa-check fa-2x"></i>
                </div>
                <h2 class="fw-bold text-dark mb-2">Đặt hàng thành công</h2>
                <p class="text-muted mb-0">Cảm ơn bạn đã tin tưởng mua sắm tại Fuu Fishing Store.</p>
                @if (!string.IsNullOrWhiteSpace(ViewBag.OrderCode))
                {
                    <div class="mt-2">
                        <span class="text-muted">Mã đơn hàng:</span>
                        <strong class="font-monospace text-dark ms-1">@ViewBag.OrderCode</strong>
                    </div>
                }
            </div>

            @if (isVietQr)
            {
                <div class="border rounded p-4 mb-4" style="border: 1px solid #2f2f2f !important; background-color: #fdfdfd;">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <i class="fa fa-qrcode text-dark fs-5"></i>
                        <h5 class="fw-bold text-dark mb-0">Quét mã VietQR chuyển khoản (NAPAS 24/7)</h5>
                    </div>

                    <div class="row g-4 align-items-center">
                        <div class="col-12 col-md-5 text-center">
                            <div class="d-inline-block p-2 bg-white rounded shadow-sm" style="border: 1px solid #2f2f2f;">
                                <img src="@ViewBag.VietQrUrl" alt="Mã VietQR thanh toán đơn hàng @ViewBag.OrderCode" class="img-fluid rounded" style="max-width: 260px; height: auto;" />
                            </div>
                            <div class="small text-muted mt-2">
                                <i class="fa fa-mobile-alt me-1"></i> Mở app ngân hàng hoặc ví điện tử bất kỳ để quét mã
                            </div>
                        </div>

                        <div class="col-12 col-md-7">
                            <div class="table-responsive">
                                <table class="table table-sm table-borderless align-middle mb-0">
                                    <tbody>
                                        <tr>
                                            <td class="text-muted" style="width: 140px;">Ngân hàng:</td>
                                            <td><strong class="text-dark">@ViewBag.BankName</strong></td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Số tài khoản:</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="fs-5 fw-bold text-dark font-monospace">@ViewBag.AccountNo</span>
                                                    <button type="button" class="btn btn-sm btn-outline-dark px-2 py-1" onclick="copyToClipboard('@ViewBag.AccountNo', 'Đã sao chép số tài khoản!')" title="Sao chép số tài khoản">
                                                        <i class="fa fa-copy me-1"></i>Sao chép
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Chủ tài khoản:</td>
                                            <td><strong class="text-dark">@ViewBag.AccountName</strong></td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Số tiền:</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="fs-5 fw-bold text-danger">@string.Format("{0:N0} ₫", ViewBag.Amount)</span>
                                                    <button type="button" class="btn btn-sm btn-outline-dark px-2 py-1" onclick="copyToClipboard('@ViewBag.Amount', 'Đã sao chép số tiền!')" title="Sao chép số tiền">
                                                        <i class="fa fa-copy me-1"></i>Sao chép
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Nội dung CK:</td>
                                            <td>
                                                <div class="d-flex align-items-center gap-2">
                                                    <span class="badge bg-dark font-monospace fs-6 px-3 py-2">@ViewBag.OrderCode</span>
                                                    <button type="button" class="btn btn-sm btn-outline-dark px-2 py-1" onclick="copyToClipboard('@ViewBag.OrderCode', 'Đã sao chép nội dung chuyển khoản!')" title="Sao chép nội dung chuyển khoản">
                                                        <i class="fa fa-copy me-1"></i>Sao chép
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="mt-3 p-3 bg-light rounded" style="border-left: 3px solid #2f2f2f;">
                                <div class="small text-secondary">
                                    <strong class="text-dark">Lưu ý quan trọng:</strong> Vui lòng chuyển khoản đúng chính xác nội dung <span class="fw-bold font-monospace text-dark">@ViewBag.OrderCode</span> để hệ thống tự động nhận diện và cập nhật trạng thái đơn hàng nhanh chóng.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
                <a href="/Shop" class="btn btn-dark px-4 py-2">
                    <i class="fa fa-shopping-bag me-2"></i>Tiếp tục mua hàng
                </a>
                <a href="/orders/history" class="btn btn-outline-dark px-4 py-2">
                    <i class="fa fa-receipt me-2"></i>Xem lịch sử đơn hàng
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    function copyToClipboard(text, message) {
        if (!navigator.clipboard) {
            const temp = document.createElement("input");
            temp.value = text;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand("copy");
            document.body.removeChild(temp);
            alert(message || "Đã sao chép vào bộ nhớ tạm");
            return;
        }

        navigator.clipboard.writeText(text).then(function() {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: message || 'Đã sao chép',
                    showConfirmButton: false,
                    timer: 2000
                });
            } else {
                alert(message || "Đã sao chép vào bộ nhớ tạm");
            }
        }).catch(function(err) {
            console.error("Lỗi khi sao chép:", err);
        });
    }
</script>
