											<p>"Đối với tôi, câu cá cuối tuần là khoảng thời gian để tái tạo năng lượng và thư giãn sau những giờ làm việc căng thẳng. Đồ câu ở shop không chỉ có hiệu suất cao mà thiết kế còn vô cùng tinh tế, sang trọng, mang lại cảm giác thượng lưu khi sử dụng. Dịch vụ tư vấn chu đáo, đóng gói cẩn thận giúp tôi hoàn toàn an tâm khi mua sắm online."</p>
										</blockquote>

										<div class="author-info">
											<div class="author-pic">
												<img src="images/person_1.jpg" alt="Person-3" class="img-fluid">
											</div>
											<h3 class="font-weight-bold">Lê Minh Trí</h3>
											<span class="position d-block mb-3">CEO, Founder T&M Investment</span>
										</div>
									</div>

								</div>
							</div>
						</div>
						<!-- END item -->

					</div>

				</div>
			</div>
		</div>
	</div>
</div>
<!-- End Testimonial Slider -->
@section Scripts {
	<script>
		document.addEventListener("DOMContentLoaded", function () {
			loadFeaturedProducts();
		});

		async function loadFeaturedProducts() {
			const productList =
				document.getElementById("product-list");

			if (!productList) {
				return;
			}

			let skeletonHtml = "";
			for (let i = 0; i < 6; i++) {
				skeletonHtml += `
					<div class="fuu-retail-card" style="opacity: 0.6; min-width: 216px;">
						<div style="height: 24px;"></div>
						<div class="fuu-card-thumb-wrap">
							<div style="width: 130px; height: 130px; background: #e2e8f0; border-radius: 8px;"></div>
						</div>
						<div class="fuu-card-info">
							<div style="height: 16px; background: #e2e8f0; border-radius: 4px; margin-bottom: 8px;"></div>
							<div style="height: 18px; width: 65%; background: #e2e8f0; border-radius: 4px;"></div>
						</div>
					</div>
				`;
			}
			productList.innerHTML = skeletonHtml;

			try {
				const response = await fetch(
					"/api/products/featured",
					{
						method: "GET",
						headers: {
							"Accept": "application/json"
						}
					}
				);

				if (!response.ok) {
					throw new Error(
						`Không tải được sản phẩm nổi bật. Lỗi ${response.status}`
					);
				}

				const result = await response.json();

				const products =
					Array.isArray(result)
						? result
						: Array.isArray(result?.data)
							? result.data
							: Array.isArray(result?.items)
								? result.items
								: [];

				renderFeaturedProducts(products);
			}
			catch (error) {
				console.error(
					"Load featured products error:",
					error
				);

				productList.innerHTML = `
					<div class="col-12">
						<div class="alert alert-danger text-center">
							Không thể tải sản phẩm nổi bật.
						</div>
					</div>
				`;
			}
		}

		// Autoplay / Tự động lướt sản phẩm gợi ý
		let showcaseAutoplayTimer = null;

		function startShowcaseAutoplay() {
			stopShowcaseAutoplay();
			showcaseAutoplayTimer = setInterval(function () {
				const track = document.getElementById("product-list");
				if (!track) return;
				const maxScroll = track.scrollWidth - track.clientWidth;
				// Nếu đã cuộn gần hết (còn ít hơn 25px) -> lướt mượt về đầu trang
				if (track.scrollLeft >= maxScroll - 25) {
					track.scrollTo({ left: 0, behavior: "smooth" });
				} else {
					// Lướt qua 1 thẻ (khoảng 230px: 216px card + 14px gap)
					track.scrollBy({ left: 230, behavior: "smooth" });
				}
			}, 3500);
		}

		function stopShowcaseAutoplay() {
			if (showcaseAutoplayTimer) {
				clearInterval(showcaseAutoplayTimer);
				showcaseAutoplayTimer = null;
			}
		}

		function restartShowcaseAutoplay() {
			stopShowcaseAutoplay();
			startShowcaseAutoplay();
		}

		function initShowcaseInteractions() {
			const wrapper = document.querySelector(".fuu-showcase-wrapper");
			if (!wrapper || wrapper.dataset.bound) return;
			wrapper.dataset.bound = "true";

			// Tạm dừng khi rê chuột vào để người dùng dễ xem và click
			wrapper.addEventListener("mouseenter", stopShowcaseAutoplay);
			wrapper.addEventListener("mouseleave", startShowcaseAutoplay);

			// Tạm dừng trên cảm ứng khi chạm
			wrapper.addEventListener("touchstart", stopShowcaseAutoplay, { passive: true });
			wrapper.addEventListener("touchend", startShowcaseAutoplay, { passive: true });
		}

		// Render sản phẩm gợi ý dạng retail slider
		function renderFeaturedProducts(products) {
			const productList = document.getElementById("product-list");
			if (!productList) return;

			productList.innerHTML = "";

			if (!products || products.length === 0) {
				productList.innerHTML = `
					<div class="text-center py-5 w-100">
						<p class="text-muted mb-0">Hiện chưa có sản phẩm gợi ý.</p>
					</div>
				`;
				return;
			}

			let htmlContent = "";

			products.forEach(product => {
				const productId = Number(product.productId ?? product.id);
				if (!Number.isInteger(productId) || productId <= 0) return;

				const productName = product.productName ?? product.name ?? "Sản phẩm";
				const price = Number(product.price ?? product.salePrice ?? 0);
				const originalPrice = Number(product.originalPrice ?? product.price ?? 0);
				const imageUrl = product.thumbnailUrl ?? product.imageUrl ?? "/images/no-image.png";

				// Tính % giảm giá nếu originalPrice > price
				let discountBadgeHtml = "";
				let originalPriceHtml = "";
				if (originalPrice > price && originalPrice > 0) {
					const pct = Math.round(((originalPrice - price) / originalPrice) * 100);
					if (pct > 0) {
						discountBadgeHtml = `<span class="fuu-badge-discount">Giảm ${pct}%</span>`;
						originalPriceHtml = `<span class="fuu-price-original">${formatCurrency(originalPrice)}</span>`;
					}
				}

				htmlContent += `
					<div class="fuu-retail-card">
						<div class="fuu-card-badges">
							${discountBadgeHtml}
						</div>

						<a href="/Product/Detail/${productId}" class="fuu-card-thumb-wrap">
							<img src="${escapeAttribute(imageUrl)}"
								 alt="${escapeAttribute(productName)}"
								 class="fuu-card-thumb"
								 loading="lazy"
								 onerror="this.onerror=null; this.src='/images/no-image.png';">
						</a>

						<div class="fuu-card-info">
							<a href="/Product/Detail/${productId}" class="fuu-card-title" title="${escapeAttribute(productName)}">
								${escapeHtml(productName)}
							</a>

							<div class="fuu-card-price-row">
								<strong class="fuu-price-current">${formatCurrency(price)}</strong>
								${originalPriceHtml}
							</div>
						</div>

						<!-- Nút dấu cộng xem chi tiết khi hover giống sản phẩm khác -->
						<a href="/Product/Detail/${productId}" class="fuu-card-cross" title="Xem chi tiết">
							<img src="/images/cross.svg" alt="Xem chi tiết" class="img-fluid">
						</a>
					</div>
				`;
			});

			productList.innerHTML = htmlContent;

			// Kích hoạt tự động lướt và bắt sự kiện hover/touch
			startShowcaseAutoplay();
			initShowcaseInteractions();
		}

		function scrollFeaturedTrack(direction) {
			const track = document.getElementById("product-list");
			if (!track) return;
			const scrollAmount = 460 * direction;
			track.scrollBy({ left: scrollAmount, behavior: "smooth" });
			restartShowcaseAutoplay();
		}

		function formatCurrency(value) {
			return new Intl.NumberFormat(
				"vi-VN",
				{
					style: "currency",
					currency: "VND"
				}
			).format(Number(value) || 0);
		}

		function escapeHtml(value) {
			return String(value ?? "")
				.replaceAll("&", "&amp;")
				.replaceAll("<", "&lt;")
				.replaceAll(">", "&gt;")
				.replaceAll('"', "&quot;")
				.replaceAll("'", "&#039;");
		}

		function escapeAttribute(value) {
			return escapeHtml(value);
		}
	</script>
}

	